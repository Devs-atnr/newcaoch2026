<div class="coach-product__info">
  <form class="coach-product__form js-product-form" action="{{ routes.cart_add_url }}" method="post">
    <input type="hidden" name="id" class="js-variant-id" value="{% unless has_size %}{{ current.id }}{% endunless %}">
    {%- assign faq_open = false -%}
    {%- for block in blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          <h1 class="coach-product__title" {{ block.shopify_attributes }} style="font-size: {{ block.settings.font_size | default: 24 }}px; color: {{ block.settings.color | default: '#111111' }}; margin-bottom: {{ block.settings.spacing | default: 10 }}px;">{{ product.title | escape }}</h1>
        {%- when 'badge' -%}
          <div class="coach-product__meta" {{ block.shopify_attributes }}{% unless is_bestseller or rating != blank or product.metafields.judgeme.badge != blank %} hidden{% endunless %}>
            {%- if is_bestseller -%}
              <span class="coach-product__pill">{{ block.settings.bestseller_label | default: 'Bestseller' | escape }}<span class="coach-product__badge-star" aria-hidden="true">★</span></span>
            {%- endif -%}
            {%- if rating != blank or product.metafields.judgeme.badge != blank -%}
              <span class="coach-product__rating-compact js-rating-compact"><span class="coach-product__rating-star" aria-hidden="true">★</span><span class="js-rating-value">{{ rating }}</span></span>
            {%- endif -%}
            {%- if product.metafields.judgeme.badge != blank -%}
              <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">{{ product.metafields.judgeme.badge }}</div>
            {%- elsif rating != blank -%}
              <span class="coach-product__stars" aria-label="{{ rating }} out of 5">
                {%- assign filled = rating | round -%}
                {%- for i in (1..5) -%}
                  <span{% if i <= filled %} class="is-on"{% endif %}>★</span>
                {%- endfor -%}
              </span>
              {%- if rating_count != blank -%}<span class="coach-product__review-count">({{ rating_count }})</span>{%- endif -%}
            {%- endif -%}
          </div>
        {%- when 'price' -%}
          <p class="coach-product__price" {{ block.shopify_attributes }} style="font-size: {{ block.settings.font_size | default: 28 }}px; color: {{ block.settings.color | default: '#000000' }}; margin-top: {{ block.settings.space_top | default: 6 }}px; margin-bottom: {{ block.settings.space_bottom | default: 6 }}px;">
            <span class="js-price-now">{{ current.price | money }}</span>
            {%- if block.settings.show_compare -%}
              <s class="js-price-compare"{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money }}{% endif %}</s>
            {%- endif -%}
          </p>
          {%- assign size_note = blocks | where: 'type', 'size' | first -%}
          {%- if has_size and size_note.settings.note != blank -%}
            {%- liquid
              assign shoe_text = product.type | append: ' ' | append: product.title | downcase
              assign is_shoe = false
              if shoe_text contains 'shoe' or shoe_text contains 'sandal' or shoe_text contains 'heel' or shoe_text contains 'sneaker' or shoe_text contains 'trainer' or shoe_text contains 'boot' or shoe_text contains 'footwear' or shoe_text contains 'mule' or shoe_text contains 'loafer'
                assign is_shoe = true
              endif
              unless is_shoe
                for tag in product.tags
                  assign tag_down = tag | downcase
                  if tag_down contains 'shoe' or tag_down contains 'sandal' or tag_down contains 'heel' or tag_down contains 'sneaker' or tag_down contains 'trainer' or tag_down contains 'boot'
                    assign is_shoe = true
                  endif
                endfor
              endunless
              unless is_shoe
                for shoe_collection in product.collections
                  assign collection_title = shoe_collection.title | downcase
                  if collection_title contains 'shoe' or collection_title contains 'heel' or collection_title contains 'trainer' or collection_title contains 'sandal' or collection_title contains 'sneaker' or collection_title contains 'boot'
                    assign is_shoe = true
                  endif
                endfor
              endunless
            -%}
            {%- if is_shoe or size_note.settings.shoes_only == false -%}
              <p class="coach-product__size-note" style="color: {{ size_note.settings.note_color | default: '#1c9a4a' }}; font-size: {{ size_note.settings.note_size | default: 14 }}px; margin-bottom: {{ size_note.settings.note_space | default: 14 }}px;">{{ size_note.settings.note | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- when 'size' -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_name = option.name | downcase -%}
            {%- if option_name contains 'size' -%}
              <p class="coach-product__option-label" {{ block.shopify_attributes }} style="font-size: {{ block.settings.label_size | default: 14 }}px; color: {{ block.settings.label_color | default: '#000000' }}; margin-bottom: {{ block.settings.label_space | default: 8 }}px;">
                {{ option.name | downcase | capitalize | replace: ' size', ' Size' | escape }}: <span class="js-option-value" data-for-option="{{ forloop.index0 }}">Please select a size</span>
                <span class="coach-product__fit">{{ block.settings.fit | default: 'Runs true to size' | escape }}</span>
              </p>
              <div class="coach-product__choices coach-product__choices--size">
                {%- for value in option.values -%}
                  <button type="button" class="coach-product__choice" data-option-index="{{ forloop.parentloop.index0 }}" data-value="{{ value | escape }}">{{ value | escape }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- when 'color' -%}
          {%- if color_index >= 0 -%}
            {%- for option in product.options_with_values -%}
              {%- if forloop.index0 == color_index -%}
                <div class="coach-product__color" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_label -%}
                    <p class="coach-product__option-label" style="font-size: {{ block.settings.label_size | default: 14 }}px; color: {{ block.settings.label_color | default: '#000000' }}; margin-bottom: {{ block.settings.label_space | default: 8 }}px;">{{ option.name | escape }}: <span class="js-option-label">{{ option.selected_value | escape }}</span></p>
                  {%- endif -%}
                  <div class="coach-product__swatches" role="list">
                    {%- for value in option.values -%}
                      {%- assign swatch_variant = nil -%}
                      {%- assign color_available = false -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options[color_index] == value -%}
                          {%- if swatch_variant == nil -%}{%- assign swatch_variant = variant -%}{%- endif -%}
                          {%- if variant.available -%}{%- assign color_available = true -%}{%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <button type="button" class="coach-product__swatch{% if option.selected_value == value %} is-active{% endif %}{% unless color_available %} is-unavailable{% endunless %}" data-option-index="{{ color_index }}" data-value="{{ value | escape }}" aria-label="{{ value | escape }}"{% unless color_available %} disabled{% endunless %}>
                        {%- if swatch_variant.featured_media -%}
                          {{ swatch_variant.featured_media | image_url: width: 160 | image_tag: alt: value }}
                        {%- elsif swatch_variant.image -%}
                          {{ swatch_variant.image | image_url: width: 160 | image_tag: alt: value }}
                        {%- else -%}
                          <span>{{ value | escape }}</span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- when 'size_guide' -%}
          {%- if has_size and block.settings.enable -%}
            <div class="coach-product__size-guide-wrap" style="text-align: {{ block.settings.align | default: 'left' }};" {{ block.shopify_attributes }}>
              <button type="button" class="coach-product__size-guide js-size-guide" style="font-size: {{ block.settings.font_size | default: 14 }}px; color: {{ block.settings.link_color | default: '#111111' }}; margin-bottom: {{ block.settings.spacing | default: 16 }}px;">{{ block.settings.label | default: 'Size Guide' | escape }}</button>
              {%- assign size_fit = blocks | where: 'type', 'size' | first -%}
              <span class="coach-product__fit coach-product__fit--aside">{{ size_fit.settings.fit | default: 'Runs true to size' | escape }}</span>
            </div>
          {%- endif -%}
        {%- when 'stock' -%}
          <p class="coach-product__stock js-stock" {{ block.shopify_attributes }} hidden style="font-size: {{ block.settings.font_size | default: 11 }}px; color: {{ block.settings.color | default: '#111111' }}; margin-bottom: {{ block.settings.spacing | default: 10 }}px;"></p>
        {%- when 'quantity' -%}
          <div class="coach-product__qty js-qty" {{ block.shopify_attributes }}>
            <input type="hidden" class="js-qty-input" name="quantity" value="1">
            <button type="button" class="coach-product__qty-box js-qty-toggle" aria-expanded="false" aria-label="Quantity">
              <span class="js-qty-label">1</span>
              <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1L5 5L9 1" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
            </button>
            <ul class="coach-product__qty-list" hidden></ul>
          </div>
        {%- when 'add' -%}
          <button type="submit" class="coach-product__add js-add" {{ block.shopify_attributes }} style="--add-bg: {{ block.settings.background }}; --add-color: {{ block.settings.text }}; background: {{ block.settings.background }}; color: {{ block.settings.text }}; font-size: {{ block.settings.font_size | default: 14 }}px; height: {{ block.settings.height | default: 48 }}px; letter-spacing: {{ block.settings.letter_spacing | default: 1.25 }}px;">{{ block.settings.label | default: 'Add to bag' | escape }}</button>
        {%- when 'buy' -%}
          {%- if block.settings.enable -%}
            <button type="button" class="coach-product__now js-buy-now" {{ block.shopify_attributes }} style="--buy-bg: {{ block.settings.background }}; --buy-color: {{ block.settings.text }}; background: {{ block.settings.background }}; color: {{ block.settings.text }}; font-size: {{ block.settings.font_size | default: 14 }}px; height: {{ block.settings.height | default: 48 }}px; letter-spacing: {{ block.settings.letter_spacing | default: 1.25 }}px; margin-top: {{ block.settings.space_above | default: 12 }}px;">{{ block.settings.label | default: 'Buy now' | escape }}</button>
          {%- endif -%}
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="coach-product__acc-body rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- endif -%}
        {%- when 'shipping' -%}
          {%- assign shipping_content = product.metafields.custom.shipping_and_returns | default: product.metafields.custom.shipping -%}
          <button type="button" class="coach-product__ship-row js-ship-open" {{ block.shopify_attributes }}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 7h9l3 4v6h-2.2a2 2 0 0 1-3.6 0H10.8a2 2 0 0 1-3.6 0H6V7z" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="17" r="1.2" fill="currentColor"/><circle cx="16" cy="17" r="1.2" fill="currentColor"/></svg>
            <span>
              <strong>{{ block.settings.promo_title | default: 'Free shipping' | escape }}</strong>
              <small>{{ block.settings.promo_note | default: 'On orders $75 +' | escape }}</small>
            </span>
            <span class="coach-product__ship-more">{{ block.settings.learn_more | default: 'Learn more' | escape }}&nbsp;→</span>
          </button>
          <details class="coach-product__acc coach-product__acc--ship"{% if block.settings.open %} open{% endif %}>
            <summary>{{ block.settings.heading | escape }}</summary>
            <div class="coach-product__acc-body coach-product__ship-copy rte">
              <p>{{ block.settings.popup_lead | default: 'For full details, please visit our' | escape }} <a href="{{ block.settings.shipping_page | default: '/pages/shipping' }}">{{ block.settings.shipping_label | default: 'SHIPPING' | escape }}</a> and <a href="{{ block.settings.returns_page | default: '/pages/returns' }}">{{ block.settings.returns_label | default: 'RETURNS' | escape }}</a> pages.</p>
              {%- if shipping_content != blank -%}{{ shipping_content }}{%- endif -%}
            </div>
          </details>
          <div class="coach-ship-sheet js-ship-sheet" hidden>
            <button type="button" class="coach-ship-sheet__bg js-ship-close" aria-label="Close"></button>
            <div class="coach-ship-sheet__card" role="dialog" aria-modal="true" aria-label="{{ block.settings.heading | escape }}">
              <div class="coach-ship-sheet__head">
                <h2>{{ block.settings.heading | escape }}</h2>
                <button type="button" class="coach-ship-sheet__close js-ship-close" aria-label="Close">×</button>
              </div>
              <div class="coach-ship-sheet__body rte">
                <p>{{ block.settings.popup_lead | default: 'For full details, please visit our' | escape }} <a href="{{ block.settings.shipping_page | default: '/pages/shipping' }}">{{ block.settings.shipping_label | default: 'SHIPPING' | escape }}</a> and <a href="{{ block.settings.returns_page | default: '/pages/returns' }}">{{ block.settings.returns_label | default: 'RETURNS' | escape }}</a> pages.</p>
                {%- if shipping_content != blank -%}{{ shipping_content }}{%- endif -%}
              </div>
            </div>
          </div>
        {%- when 'details' -%}
          {%- liquid
            assign details_content = product.metafields.custom.product_details | default: product.metafields.custom.details
            assign style_number = product.metafields.custom.style_number | default: current.sku
            assign spec_html = details_content
            if spec_html == blank
              assign spec_html = product.description
            endif
            assign has_spec_table = false
            if spec_html contains '<table'
              assign has_spec_table = true
              assign spec_html = spec_html | split: '<h3>Editor' | first | split: '<h3>editor' | first
            endif
          -%}
          {%- if has_spec_table or measurements != blank or materials != blank or strap != blank or features != blank or style_number != blank -%}
            <details class="coach-product__acc" {{ block.shopify_attributes }}{% if block.settings.open != false %} open{% endif %}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="coach-product__acc-body">
                {%- if has_spec_table -%}
                  <div class="coach-product__spec-table rte">{{ spec_html }}</div>
                {%- else -%}
                <dl class="coach-product__specs">
                  {%- if style_number != blank -%}<div><dt>{{ block.settings.style_label | default: 'Style Number' | escape }}</dt><dd>{%- if style_number.type != blank -%}{{ style_number | metafield_tag }}{%- else -%}{{ style_number | escape }}{%- endif -%}</dd></div>{%- endif -%}
                  {%- if measurements != blank -%}
                    <div>
                      <dt>{{ block.settings.measurements_label | default: 'Measurements' | escape }}</dt>
                      <dd>
                        {%- if measurements.type == 'multi_line_text_field' -%}
                          {{ measurements.value | newline_to_br }}
                        {%- elsif measurements.type == 'list.single_line_text_field' -%}
                          {%- for item in measurements.value -%}{{ item | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}
                        {%- else -%}
                          {{ measurements | metafield_tag }}
                        {%- endif -%}
                      </dd>
                    </div>
                  {%- endif -%}
                  {%- if materials != blank -%}
                    <div>
                      <dt>{{ block.settings.materials_label | default: 'Materials' | escape }}</dt>
                      <dd>
                        {%- if materials.type == 'multi_line_text_field' -%}
                          {{ materials.value | newline_to_br }}
                        {%- elsif materials.type == 'list.single_line_text_field' -%}
                          {%- for item in materials.value -%}{{ item | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}
                        {%- else -%}
                          {{ materials | metafield_tag }}
                        {%- endif -%}
                      </dd>
                    </div>
                  {%- endif -%}
                  {%- if strap != blank -%}
                    <div>
                      <dt>{{ block.settings.strap_label | default: 'Strap' | escape }}</dt>
                      <dd>
                        {%- if strap.type == 'multi_line_text_field' -%}
                          {{ strap.value | newline_to_br }}
                        {%- elsif strap.type == 'list.single_line_text_field' -%}
                          {%- for item in strap.value -%}{{ item | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}
                        {%- else -%}
                          {{ strap | metafield_tag }}
                        {%- endif -%}
                      </dd>
                    </div>
                  {%- endif -%}
                  {%- if features != blank -%}
                    <div>
                      <dt>{{ block.settings.features_label | default: 'Features' | escape }}</dt>
                      <dd>
                        {%- if features.type == 'multi_line_text_field' -%}
                          {{ features.value | newline_to_br }}
                        {%- elsif features.type == 'list.single_line_text_field' -%}
                          {%- for item in features.value -%}{{ item | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}
                        {%- else -%}
                          {{ features | metafield_tag }}
                        {%- endif -%}
                      </dd>
                    </div>
                  {%- endif -%}
                </dl>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- when 'notes' -%}
          {%- assign note_content = product.metafields.custom.editors_note -%}
          {%- if note_content != blank -%}
            <details class="coach-product__acc coach-product__acc--notes" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="coach-product__acc-body rte">{{ note_content }}</div>
            </details>
          {%- endif -%}
        {%- when 'share' -%}
          {%- assign share_url = shop.url | append: product.url | url_encode -%}
          {%- assign share_title = product.title | url_encode -%}
          <div class="coach-product__share" {{ block.shopify_attributes }} style="--share-size: {{ block.settings.icon_size | default: 22 }}px; --share-gap: {{ block.settings.icon_gap | default: 18 }}px; --share-color: {{ block.settings.icon_color | default: '#111111' }};">
            <span>{{ block.settings.label | default: 'Share This Product' | escape }}</span>
            <div class="coach-product__share-icons">
              {%- if block.settings.show_facebook != false -%}
                <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor"/><path d="M13.5 18.4v-4.5h1.5l.23-1.75h-1.73v-1.12c0-.5.14-.85.86-.85h.92V8.4c-.16-.02-.7-.07-1.33-.07-1.32 0-2.22.8-2.22 2.28v1.24H9.9v1.75h1.63v4.5h1.97z" fill="#fff"/></svg></a>
              {%- endif -%}
              {%- if block.settings.show_x != false -%}
                <a href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.23 3.5h2.74l-6 6.85L18.2 20.5h-4.55l-3.56-4.66-4.08 4.66H3.26l6.4-7.32L3.05 3.5h4.67l3.22 4.26 3.29-4.26zm-.96 15.3h1.52L7.9 5.1H6.27l7 13.7z" fill="currentColor"/></svg></a>
              {%- endif -%}
              {%- if block.settings.show_line != false -%}
                <a href="https://wa.me/?text={{ share_title }}%20{{ share_url }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M16.2 13.7c-.1.4-.7.8-1 .9-.3.1-.6.2-1-.1-.2-.1-.6-.3-1-.5-1.5-1-2.5-2.6-2.6-2.8-.1-.2-.3-.5-.3-.8 0-.2.2-.5.3-.7.1-.1.2-.2.3-.2h.3c.1 0 .2 0 .3.2.1.4.4 1 .4 1.1 0 .1 0 .2-.1.3l-.2.3c0 .1-.1.2 0 .3.1.2.4.6.8.9.4.3.7.5.9.6.1 0 .2.1.3 0l.4-.4c.1-.1.2-.1.3 0 .1.1.5.7.6 1 .1.2 0 .4 0 .5zM12.1 6.7c-2.7 0-4.9 2.2-4.9 4.8 0 .9.2 1.7.7 2.4l-.7 2.5 2.6-.7c.7.4 1.5.6 2.3.6 2.7 0 4.9-2.2 4.9-4.8s-2.2-4.8-4.9-4.8z" fill="currentColor"/></svg></a>
              {%- endif -%}
              {%- if block.settings.show_pinterest != false -%}
                <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M9.7 17.6V7.2h2.7c1.9 0 3.1 1.1 3.1 2.7S14.3 12.6 12.4 12.6h-1.4v5h-1.3zm1.3-6.2h1.3c1.1 0 1.7-.6 1.7-1.5s-.6-1.5-1.7-1.5h-1.3v3z" fill="currentColor"/></svg></a>
              {%- endif -%}
              {%- if block.settings.show_email != false -%}
                <a href="mailto:?subject={{ share_title }}&body={{ share_url }}" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.8" y="5.2" width="18.4" height="13.6" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3.4 6.4l8.6 6.5 8.6-6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></a>
              {%- endif -%}
              {%- for icon in blocks -%}
                {%- if icon.type == 'share_icon' -%}
                  <a href="{{ icon.settings.link | default: product.url }}" {% if icon.settings.link != blank %}target="_blank" rel="noopener"{% endif %} aria-label="{{ icon.settings.label | default: 'Share' | escape }}" {{ icon.shopify_attributes }}>
                    {%- if icon.settings.image != blank -%}
                      {{ icon.settings.image | image_url: width: 80 | image_tag: alt: icon.settings.label }}
                    {%- else -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.4"/></svg>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
    <p class="coach-product__error js-error" role="alert"></p>
  </form>
</div>
</div>
{%- assign faq_open = false -%}

{%- for block in blocks -%}
  {%- case block.type -%}
    {%- when 'separator' -%}
      {%- liquid
        assign sep_align = 'center'
        if block.settings.alignment == 'left'
          assign sep_align = 'flex-start'
        elsif block.settings.alignment == 'right'
          assign sep_align = 'flex-end'
        endif
      -%}
      <div class="coach-product__separator" {{ block.shopify_attributes }} style="--sep-width: {{ block.settings.width | default: 100 }}%; --sep-align: {{ sep_align }}; --sep-color: {{ block.settings.color | default: '#e5e5e5' }}; --sep-size: {{ block.settings.thickness | default: 1 }}px; --sep-style: {{ block.settings.style | default: 'solid' }}; margin-top: {{ block.settings.space_above | default: 24 }}px; margin-bottom: {{ block.settings.space_below | default: 24 }}px;"><span></span></div>
    {%- when 'also' -%}
      {%- liquid
        assign qty_desktop = block.settings.quantity_desktop | default: block.settings.visible | default: 4
        assign qty_mobile = block.settings.quantity_mobile | default: 2
        assign layout_desktop = block.settings.layout_desktop | default: 'fixed-row'
        assign layout_mobile = block.settings.layout_mobile | default: 'equal-row'
        assign align_desktop = block.settings.section_align_desktop | default: 'center'
        assign align_mobile = block.settings.section_align_mobile | default: 'center'
      -%}
      <div
        class="coach-product__rail"
        data-rail="also"
        data-also-limit="{{ block.settings.limit | default: 8 }}"
        data-also-visible="{{ qty_desktop }}"
        data-also-visible-mobile="{{ qty_mobile }}"
        data-layout-desktop="{{ layout_desktop }}"
        data-layout-mobile="{{ layout_mobile }}"
        data-section-align-desktop="{{ align_desktop }}"
        data-section-align-mobile="{{ align_mobile }}"
        data-also-heart="{% if block.settings.show_wishlist == false %}false{% else %}true{% endif %}"
        data-heart-mobile="{% if block.settings.show_wishlist_mobile %}true{% else %}false{% endif %}"
        data-show-add="{% if block.settings.show_add == false %}false{% else %}true{% endif %}"
        data-add-label="{{ block.settings.add_label | default: 'Add To Bag' | escape }}"
        data-arrows="{% if block.settings.show_arrows == false %}false{% else %}true{% endif %}"
        data-arrows-mobile="{% if block.settings.show_arrows_mobile %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}
        style="--also-count-desktop: {{ qty_desktop }}; --also-count-mobile: {{ qty_mobile }}; --also-width-desktop: {{ block.settings.width_desktop | default: 210 }}px; --also-width-mobile: {{ block.settings.width_mobile | default: 160 }}px; --also-height-desktop: {{ block.settings.height_desktop | default: 270 }}px; --also-height-mobile: {{ block.settings.height_mobile | default: 220 }}px; --also-image-desktop: {{ block.settings.image_scale_desktop | default: 78 }}%; --also-image-mobile: {{ block.settings.image_scale_mobile | default: 86 }}%; --also-gap-desktop: {{ block.settings.gap_desktop | default: block.settings.gap | default: 18 }}px; --also-gap-mobile: {{ block.settings.gap_mobile | default: 16 }}px; --also-section-desktop: {{ block.settings.section_width_desktop | default: 100 }}%; --also-section-mobile: {{ block.settings.section_width_mobile | default: 100 }}%; --also-space-top-desktop: {{ block.settings.space_above_desktop | default: block.settings.space_above | default: 36 }}px; --also-space-bottom-desktop: {{ block.settings.space_below_desktop | default: block.settings.space_below | default: 0 }}px; --also-space-top-mobile: {{ block.settings.space_above_mobile | default: 24 }}px; --also-space-bottom-mobile: {{ block.settings.space_below_mobile | default: 0 }}px; --also-section-bg: {{ block.settings.section_background | default: 'transparent' }}; --also-image-bg: {{ block.settings.image_background | default: '#F0F0F0' }}; --also-heading-size: {{ block.settings.heading_size | default: 20 }}px; --also-heading-m: {{ block.settings.heading_size_mobile | default: 22 }}px; --also-heading-color: {{ block.settings.heading_color | default: '#111111' }}; --also-heading-align: {{ block.settings.heading_align | default: 'center' }}; --also-heading-align-m: {{ block.settings.heading_align_mobile | default: 'left' }}; --also-title-size: {{ block.settings.title_size | default: 14 }}px; --also-title-color: {{ block.settings.title_color | default: '#111111' }}; --also-title-weight-m: {{ block.settings.title_weight_mobile | default: 700 }}; --also-arrow: {{ block.settings.arrow_size | default: 18 }}px; --also-arrow-color: {{ block.settings.arrow_color | default: '#111111' }}; --also-arrow-offset: {{ block.settings.arrow_offset | default: 48 }}px; --rail-add-bg: {{ block.settings.add_background | default: '#ffffff' }}; --rail-add-color: {{ block.settings.add_color | default: '#111111' }}; --rail-add-border: {{ block.settings.add_border | default: '#e5e5e5' }}; --rail-add-radius: {{ block.settings.add_radius | default: 24 }}px; --rail-add-size: {{ block.settings.add_size | default: 13 }}px;"
      >
        <h2>{{ block.settings.heading | default: 'You May Also Like' | escape }}</h2>
        <div class="coach-product__rail-row">
          {%- if block.settings.show_arrows != false -%}
            <button type="button" class="coach-product__rail-prev js-also-prev" aria-label="Previous products"><svg viewBox="0 0 12 20" fill="none" aria-hidden="true"><path d="M10 2L2 10L10 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          {%- endif -%}
          <div class="coach-product__rail-track js-also"></div>
          {%- if block.settings.show_arrows != false -%}
            <button type="button" class="coach-product__rail-next js-also-next" aria-label="Next products"><svg viewBox="0 0 12 20" fill="none" aria-hidden="true"><path d="M2 2L10 10L2 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          {%- endif -%}
        </div>
      </div>
    {%- when 'recent' -%}
      {%- liquid
        assign recent_qty_d = block.settings.quantity_desktop | default: 4
        assign recent_qty_m = block.settings.quantity_mobile | default: 2
      -%}
      <div
        class="coach-product__rail coach-product__rail--recent"
        data-rail="recent"
        data-recent-limit="{{ block.settings.limit | default: 8 }}"
        data-recent-visible="{{ recent_qty_d }}"
        data-recent-visible-mobile="{{ recent_qty_m }}"
        data-recent-heart="{% if block.settings.show_wishlist == false %}false{% else %}true{% endif %}"
        data-heart-mobile="{% if block.settings.show_wishlist_mobile %}true{% else %}false{% endif %}"
        data-show-add="{% if block.settings.show_add == false %}false{% else %}true{% endif %}"
        data-add-label="{{ block.settings.add_label | default: 'Add To Bag' | escape }}"
        {{ block.shopify_attributes }}
        hidden
        style="--recent-count-d: {{ recent_qty_d }}; --recent-count-m: {{ recent_qty_m }}; --recent-width-d: {{ block.settings.width_desktop | default: 209 }}px; --recent-height-d: {{ block.settings.height_desktop | default: 271 }}px; --recent-height-m: {{ block.settings.height_mobile | default: 220 }}px; --recent-image-d: {{ block.settings.image_scale_desktop | default: 86 }}%; --recent-image-m: {{ block.settings.image_scale_mobile | default: 86 }}%; --recent-gap-d: {{ block.settings.gap_desktop | default: 18 }}px; --recent-gap-m: {{ block.settings.gap_mobile | default: 16 }}px; --recent-section-bg: {{ block.settings.section_background | default: 'transparent' }}; --recent-bg: {{ block.settings.image_background | default: '#F0F0F0' }}; --recent-heading-d: {{ block.settings.heading_size_desktop | default: 16 }}px; --recent-heading-m: {{ block.settings.heading_size_mobile | default: 22 }}px; --recent-heading-align-d: {{ block.settings.heading_align_desktop | default: 'center' }}; --recent-heading-align-m: {{ block.settings.heading_align_mobile | default: 'left' }}; --recent-heading-color: {{ block.settings.heading_color | default: '#111111' }}; --recent-title: {{ block.settings.title_size | default: 14 }}px; --recent-title-color: {{ block.settings.title_color | default: '#111111' }}; --recent-title-weight-d: {{ block.settings.title_weight_desktop | default: 400 }}; --recent-title-weight-m: {{ block.settings.title_weight_mobile | default: 700 }}; --recent-space-d: {{ block.settings.space_above_desktop | default: 48 }}px; --recent-space-m: {{ block.settings.space_above_mobile | default: 32 }}px; --rail-add-bg: {{ block.settings.add_background | default: '#ffffff' }}; --rail-add-color: {{ block.settings.add_color | default: '#111111' }}; --rail-add-border: {{ block.settings.add_border | default: '#e5e5e5' }}; --rail-add-radius: {{ block.settings.add_radius | default: 24 }}px; --rail-add-size: {{ block.settings.add_size | default: 13 }}px;"
      >
        <h2>{{ block.settings.heading | default: 'Recently Viewed' | escape }}</h2>
        <div class="coach-product__rail-row">
          <div class="coach-product__rail-track js-recent"></div>
        </div>
      </div>
    {%- when 'faq_group' -%}
      {%- liquid
        assign show_group = true
        if block.settings.collection != blank
          assign show_group = false
          for col in product.collections
            if col.id == block.settings.collection.id
              assign show_group = true
            endif
          endfor
        endif
        assign group_heading_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
        if block.settings.heading_font == 'garamond'
          assign group_heading_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
        endif
        assign group_q_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
        if block.settings.question_font == 'garamond'
          assign group_q_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
        endif
        assign group_a_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
        if block.settings.answer_font == 'garamond'
          assign group_a_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
        endif
        assign group_line_color = block.settings.line_color | default: '#e6e6e6'
        assign group_line = '1px solid ' | append: group_line_color
        if block.settings.show_lines == false
          assign group_line = '0'
        endif
      -%}
      {%- if show_group -%}
        {%- capture group_items -%}
          {%- for i in (1..8) -%}
            {%- liquid
              assign q_key = 'question_' | append: i
              assign a_key = 'answer_' | append: i
              assign group_question = block.settings[q_key]
              assign group_answer = block.settings[a_key]
            -%}
            {%- if group_question != blank -%}
              <details class="coach-product__faq-item">
                <summary>{{ group_question | escape }}</summary>
                <div class="rte">{{ group_answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if group_items != blank -%}
          <div class="coach-product__faq" {{ block.shopify_attributes }} style="--faq-heading-font: {{ group_heading_font }}; --faq-heading-size: {{ block.settings.heading_size | default: 22 }}px; --faq-heading-weight: {{ block.settings.heading_weight | default: 700 }}; --faq-heading-color: {{ block.settings.heading_color | default: '#111111' }}; --faq-q-font: {{ group_q_font }}; --faq-q-size: {{ block.settings.question_size | default: 16 }}px; --faq-q-weight: {{ block.settings.question_weight | default: 400 }}; --faq-q-color: {{ block.settings.question_color | default: '#111111' }}; --faq-a-font: {{ group_a_font }}; --faq-a-size: {{ block.settings.answer_size | default: 14 }}px; --faq-a-weight: {{ block.settings.answer_weight | default: 400 }}; --faq-a-color: {{ block.settings.answer_color | default: '#333333' }}; --faq-line: {{ group_line }};">
            <h2>{{ block.settings.heading | default: 'Frequently Asked Questions' | escape }}</h2>
            {{ group_items }}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- when 'faq' -%}
      {%- unless faq_open -%}
        {%- assign faq_open = true -%}
        {%- liquid
          assign faq_heading_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
          if block.settings.heading_font == 'garamond'
            assign faq_heading_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
          endif
          assign faq_q_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
          if block.settings.question_font == 'garamond'
            assign faq_q_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
          endif
          assign faq_a_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
          if block.settings.answer_font == 'garamond'
            assign faq_a_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
          endif
          assign faq_line = '1px solid ' | append: block.settings.line_color | default: '#e5e5e5'
          if block.settings.show_lines == false
            assign faq_line = '0'
          endif
        -%}
        {%- capture faq_items -%}
          {%- for question in blocks -%}
            {%- if question.type == 'faq' and question.settings.question != blank -%}
              {%- liquid
                assign show_q = true
                if question.settings.collection != blank
                  assign show_q = false
                  for col in product.collections
                    if col.id == question.settings.collection.id
                      assign show_q = true
                    endif
                  endfor
                endif
              -%}
              {%- if show_q -%}
                <details class="coach-product__faq-item" {{ question.shopify_attributes }}>
                  <summary>{{ question.settings.question | escape }}</summary>
                  <div class="rte">{{ question.settings.answer }}</div>
                </details>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if faq_items != blank -%}
          <div class="coach-product__faq" {{ block.shopify_attributes }} style="--faq-heading-font: {{ faq_heading_font }}; --faq-heading-size: {{ block.settings.heading_size | default: 22 }}px; --faq-heading-weight: {{ block.settings.heading_weight | default: 700 }}; --faq-heading-color: {{ block.settings.heading_color | default: '#111111' }}; --faq-q-font: {{ faq_q_font }}; --faq-q-size: {{ block.settings.question_size | default: 16 }}px; --faq-q-weight: {{ block.settings.question_weight | default: 400 }}; --faq-q-color: {{ block.settings.question_color | default: '#111111' }}; --faq-a-font: {{ faq_a_font }}; --faq-a-size: {{ block.settings.answer_size | default: 14 }}px; --faq-a-weight: {{ block.settings.answer_weight | default: 400 }}; --faq-a-color: {{ block.settings.answer_color | default: '#333333' }}; --faq-line: {{ faq_line }};">
            <h2>{{ block.settings.heading | default: 'Frequently Asked Questions' | escape }}</h2>
            {{ faq_items }}
          </div>
        {%- endif -%}
      {%- endunless -%}
    {%- when 'reviews' -%}
      {%- liquid
        assign review_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
        if block.settings.heading_font == 'garamond'
          assign review_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
        endif
      -%}
      <div
        class="coach-product__reviews"
        {{ block.shopify_attributes }}
        style="--rev-bg: {{ block.settings.background | default: '#ffffff' }}; --rev-border: {{ block.settings.border_color | default: '#e6e6e6' }}; --rev-pad: {{ block.settings.padding | default: 40 }}px; --rev-width: {{ block.settings.content_width | default: 720 }}px; --rev-align: {{ block.settings.align | default: 'center' }};"
      >
        {%- if block.settings.show_heading != false -%}
          <h2 class="coach-product__reviews-title" style="font-family: {{ review_font }}; font-size: {{ block.settings.heading_size | default: 18 }}px; font-weight: {{ block.settings.heading_weight | default: '700' }}; color: {{ block.settings.heading_color | default: '#111111' }}; text-align: {{ block.settings.align | default: 'center' }};">{{ block.settings.heading | default: 'Reviews' | escape }}</h2>
        {%- endif -%}
        <div
          id="judgeme_product_reviews"
          class="jdgm-widget jdgm-review-widget"
          data-id="{{ product.id }}"
          data-product-title="{{ product.title | escape }}"
          data-auto-install="false"
        >{{ product.metafields.judgeme.widget }}</div>
      </div>
  {%- endcase -%}
{%- endfor -%}
