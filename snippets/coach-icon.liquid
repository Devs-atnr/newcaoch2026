{%- doc -%}
  Renders a thin-line SVG icon used by the Coach header. Icons inherit `currentColor` and are sized with CSS.

  @param {string} icon - Icon name: search, heart, account, bag, close, menu, plus, minus, caret, help

  @example
  {% render 'coach-icon', icon: 'search' %}
{%- enddoc -%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg class="coach-icon coach-icon--search" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="9.5" cy="9.5" r="6.75"/><path d="M14.5 14.5L20 20" stroke-linecap="round"/></svg>
  {%- when 'heart' -%}
    <svg class="coach-icon coach-icon--heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20.4s-7.6-4.5-9.3-9.4C1.6 7.7 3.6 4.4 7 4.4c2.1 0 3.6 1.2 5 3.1 1.4-1.9 2.9-3.1 5-3.1 3.4 0 5.4 3.3 4.3 6.6-1.7 4.9-9.3 9.4-9.3 9.4z"/></svg>
  {%- when 'account' -%}
    <svg class="coach-icon coach-icon--account" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4.25"/><path d="M4.5 21.5v-1.2c0-3.6 3.3-6.3 7.5-6.3s7.5 2.7 7.5 6.3v1.2" stroke-linecap="round"/></svg>
  {%- when 'bag' -%}
    <svg class="coach-icon coach-icon--bag" viewBox="0 0 20 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M6.5 8V6a3.5 3.5 0 0 1 7 0v2"/><rect x="2.65" y="8" width="14.7" height="14.35"/></svg>
  {%- when 'close' -%}
    <svg class="coach-icon coach-icon--close" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 4l12 12M16 4L4 16"/></svg>
  {%- when 'menu' -%}
    <svg class="coach-icon coach-icon--menu" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 6h16M3 11h16M3 16h16"/></svg>
  {%- when 'plus' -%}
    <svg class="coach-icon coach-icon--plus" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M10 3v14M3 10h14"/></svg>
  {%- when 'minus' -%}
    <svg class="coach-icon coach-icon--minus" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 10h14"/></svg>
  {%- when 'caret' -%}
    <svg class="coach-icon coach-icon--caret" viewBox="0 0 10 6" fill="currentColor" aria-hidden="true" focusable="false"><path d="M0 0h10L5 6z"/></svg>
  {%- when 'help' -%}
    <svg class="coach-icon coach-icon--help" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5.5h16v11H10l-4.5 3.5v-3.5H4z"/></svg>
{%- endcase -%}
