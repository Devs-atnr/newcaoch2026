{% comment %}
  Coach Luxury Product Card (Matching Exact Reference Images)
  - Speech-bubble badges with downward pointer (Sold Out, New Arrival, Coming Soon)
  - Sleek minimal chevron arrows (< and >)
  - "Add To Bag" bottom hover bar (pure white for available, light grey disabled for sold out)
  - Centered title, swatches, and bold price
  - Color swatches with double-ring active indicator & white slash for sold-out
{% endcomment %}

{%- liquid
  assign image_ratio = image_ratio | default: 'portrait'
  assign enable_slider = enable_slider | default: true
  assign show_quick_add = show_quick_add | default: true
  assign show_swatches = show_swatches | default: true
  assign show_view_similar = show_view_similar | default: true
  assign new_tags = new_badge_tag | default: 'new, New Arrival, New, new-arrival' | split: ','
  assign coming_soon_tags = coming_soon_badge_tag | default: 'coming soon, Coming Soon, coming-soon' | split: ','
  assign almost_gone_tags = almost_gone_badge_tag | default: 'almost gone, Almost Gone, almost-gone, low stock, Low Stock' | split: ','

  assign is_new = false
  for tag in new_tags
    assign clean_tag = tag | strip | downcase
    for prod_tag in card_product.tags
      assign p_tag = prod_tag | strip | downcase
      if p_tag == clean_tag
        assign is_new = true
        break
      endif
    endfor
    if is_new
      break
    endif
  endfor

  unless is_new
    assign published_stamp = card_product.published_at | default: card_product.created_at | date: '%s' | plus: 0
    assign now_stamp = 'now' | date: '%s' | plus: 0
    assign age_seconds = now_stamp | minus: published_stamp
    if published_stamp > 0 and age_seconds >= 0 and age_seconds <= 2592000
      assign is_new = true
    endif
  endunless

  assign is_almost_gone = false
  for tag in almost_gone_tags
    assign clean_tag = tag | strip | downcase
    for prod_tag in card_product.tags
      assign p_tag = prod_tag | strip | downcase
      if p_tag == clean_tag
        assign is_almost_gone = true
        break
      endif
    endfor
    if is_almost_gone
      break
    endif
  endfor

  assign is_coming_soon = false
  for tag in coming_soon_tags
    assign clean_tag = tag | strip | downcase
    for prod_tag in card_product.tags
      assign p_tag = prod_tag | strip | downcase
      if p_tag == clean_tag
        assign is_coming_soon = true
        break
      endif
    endfor
    if is_coming_soon
      break
    endif
  endfor

  assign current_variant = card_product.selected_or_first_available_variant

  # Find color option index
  assign color_option_index = -1
  for option in card_product.options_with_values
    assign opt_name = option.name | downcase
    if opt_name == 'color' or opt_name == 'colour' or opt_name == 'couleur' or opt_name == 'farbe'
      assign color_option_index = forloop.index0
      break
    endif
  endfor
-%}

<div
  class="coach-card{% unless card_product.available %} coach-card--sold-out{% endunless %}"
  data-product-id="{{ card_product.id }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-is-new="{% if is_new %}true{% else %}false{% endif %}"
>
  <div class="coach-card__media-wrap coach-card__media-wrap--{{ image_ratio }}">
    {%- comment -%} Badges (Images 3 & 4 - Clean Rounded Pill Tag) {%- endcomment -%}
    <div class="coach-card__badges">
      {%- unless card_product.available -%}
        <span class="coach-badge coach-badge--sold-out">Sold Out</span>
      {%- elsif is_almost_gone -%}
        <span class="coach-badge coach-badge--almost-gone">Almost Gone</span>
      {%- elsif is_new -%}
        <span class="coach-badge coach-badge--new">New Arrival</span>
      {%- elsif is_coming_soon -%}
        <span class="coach-badge coach-badge--coming-soon">Coming Soon</span>
      {%- elsif card_product.compare_at_price > card_product.price -%}
        <span class="coach-badge coach-badge--sale">Sale</span>
      {%- endunless -%}
    </div>



    {%- comment -%} Product Image Slider {%- endcomment -%}
    <a href="{{ card_product.url }}" class="coach-card__media-link" tabindex="-1">
      <div class="coach-card__images-container">
        {%- if card_product.media.size > 0 -%}
          {%- for media in card_product.media -%}
            {%- if media.media_type == 'image' -%}
              <img
                src="{{ media | image_url: width: 600 }}"
                srcset="{{ media | image_url: width: 360 }} 360w, {{ media | image_url: width: 540 }} 540w, {{ media | image_url: width: 720 }} 720w"
                sizes="(min-width: 990px) calc((100vw - 100px) / 4), (min-width: 750px) 33vw, 50vw"
                alt="{{ media.alt | default: card_product.title | escape }}"
                loading="lazy"
                width="{{ media.width }}"
                height="{{ media.height }}"
                class="coach-card__img{% if forloop.first %} coach-card__img--active{% endif %}"
                data-image-index="{{ forloop.index0 }}"
              >
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'coach-card__placeholder' }}
        {%- endif -%}
      </div>
    </a>

    {%- comment -%} Minimalist Chevron Arrows (< and >) {%- endcomment -%}
    {%- if enable_slider and card_product.media.size > 1 -%}
      <button
        type="button"
        class="coach-card__arrow coach-card__arrow--prev"
        aria-label="Previous image"
      >
        <svg width="10" height="16" viewBox="0 0 10 16" fill="none">
          <path d="M8 2L2.5 8L8 14" stroke="#111111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        class="coach-card__arrow coach-card__arrow--next"
        aria-label="Next image"
      >
        <svg width="10" height="16" viewBox="0 0 10 16" fill="none">
          <path d="M2 2L7.5 8L2 14" stroke="#111111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}

    {%- if show_quick_add -%}
      <div class="coach-card__quick-add-wrap">
        <button
          type="button"
          class="coach-card__quick-add-btn {% if card_product.available %}coach-card__quick-add-btn--available{% else %}coach-card__quick-add-btn--sold-out{% endif %}"
          data-variant-id="{{ current_variant.id }}"
          {% unless card_product.available %}disabled{% endunless %}
          aria-label="Add to Bag - {{ card_product.title | escape }}"
        >
          <span class="coach-card__quick-add-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.792 16.22h-3.184v-3.168c0-.302-.228-.552-.514-.552-.287 0-.515.25-.515.552v3.169h-3.184a.542.542 0 0 0-.551.529c0 .294.25.53.551.53h3.184v3.168c0 .302.228.552.515.552.287 0 .514-.25.514-.552V17.28h3.184a.542.542 0 0 0 .552-.529c0-.294-.25-.53-.552-.53Z"></path>
              <path d="M9.992 17.856H6.371a.307.307 0 0 1-.216-.1c-.067-.065-.108-.14-.108-.214V8.597c0-.075.033-.15.108-.216a.307.307 0 0 1 .216-.1h1.536v1.906c0 .14.05.273.15.364.19.2.54.2.74 0 .099-.1.149-.223.149-.372V8.274h3.812v1.905c0 .14.05.273.15.364.191.199.54.199.74 0 .099-.1.149-.224.149-.373V8.265h1.537c.074 0 .149.034.216.1.066.066.1.14.1.215v2.64h1.037V8.58c0-.38-.132-.704-.398-.96a1.312 1.312 0 0 0-.964-.39H13.79v-.29c0-.82-.291-1.515-.856-2.087C12.368 4.29 11.662 4 10.84 4c-.823 0-1.52.29-2.094.853-.565.563-.855 1.267-.855 2.087v.29H6.354c-.382 0-.706.133-.964.39-.265.264-.39.587-.39.96v8.937c0 .38.133.704.39.96.258.265.59.398.964.398h3.63V17.84l.008.016Zm-1.055-10.9c0-.538.183-.985.549-1.35.373-.372.814-.546 1.354-.546.54 0 .988.182 1.354.547.373.372.548.811.548 1.35v.29H8.929v-.29h.008Z"></path>
            </svg>
          </span>
          <span class="coach-card__quick-add-text">Add To Bag</span>
          <span class="coach-card__quick-add-spinner" style="display:none;"></span>
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Product Information (Centered - Images 1, 2, 4, 5) {%- endcomment -%}
  <div class="coach-card__info">
    <h3 class="coach-card__title">
      <a href="{{ card_product.url }}" class="coach-card__title-link">
        {{ card_product.title | escape }}
      </a>
    </h3>

    {%- comment -%} Variant Color Swatches Slider (Centered - Images 1 & 3) {%- endcomment -%}
    {%- if show_swatches and color_option_index >= 0 -%}
      <div class="coach-card__swatches-wrapper js-coach-swatches-wrapper">
        <button
          type="button"
          class="coach-card__swatch-nav coach-card__swatch-nav--prev js-swatch-nav-prev"
          aria-label="Previous colors"
        >
          <svg width="6" height="10" viewBox="0 0 6 10" fill="none">
            <path d="M5 1L1.5 5L5 9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="coach-card__swatches js-swatches-track" role="radiogroup" aria-label="Color options">
          {%- assign rendered_colors = '' -%}
          {%- for variant in card_product.variants -%}
            {%- assign color_val = variant.options[color_option_index] -%}
            {%- assign color_slug = color_val | strip | downcase -%}
            {%- unless rendered_colors contains color_slug -%}
              {%- assign rendered_colors = rendered_colors | append: ',' | append: color_slug -%}
              {%- assign is_active_swatch = false -%}
              {%- if color_val == current_variant.options[color_option_index] -%}
                {%- assign is_active_swatch = true -%}
              {%- endif -%}

              {%- assign var_price = variant.price | money | escape -%}
              {%- assign var_compare_price = '' -%}
              {%- if variant.compare_at_price > variant.price -%}
                {%- assign var_compare_price = variant.compare_at_price | money | escape -%}
              {%- endif -%}
              {%- assign var_img_src = '' -%}
              {%- assign swatch_img = '' -%}
              {%- if variant.featured_image -%}
                {%- assign var_img_src = variant.featured_image | image_url: width: 800 -%}
                {%- assign swatch_img = variant.featured_image | image_url: width: 160 -%}
              {%- elsif variant.image -%}
                {%- assign var_img_src = variant.image | image_url: width: 800 -%}
                {%- assign swatch_img = variant.image | image_url: width: 160 -%}
              {%- elsif card_product.featured_image -%}
                {%- assign var_img_src = card_product.featured_image | image_url: width: 800 -%}
                {%- assign swatch_img = card_product.featured_image | image_url: width: 160 -%}
              {%- endif -%}

              {%- capture swatch_style -%}
                {%- if swatch_img != blank -%}
                  background-image:url('{{ swatch_img | replace: '&', '&amp;' }}');
                {%- endif -%}
              {%- endcapture -%}

              <button
                type="button"
                class="coach-card__swatch-dot{% if is_active_swatch %} coach-card__swatch-dot--active{% endif %}{% unless variant.available %} coach-card__swatch-dot--sold-out{% endunless %}"
                title="{{ color_val | escape }}"
                aria-label="{{ color_val | escape }}"
                data-variant-id="{{ variant.id }}"
                data-variant-available="{{ variant.available }}"
                data-variant-price="{{ var_price }}"
                {% if var_compare_price != blank %}
                  data-variant-compare-price="{{ var_compare_price }}"
                {% endif %}
                {% if var_img_src != blank %}
                  data-variant-image-src="{{ var_img_src | escape }}"
                {% endif %}
              >
                <span class="coach-card__swatch-fill" style="{{ swatch_style | strip }}"></span>
                {%- unless variant.available -%}
                  <span class="coach-card__swatch-slash"></span>
                {%- endunless -%}
              </button>
            {%- endunless -%}
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="coach-card__swatch-nav coach-card__swatch-nav--next js-swatch-nav-next"
          aria-label="Next colors"
        >
          <svg width="6" height="10" viewBox="0 0 6 10" fill="none">
            <path d="M1 1.5L4.5 5L1 8.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- else -%}
      <div class="coach-card__swatches-wrapper coach-card__swatches-wrapper--empty" aria-hidden="true"></div>
    {%- endif -%}

    {%- comment -%} Price (Centered) {%- endcomment -%}
    <div class="coach-card__price">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="coach-card__price-sale">{{ current_variant.price | money }}</span>
        <span class="coach-card__price-compare">{{ current_variant.compare_at_price | money }}</span>
      {%- else -%}
        <span class="coach-card__price-regular">{{ current_variant.price | money }}</span>
      {%- endif -%}
    </div>

    <div class="coach-card__mobile-actions">
      {%- if card_product.available -%}
        <button
          type="button"
          class="coach-card__mobile-btn coach-card__quick-add-btn coach-card__quick-add-btn--available"
          data-variant-id="{{ current_variant.id }}"
        >
          <span class="coach-card__quick-add-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.792 16.22h-3.184v-3.168c0-.302-.228-.552-.514-.552-.287 0-.515.25-.515.552v3.169h-3.184a.542.542 0 0 0-.551.529c0 .294.25.53.551.53h3.184v3.168c0 .302.228.552.515.552.287 0 .514-.25.514-.552V17.28h3.184a.542.542 0 0 0 .552-.529c0-.294-.25-.53-.552-.53Z"></path>
              <path d="M9.992 17.856H6.371a.307.307 0 0 1-.216-.1c-.067-.065-.108-.14-.108-.214V8.597c0-.075.033-.15.108-.216a.307.307 0 0 1 .216-.1h1.536v1.906c0 .14.05.273.15.364.19.2.54.2.74 0 .099-.1.149-.223.149-.372V8.274h3.812v1.905c0 .14.05.273.15.364.191.199.54.199.74 0 .099-.1.149-.224.149-.373V8.265h1.537c.074 0 .149.034.216.1.066.066.1.14.1.215v2.64h1.037V8.58c0-.38-.132-.704-.398-.96a1.312 1.312 0 0 0-.964-.39H13.79v-.29c0-.82-.291-1.515-.856-2.087C12.368 4.29 11.662 4 10.84 4c-.823 0-1.52.29-2.094.853-.565.563-.855 1.267-.855 2.087v.29H6.354c-.382 0-.706.133-.964.39-.265.264-.39.587-.39.96v8.937c0 .38.133.704.39.96.258.265.59.398.964.398h3.63V17.84l.008.016Zm-1.055-10.9c0-.538.183-.985.549-1.35.373-.372.814-.546 1.354-.546.54 0 .988.182 1.354.547.373.372.548.811.548 1.35v.29H8.929v-.29h.008Z"></path>
            </svg>
          </span>
          <span class="coach-card__quick-add-text">Add To Bag</span>
        </button>
      {%- else -%}
        <a class="coach-card__mobile-btn coach-card__mobile-btn--notify" href="{{ card_product.url }}">Notify Me</a>
      {%- endif -%}
    </div>
  </div>
</div>
