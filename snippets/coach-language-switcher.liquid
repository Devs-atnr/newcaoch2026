{%- doc -%}
  Renders the language switcher with a country flag (Saudi Arabia by default) in place of the country selector.
  It uses Shopify's native localization form, so it lists every language published under
  Settings → Languages — including languages added and translated with Langify.

  @param {string} form_id - Unique id for the localization form
  @param {string} [variant] - `dropdown` (desktop header, opens down) or `footer` (mobile menu footer, opens up). Defaults to `dropdown`.
  @param {string} [flag_code] - Two-letter country code whose flag is shown. Defaults to `SA`.
  @param {image} [flag_image] - Optional uploaded flag image that replaces the built-in flag

  @example
  {% render 'coach-language-switcher', form_id: 'CoachLangDesktop', variant: 'dropdown', flag_code: 'SA' %}
{%- enddoc -%}
{%- liquid
  assign variant = variant | default: 'dropdown'
  assign flag_code = flag_code | default: 'SA' | strip | upcase
  assign flag_country = localization.available_countries | where: 'iso_code', flag_code | first
  assign current_language = localization.language
  assign list_id = form_id | append: '-list'

  if variant == 'footer'
    assign current_label = current_language.endonym_name | capitalize
  else
    assign current_label = current_language.iso_code | slice: 0, 2 | upcase
  endif
-%}

{%- capture flag -%}
  {%- if flag_image != blank -%}
    {{ flag_image | image_url: width: 60 | image_tag: class: 'coach-lang__flag', width: 20, height: 15, alt: '', loading: 'eager' }}
  {%- elsif flag_country -%}
    {{ flag_country | image_url: width: 60 | image_tag: class: 'coach-lang__flag', width: 20, height: 15, alt: '', loading: 'eager' }}
  {%- else -%}
    {%- assign flag_handle = flag_code | downcase -%}
    <img
      class="coach-lang__flag"
      src="https://cdn.shopify.com/static/images/flags/{{ flag_handle }}.svg?width=60"
      width="20"
      height="15"
      alt=""
      loading="eager"
    >
  {%- endif -%}
{%- endcapture -%}

{%- if localization.available_languages.size > 1 -%}
  <div class="coach-lang coach-lang--{{ variant }}" data-lang-switcher>
    {%- form 'localization', id: form_id, class: 'coach-lang__form' -%}
      <button
        type="button"
        class="coach-lang__toggle"
        aria-expanded="false"
        aria-controls="{{ list_id }}"
        data-lang-toggle
      >
        {{ flag }}
        <span class="coach-lang__label">
          <span class="coach-lang__code">{{ current_label }}</span>
          {%- render 'coach-icon', icon: 'caret' -%}
        </span>
        <span class="visually-hidden">{{ 'sections.coach_header.language' | t }}: {{ current_language.endonym_name }}</span>
      </button>
      <ul id="{{ list_id }}" class="coach-lang__list" role="list" hidden data-lang-list>
        {%- for language in localization.available_languages -%}
          <li>
            <button
              type="submit"
              name="locale_code"
              value="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
              class="coach-lang__option"
              {% if language.iso_code == current_language.iso_code %}
                aria-current="true"
              {% endif %}
            >
              {{- language.endonym_name | capitalize -}}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endform -%}
  </div>
{%- else -%}
  <span class="coach-lang coach-lang--static coach-lang--{{ variant }}">
    {{ flag }}
    <span class="coach-lang__code">{{ current_label }}</span>
  </span>
{%- endif -%}
