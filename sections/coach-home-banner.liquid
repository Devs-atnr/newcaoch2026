{{ 'coach-home-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.heading_font == 'garamond'
    assign heading_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign text_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.text_font == 'garamond'
    assign text_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign button_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.button_font == 'garamond'
    assign button_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign banner_alt = section.settings.image_alt | default: section.settings.heading
  assign heading_weight = section.settings.heading_weight | default: 700
-%}

{%- liquid
  assign desk_src = ''
  assign mob_src = ''
  if section.settings.desktop_image != blank
    assign desk_src = section.settings.desktop_image | image_url: width: 2400
  elsif section.settings.desktop_image_url != blank
    assign desk_src = section.settings.desktop_image_url
  endif
  if section.settings.mobile_image != blank
    assign mob_src = section.settings.mobile_image | image_url: width: 1400
  elsif section.settings.mobile_image_url != blank
    assign mob_src = section.settings.mobile_image_url
  endif
  if mob_src == blank
    assign mob_src = desk_src
  endif
  if desk_src == blank
    assign desk_src = mob_src
  endif
-%}

<section
  class="coach-home-banner{% if section.settings.full_height %} is-screen{% endif %}"
  style="--hb-bg: {{ section.settings.background | default: '#ead9c8' }}; --hb-h: {{ section.settings.desktop_height | default: 560 }}px; --hb-h-m: {{ section.settings.mobile_height | default: 620 }}px; --hb-pt: {{ section.settings.padding_top | default: 0 }}px; --hb-pr: {{ section.settings.padding_right | default: 0 }}px; --hb-pb: {{ section.settings.padding_bottom | default: 0 }}px; --hb-pl: {{ section.settings.padding_left | default: 0 }}px; --hb-pt-m: {{ section.settings.padding_top_mobile | default: 0 }}px; --hb-pr-m: {{ section.settings.padding_right_mobile | default: 0 }}px; --hb-pb-m: {{ section.settings.padding_bottom_mobile | default: 0 }}px; --hb-pl-m: {{ section.settings.padding_left_mobile | default: 0 }}px; --hb-cl: {{ section.settings.content_left | default: 64 }}px; --hb-cr: {{ section.settings.content_right | default: 48 }}px; --hb-ct: {{ section.settings.content_top | default: 40 }}px; --hb-cb: {{ section.settings.content_bottom | default: 40 }}px; --hb-cl-m: {{ section.settings.content_left_mobile | default: 16 }}px; --hb-cr-m: {{ section.settings.content_right_mobile | default: 16 }}px; --hb-ct-m: {{ section.settings.content_top_mobile | default: 24 }}px; --hb-cb-m: {{ section.settings.content_bottom_mobile | default: 32 }}px; --hb-text-w: {{ section.settings.text_width | default: 320 }}px; --hb-heading: {{ heading_font }}; --hb-heading-size: {{ section.settings.heading_size | default: 26 }}px; --hb-heading-size-m: {{ section.settings.heading_size_mobile | default: 22 }}px; --hb-heading-color: {{ section.settings.heading_color | default: '#111111' }}; --hb-text: {{ text_font }}; --hb-text-size: {{ section.settings.text_size | default: 14 }}px; --hb-text-size-m: {{ section.settings.text_size_mobile | default: 14 }}px; --hb-text-color: {{ section.settings.text_color | default: '#111111' }};     --hb-btn-size: {{ section.settings.button_size | default: 14 }}px; --hb-gap: {{ section.settings.button_gap | default: 18 }}px; --hb-heading-weight: {{ heading_weight }}; --hb-heading-space: {{ section.settings.heading_spacing | default: 0 }}px; --hb-text-weight: {{ section.settings.text_weight | default: '400' }}; --hb-text-space: {{ section.settings.text_spacing | default: 0 }}px; --hb-btn-font: {{ button_font }}; --hb-btn-size-m: {{ section.settings.button_size_mobile | default: 14 }}px; --hb-btn-weight: {{ section.settings.button_weight | default: '400' }}; --hb-btn-space: {{ section.settings.button_spacing | default: 0 }}px; --hb-pos: {{ section.settings.image_position | default: 'center right' }}; --hb-offset: {{ section.settings.screen_offset | default: 180 }}px;"
  {% if section.settings.full_height %}data-full-height{% endif %}
>
  {%- if section.blocks.size > 0 -%}
    <div class="coach-home-banner__viewport" id="HomeBanner-{{ section.id }}" data-home-banner>
      <div class="coach-home-banner__track" data-home-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign slide_heading = block.settings.heading
            assign slide_text = block.settings.text
            assign slide_alt = slide_heading | default: banner_alt
            assign slide_b1 = block.settings.button_1_text
            assign slide_b2 = block.settings.button_2_text
            assign slide_desk = ''
            assign slide_mob = ''
            if block.settings.desktop_image != blank
              assign slide_desk = block.settings.desktop_image | image_url: width: 2400
            elsif block.settings.desktop_image_url != blank
              assign slide_desk = block.settings.desktop_image_url
            endif
            if block.settings.mobile_image != blank
              assign slide_mob = block.settings.mobile_image | image_url: width: 1400
            elsif block.settings.mobile_image_url != blank
              assign slide_mob = block.settings.mobile_image_url
            endif
            if slide_mob == blank
              assign slide_mob = slide_desk
            endif
            if slide_desk == blank
              assign slide_desk = slide_mob
            endif
          -%}
          <div class="coach-home-banner__frame" data-home-slide {{ block.shopify_attributes }}>
            {%- if slide_desk != blank -%}
              <img class="coach-home-banner__img coach-home-banner__img--desk" src="{{ slide_desk | escape }}" alt="{{ slide_alt | escape }}" width="1600" height="900"{% if forloop.first %} loading="eager"{% else %} loading="lazy"{% endif %}>
            {%- endif -%}
            {%- if slide_mob != blank -%}
              <img class="coach-home-banner__img coach-home-banner__img--mob" src="{{ slide_mob | escape }}" alt="{{ slide_alt | escape }}" width="900" height="1200"{% if forloop.first %} loading="eager"{% else %} loading="lazy"{% endif %}>
            {%- endif -%}
            <div class="coach-home-banner__copy is-desk-{{ section.settings.content_horizontal | default: 'left' }} is-desk-{{ section.settings.content_vertical | default: 'middle' }} is-mob-{{ section.settings.content_horizontal_mobile | default: 'center' }} is-mob-{{ section.settings.content_vertical_mobile | default: 'bottom' }}">
              {%- if slide_heading != blank -%}<h2>{{ slide_heading | escape }}</h2>{%- endif -%}
              {%- if slide_text != blank -%}<p>{{ slide_text | escape | newline_to_br }}</p>{%- endif -%}
              {%- if slide_b1 != blank or slide_b2 != blank or section.blocks.size > 1 -%}
                <div class="coach-home-banner__links">
                  {%- if section.blocks.size > 1 -%}
                    <button type="button" class="coach-home-banner__arrow" data-home-prev aria-label="Previous slide">‹</button>
                  {%- endif -%}
                  {%- if slide_b1 != blank -%}
                    <a href="{{ block.settings.button_1_link | default: '#' }}" style="color: {{ section.settings.button_1_color | default: '#111111' }};">{{ slide_b1 | escape }}</a>
                  {%- endif -%}
                  {%- if slide_b2 != blank -%}
                    <a href="{{ block.settings.button_2_link | default: '#' }}" style="color: {{ section.settings.button_2_color | default: '#111111' }};">{{ slide_b2 | escape }}</a>
                  {%- endif -%}
                  {%- if section.blocks.size > 1 -%}
                    <button type="button" class="coach-home-banner__arrow" data-home-next aria-label="Next slide">›</button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
  <div class="coach-home-banner__frame">
    {%- if desk_src != blank or mob_src != blank -%}
      {%- if desk_src != blank -%}
        <img class="coach-home-banner__img coach-home-banner__img--desk" src="{{ desk_src | escape }}" alt="{{ banner_alt | escape }}" width="1600" height="900" loading="eager">
      {%- endif -%}
      {%- if mob_src != blank -%}
        <img class="coach-home-banner__img coach-home-banner__img--mob" src="{{ mob_src | escape }}" alt="{{ banner_alt | escape }}" width="900" height="1200" loading="eager">
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'coach-home-banner__img coach-home-banner__img--desk' }}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'coach-home-banner__img coach-home-banner__img--mob' }}
    {%- endif -%}

    <div class="coach-home-banner__copy is-desk-{{ section.settings.content_horizontal | default: 'left' }} is-desk-{{ section.settings.content_vertical | default: 'middle' }} is-mob-{{ section.settings.content_horizontal_mobile | default: 'center' }} is-mob-{{ section.settings.content_vertical_mobile | default: 'bottom' }}">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
        <div class="coach-home-banner__links">
          {%- if section.settings.button_1_text != blank -%}
            <a href="{{ section.settings.button_1_link | default: '#' }}" style="color: {{ section.settings.button_1_color | default: '#111111' }};">{{ section.settings.button_1_text | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_text != blank -%}
            <a href="{{ section.settings.button_2_link | default: '#' }}" style="color: {{ section.settings.button_2_color | default: '#111111' }};">{{ section.settings.button_2_text | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</section>

{%- if section.blocks.size > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('HomeBanner-{{ section.id }}');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';
      var track = root.querySelector('[data-home-track]');
      var slides = root.querySelectorAll('[data-home-slide]');
      if (!track || slides.length < 2) return;
      var index = 0;
      function go(next) {
        index = (next + slides.length) % slides.length;
        track.style.transform = 'translateX(-' + (index * 100) + '%)';
      }
      root.addEventListener('click', function (event) {
        if (event.target.closest('[data-home-prev]')) go(index - 1);
        if (event.target.closest('[data-home-next]')) go(index + 1);
      });
      var startX = 0;
      root.addEventListener('touchstart', function (event) { startX = event.changedTouches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', function (event) {
        var delta = event.changedTouches[0].clientX - startX;
        if (Math.abs(delta) > 40) go(index + (delta < 0 ? 1 : -1));
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Home banner",
  "tag": "section",
  "class": "coach-home-banner-section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "desktop_image_url", "label": "Desktop image URL", "info": "Used when no desktop image is uploaded." },
    { "type": "text", "id": "mobile_image_url", "label": "Mobile image URL", "info": "Used when no mobile image is uploaded." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "checkbox", "id": "full_height", "label": "Fill the screen", "default": false },
    { "type": "range", "id": "screen_offset", "min": 80, "max": 240, "step": 4, "unit": "px", "label": "Screen offset", "default": 180 },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "center right", "options": [
      { "value": "center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "center right", "label": "Right" }
    ] },
    { "type": "range", "id": "desktop_height", "min": 360, "max": 800, "step": 20, "unit": "px", "label": "Desktop height", "default": 560 },
    { "type": "range", "id": "mobile_height", "min": 420, "max": 800, "step": 20, "unit": "px", "label": "Mobile height", "default": 620 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ead9c8" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Holiday starts now." },
    { "type": "select", "id": "heading_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "heading_size", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "Desktop size", "default": 26 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 36, "step": 1, "unit": "px", "label": "Mobile size", "default": 22 },
    { "type": "select", "id": "heading_weight", "label": "Weight", "default": "700", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_spacing", "min": 0, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Find styles for everything the holidays have in store." },
    { "type": "select", "id": "text_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "text_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Desktop size", "default": 14 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Mobile size", "default": 14 },
    { "type": "select", "id": "text_weight", "label": "Weight", "default": "400", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "text_spacing", "min": 0, "max": 8, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "color", "id": "text_color", "label": "Color", "default": "#111111" },
    { "type": "range", "id": "text_width", "min": 180, "max": 520, "step": 10, "unit": "px", "label": "Text width", "default": 320 },
    { "type": "header", "content": "Button 1" },
    { "type": "text", "id": "button_1_text", "label": "Text", "default": "Shop Bags" },
    { "type": "url", "id": "button_1_link", "label": "Link" },
    { "type": "color", "id": "button_1_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Button 2" },
    { "type": "text", "id": "button_2_text", "label": "Text", "default": "Shop Tabby" },
    { "type": "url", "id": "button_2_link", "label": "Link" },
    { "type": "color", "id": "button_2_color", "label": "Color", "default": "#111111" },
    { "type": "select", "id": "button_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "button_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Desktop size", "default": 14 },
    { "type": "range", "id": "button_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Mobile size", "default": 14 },
    { "type": "select", "id": "button_weight", "label": "Weight", "default": "400", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "button_spacing", "min": 0, "max": 8, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "button_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Space between buttons", "default": 18 },
    { "type": "header", "content": "Desktop content position" },
    { "type": "select", "id": "content_horizontal", "label": "Horizontal", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "content_vertical", "label": "Vertical", "default": "middle", "options": [
      { "value": "top", "label": "Top" },
      { "value": "middle", "label": "Middle" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "range", "id": "content_left", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Left", "default": 64 },
    { "type": "range", "id": "content_right", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Right", "default": 48 },
    { "type": "range", "id": "content_top", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Top", "default": 40 },
    { "type": "range", "id": "content_bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Bottom", "default": 40 },
    { "type": "header", "content": "Mobile content position" },
    { "type": "select", "id": "content_horizontal_mobile", "label": "Horizontal", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "content_vertical_mobile", "label": "Vertical", "default": "bottom", "options": [
      { "value": "top", "label": "Top" },
      { "value": "middle", "label": "Middle" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "range", "id": "content_left_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Left", "default": 16 },
    { "type": "range", "id": "content_right_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Right", "default": 16 },
    { "type": "range", "id": "content_top_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top", "default": 24 },
    { "type": "range", "id": "content_bottom_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom", "default": 32 },
    { "type": "header", "content": "Desktop padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom", "default": 0 },
    { "type": "range", "id": "padding_left", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Left", "default": 0 },
    { "type": "range", "id": "padding_right", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Right", "default": 0 },
    { "type": "header", "content": "Mobile padding" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom", "default": 0 },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 48, "step": 4, "unit": "px", "label": "Left", "default": 0 },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 48, "step": 4, "unit": "px", "label": "Right", "default": 0 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "text", "id": "desktop_image_url", "label": "Desktop image URL", "info": "Used when no desktop image is uploaded." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "text", "id": "mobile_image_url", "label": "Mobile image URL", "info": "Used when no mobile image is uploaded." },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_1_text", "label": "Button text" },
        { "type": "url", "id": "button_1_link", "label": "Button link" },
        { "type": "text", "id": "button_2_text", "label": "Second button text" },
        { "type": "url", "id": "button_2_link", "label": "Second button link" }
      ]
    }
  ],
  "presets": [{ "name": "Home banner" }]
}
{% endschema %}
