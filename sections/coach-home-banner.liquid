{{ 'coach-home-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.heading_font == 'garamond'
    assign heading_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign text_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.text_font == 'garamond'
    assign text_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign banner_alt = section.settings.image_alt | default: section.settings.heading
  assign desk_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign mob_image = section.settings.mobile_image | default: section.settings.desktop_image
-%}

<section
  class="coach-home-banner"
  style="--hb-bg: {{ section.settings.background | default: '#ead9c8' }}; --hb-h: {{ section.settings.desktop_height | default: 560 }}px; --hb-h-m: {{ section.settings.mobile_height | default: 620 }}px; --hb-pt: {{ section.settings.padding_top | default: 0 }}px; --hb-pr: {{ section.settings.padding_right | default: 0 }}px; --hb-pb: {{ section.settings.padding_bottom | default: 0 }}px; --hb-pl: {{ section.settings.padding_left | default: 0 }}px; --hb-pt-m: {{ section.settings.padding_top_mobile | default: 0 }}px; --hb-pr-m: {{ section.settings.padding_right_mobile | default: 0 }}px; --hb-pb-m: {{ section.settings.padding_bottom_mobile | default: 0 }}px; --hb-pl-m: {{ section.settings.padding_left_mobile | default: 0 }}px; --hb-cl: {{ section.settings.content_left | default: 64 }}px; --hb-cr: {{ section.settings.content_right | default: 48 }}px; --hb-ct: {{ section.settings.content_top | default: 40 }}px; --hb-cb: {{ section.settings.content_bottom | default: 40 }}px; --hb-cl-m: {{ section.settings.content_left_mobile | default: 16 }}px; --hb-cr-m: {{ section.settings.content_right_mobile | default: 16 }}px; --hb-ct-m: {{ section.settings.content_top_mobile | default: 24 }}px; --hb-cb-m: {{ section.settings.content_bottom_mobile | default: 32 }}px; --hb-text-w: {{ section.settings.text_width | default: 320 }}px; --hb-heading: {{ heading_font }}; --hb-heading-size: {{ section.settings.heading_size | default: 26 }}px; --hb-heading-size-m: {{ section.settings.heading_size_mobile | default: 22 }}px; --hb-heading-color: {{ section.settings.heading_color | default: '#111111' }}; --hb-text: {{ text_font }}; --hb-text-size: {{ section.settings.text_size | default: 14 }}px; --hb-text-size-m: {{ section.settings.text_size_mobile | default: 14 }}px; --hb-text-color: {{ section.settings.text_color | default: '#111111' }}; --hb-btn-size: {{ section.settings.button_size | default: 14 }}px; --hb-gap: {{ section.settings.button_gap | default: 18 }}px;"
>
  <div class="coach-home-banner__frame">
    {%- if desk_image != blank or mob_image != blank -%}
      {%- if desk_image != blank -%}
        {{ desk_image | image_url: width: 2400 | image_tag: class: 'coach-home-banner__img coach-home-banner__img--desk', alt: banner_alt, loading: 'eager' }}
      {%- endif -%}
      {%- if mob_image != blank -%}
        {{ mob_image | image_url: width: 1200 | image_tag: class: 'coach-home-banner__img coach-home-banner__img--mob', alt: banner_alt, loading: 'eager' }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'coach-home-banner__img coach-home-banner__img--desk' }}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'coach-home-banner__img coach-home-banner__img--mob' }}
    {%- endif -%}

    <div class="coach-home-banner__copy is-desk-{{ section.settings.content_horizontal | default: 'left' }} is-desk-{{ section.settings.content_vertical | default: 'middle' }} is-mob-{{ section.settings.content_horizontal_mobile | default: 'center' }} is-mob-{{ section.settings.content_vertical_mobile | default: 'bottom' }}">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
        <div class="coach-home-banner__links">
          {%- if section.settings.button_1_text != blank -%}
            <a href="{{ section.settings.button_1_link | default: '#' }}" style="color: {{ section.settings.button_1_color | default: '#111111' }};">{{ section.settings.button_1_text | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_text != blank -%}
            <a href="{{ section.settings.button_2_link | default: '#' }}" style="color: {{ section.settings.button_2_color | default: '#111111' }};">{{ section.settings.button_2_text | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home banner",
  "tag": "section",
  "class": "coach-home-banner-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "range", "id": "desktop_height", "min": 360, "max": 800, "step": 20, "unit": "px", "label": "Desktop height", "default": 560 },
    { "type": "range", "id": "mobile_height", "min": 420, "max": 800, "step": 20, "unit": "px", "label": "Mobile height", "default": 620 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ead9c8" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Holiday starts now." },
    { "type": "select", "id": "heading_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "heading_size", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "Desktop size", "default": 26 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 36, "step": 1, "unit": "px", "label": "Mobile size", "default": 22 },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Find styles for everything the holidays have in store." },
    { "type": "select", "id": "text_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "text_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Desktop size", "default": 14 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Mobile size", "default": 14 },
    { "type": "color", "id": "text_color", "label": "Color", "default": "#111111" },
    { "type": "range", "id": "text_width", "min": 180, "max": 520, "step": 10, "unit": "px", "label": "Text width", "default": 320 },
    { "type": "header", "content": "Button 1" },
    { "type": "text", "id": "button_1_text", "label": "Text", "default": "Shop Bags" },
    { "type": "url", "id": "button_1_link", "label": "Link" },
    { "type": "color", "id": "button_1_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Button 2" },
    { "type": "text", "id": "button_2_text", "label": "Text", "default": "Shop Tabby" },
    { "type": "url", "id": "button_2_link", "label": "Link" },
    { "type": "color", "id": "button_2_color", "label": "Color", "default": "#111111" },
    { "type": "range", "id": "button_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Button size", "default": 14 },
    { "type": "range", "id": "button_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Space between buttons", "default": 18 },
    { "type": "header", "content": "Desktop content position" },
    { "type": "select", "id": "content_horizontal", "label": "Horizontal", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "content_vertical", "label": "Vertical", "default": "middle", "options": [
      { "value": "top", "label": "Top" },
      { "value": "middle", "label": "Middle" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "range", "id": "content_left", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Left", "default": 64 },
    { "type": "range", "id": "content_right", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Right", "default": 48 },
    { "type": "range", "id": "content_top", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Top", "default": 40 },
    { "type": "range", "id": "content_bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "label": "Bottom", "default": 40 },
    { "type": "header", "content": "Mobile content position" },
    { "type": "select", "id": "content_horizontal_mobile", "label": "Horizontal", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "content_vertical_mobile", "label": "Vertical", "default": "bottom", "options": [
      { "value": "top", "label": "Top" },
      { "value": "middle", "label": "Middle" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "range", "id": "content_left_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Left", "default": 16 },
    { "type": "range", "id": "content_right_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Right", "default": 16 },
    { "type": "range", "id": "content_top_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top", "default": 24 },
    { "type": "range", "id": "content_bottom_mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom", "default": 32 },
    { "type": "header", "content": "Desktop padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom", "default": 0 },
    { "type": "range", "id": "padding_left", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Left", "default": 0 },
    { "type": "range", "id": "padding_right", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Right", "default": 0 },
    { "type": "header", "content": "Mobile padding" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom", "default": 0 },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 48, "step": 4, "unit": "px", "label": "Left", "default": 0 },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 48, "step": 4, "unit": "px", "label": "Right", "default": 0 }
  ],
  "presets": [{ "name": "Home banner" }]
}
{% endschema %}
