{{ 'coach-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coach-product.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --m-arrow: {{ section.settings.mobile_arrow_size | default: 36 }}px;
    --m-arrow-bg: {{ section.settings.mobile_arrow_bg | default: '#ffffff' }};
    --m-arrow-color: {{ section.settings.mobile_arrow_color | default: '#222222' }};
    --m-title: {{ section.settings.mobile_title_size | default: 16 }}px;
    --m-price: {{ section.settings.mobile_price_size | default: 14 }}px;
    --m-rating: {{ section.settings.mobile_rating_size | default: 12 }}px;
    --m-swatch-w: {{ section.settings.mobile_swatch_w | default: 52 }}px;
    --m-swatch-h: {{ section.settings.mobile_swatch_h | default: 60 }}px;
    --m-swatch-border: {{ section.settings.mobile_swatch_border | default: '#111111' }};
    --m-btn-h: {{ section.settings.mobile_btn_h | default: 46 }}px;
    --m-btn-radius: {{ section.settings.mobile_btn_radius | default: 2 }}px;
    --m-qty-w: {{ section.settings.mobile_qty_w | default: 52 }}px;
  }
{%- endstyle -%}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign color_index = -1
  assign is_bestseller = false
  if section.settings.bestseller_products != blank
    for bestseller_product in section.settings.bestseller_products
      if bestseller_product.id == product.id
        assign is_bestseller = true
      endif
    endfor
  endif
  assign badge_block = section.blocks | where: 'type', 'badge' | first
  assign bestseller_label = badge_block.settings.bestseller_label | default: 'Bestseller'
  assign crumb_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.breadcrumb_font == 'garamond'
    assign crumb_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.reviews.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur'
      assign color_index = forloop.index0
    endif
  endfor
  assign style_number = product.metafields.custom.style_number | default: current.sku
  assign measurements = product.metafields.custom.measurements
  assign materials = product.metafields.custom.materials
  assign strap = product.metafields.custom.strap
  assign features = product.metafields.custom.features
  assign editors_note = product.metafields.custom.editors_note | default: product.description
  assign has_size = false
  assign size_index = -1
  for option in product.options_with_values
    assign size_name = option.name | downcase
    if size_name contains 'size'
      assign has_size = true
      assign size_index = forloop.index0
    endif
  endfor
  assign gallery_block = section.blocks | where: 'type', 'gallery' | first
  assign color_block = section.blocks | where: 'type', 'color' | first
  assign size_block = section.blocks | where: 'type', 'size' | first
  assign qty_block = section.blocks | where: 'type', 'quantity' | first
  assign guide_block = section.blocks | where: 'type', 'size_guide' | first
-%}

<div class="coach-product-shell" style="--pdp-bg: {{ section.settings.background | default: '#F0F0F0' }};">
<coach-product-page
  class="coach-product"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-qty-max="{{ qty_block.settings.qty_max | default: 10 }}"
  style="--pdp-page: {{ section.settings.page_width | default: 1320 }}px; --pdp-crumb-font: {{ crumb_font }}; --pdp-crumb-size: {{ section.settings.breadcrumb_size | default: 12 }}px; --pdp-crumb-color: {{ section.settings.breadcrumb_color | default: '#8a8a8a' }}; --pdp-arrow-size: {{ gallery_block.settings.arrow_size | default: 14 }}px; --pdp-arrow-color: {{ gallery_block.settings.arrow_color | default: '#222222' }}; --pdp-title-size: {{ section.settings.title_size | default: 24 }}px; --pdp-title-line: {{ section.settings.title_line | default: 30 }}px; --pdp-title-weight: {{ section.settings.title_weight | default: 400 }}; --pdp-title-spacing: {{ section.settings.title_spacing | default: '0.4px' | escape }}; --pdp-price-size: {{ section.settings.price_size | default: 28 }}px; --pdp-text: {{ section.settings.text_color | default: '#111111' }}; --pdp-bg: {{ section.settings.background | default: '#F0F0F0' }}; --pdp-gap: {{ section.settings.info_gap | default: 27 }}px; --pdp-image-h: {{ gallery_block.settings.image_height | default: 495 }}px; --pdp-image-h-mobile: {{ gallery_block.settings.mobile_image_height | default: 360 }}px; --pdp-image-fit: {{ gallery_block.settings.image_fit | default: 'contain' }}; --pdp-thumb-w: {{ gallery_block.settings.thumb_width | default: 86 }}px; --pdp-thumb-h: {{ gallery_block.settings.thumb_height | default: 108 }}px; --pdp-thumb-gap: {{ gallery_block.settings.thumb_gap | default: 8 }}px; --pdp-thumb-count: {{ gallery_block.settings.thumb_count | default: 3 }}; --pdp-thumb-border: {{ gallery_block.settings.thumb_border | default: '#111111' }}; --pdp-swatch-w: {{ color_block.settings.width | default: 72 }}px; --pdp-swatch-h: {{ color_block.settings.height | default: 86 }}px; --pdp-swatch-gap: {{ color_block.settings.gap | default: 8 }}px; --pdp-swatch-border: {{ color_block.settings.border_color | default: '#d5d5d5' }}; --pdp-swatch-active: {{ color_block.settings.active_color | default: '#000000' }}; --pdp-size-h: {{ size_block.settings.height | default: 48 }}px; --pdp-size-gap: {{ size_block.settings.gap | default: 8 }}px; --pdp-size-cols: {{ size_block.settings.columns | default: 3 }}; --pdp-size-bg: {{ size_block.settings.selected_bg | default: '#7a7a7a' }}; --pdp-size-text: {{ size_block.settings.selected_text | default: '#ffffff' }}; --pdp-size-font: {{ size_block.settings.font_size | default: 14 }}px; --pdp-guide-w: {{ guide_block.settings.width | default: 550 }}px; --pdp-guide-h: {{ guide_block.settings.height | default: 400 }}px; --pdp-guide-bg: {{ guide_block.settings.background | default: '#ffffff' }}; --pdp-guide-text: {{ guide_block.settings.text_color | default: '#111111' }}; --pdp-qty-w: {{ qty_block.settings.width | default: 74 }}px; --pdp-qty-h: {{ qty_block.settings.height | default: 48 }}px; --pdp-qty-bg: {{ qty_block.settings.background | default: '#ffffff' }}; --pdp-qty-border: {{ qty_block.settings.border_color | default: '#d5d5d5' }};"
>
  {%- if section.settings.show_breadcrumb -%}
    <nav class="coach-product__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Coach' | escape }}</a>
      {%- if collection -%}
        <span aria-hidden="true">/</span>
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      {%- elsif product.collections.first -%}
        <span aria-hidden="true">/</span>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>
  {%- endif -%}

  <div class="coach-product__layout">
    <div class="coach-product__gallery is-{{ gallery_block.settings.thumb_position | default: 'left' }}"{% if gallery_block.settings.show == false %} hidden{% endif %} {{ gallery_block.shopify_attributes }}>
      <div class="coach-product__thumbs">
        <button type="button" class="coach-product__thumb-nav js-thumb-prev" aria-label="Previous images">
          <svg class="coach-product__arrow-up" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 7L7 1L13 7" stroke="currentColor" stroke-width="1.2"/></svg>
          <svg class="coach-product__arrow-side" width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5H16M12.2 1.2L16.5 5L12.2 8.8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="coach-product__thumb-list js-thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button
                type="button"
                class="coach-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ media | image_url: width: 1400 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="{{ product.title | escape }} image {{ forloop.index }}"
              >
                {{ media | image_url: width: 160 | image_tag: alt: media.alt, loading: 'lazy' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button type="button" class="coach-product__thumb-nav js-thumb-next" aria-label="Next images">
          <svg class="coach-product__arrow-up" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.2"/></svg>
          <svg class="coach-product__arrow-side" width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5H16M12.2 1.2L16.5 5L12.2 8.8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="coach-product__stage">
        {%- if is_bestseller -%}
          <span class="coach-product__flag">{{ bestseller_label | escape }}<span class="coach-product__badge-star" aria-hidden="true">★</span></span>
        {%- endif -%}
        {%- if gallery_block.settings.bag_size_image != blank -%}
          <button type="button" class="coach-product__size-btn js-bag-size">{{ gallery_block.settings.bag_size_label | default: 'See bag size' | escape }}</button>
        {%- endif -%}
        <button type="button" class="coach-product__heart" aria-label="Wishlist" aria-pressed="false" data-wishlist>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20.4s-7.6-4.5-9.3-9.4C1.6 7.7 3.6 4.4 7 4.4c2.1 0 3.6 1.2 5 3.1 1.4-1.9 2.9-3.1 5-3.1 3.4 0 5.4 3.3 4.3 6.6-1.7 4.9-9.3 9.4-9.3 9.4z"/></svg>
        </button>
        {%- if color_index >= 0 -%}
          <span class="coach-product__color-label js-color-label">{{ current.options[color_index] }}</span>
        {%- endif -%}
        {%- assign main_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        {%- if main_media -%}
          <img
            class="coach-product__image js-main-image"
            src="{{ main_media | image_url: width: 1400 }}"
            alt="{{ main_media.alt | default: product.title | escape }}"
            width="1400"
            height="1400"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'coach-product__image' }}
        {%- endif -%}
      </div>
    </div>
    <div class="coach-product__zoom js-zoom" hidden>
      <button type="button" class="coach-product__zoom-close js-zoom-close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
      <div class="coach-product__zoom-rail">
        <button type="button" class="coach-product__zoom-nav js-zoom-prev" aria-label="Previous image">
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 7L7 1L13 7" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
        <div class="coach-product__zoom-list js-zoom-list"></div>
        <button type="button" class="coach-product__zoom-nav js-zoom-next" aria-label="Next image">
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
      </div>
      <div class="coach-product__zoom-stage">
        <img class="js-zoom-image" alt="">
      </div>
    </div>
    <p class="coach-product__stock coach-product__stock--under js-stock" hidden></p>

    {%- render 'coach-product-blocks',
      blocks: section.blocks,
      product: product,
      current: current,
      color_index: color_index,
      has_size: has_size,
      is_bestseller: is_bestseller,
      rating: rating_value,
      rating_count: rating_count,
      measurements: measurements,
      materials: materials,
      strap: strap,
      features: features,
      editors_note: editors_note
    -%}

  {%- if gallery_block.settings.bag_size_image != blank -%}
    <div class="coach-product__modal" hidden>
      <button type="button" class="coach-product__modal-bg js-bag-size-close" aria-label="Close"></button>
      <div class="coach-product__modal-card">
        <button type="button" class="js-bag-size-close" aria-label="Close">×</button>
        {{ gallery_block.settings.bag_size_image | image_url: width: 900 | image_tag: alt: gallery_block.settings.bag_size_label }}
      </div>
    </div>
  {%- endif -%}

  {%- if guide_block.settings.enable != false and has_size -%}
    <div class="coach-size-guide" hidden>
      <button type="button" class="coach-size-guide__bg js-guide-close" aria-label="Close size guide"></button>
      <div class="coach-size-guide__card" role="dialog" aria-modal="true" aria-labelledby="CoachSizeGuideTitle-{{ section.id }}">
        <button type="button" class="coach-size-guide__close js-guide-close" aria-label="Close">×</button>
        <h2 id="CoachSizeGuideTitle-{{ section.id }}" class="js-guide-title"></h2>
        <p class="coach-size-guide__hint">Scroll horizontally to see more sizes.</p>
        <div class="coach-size-guide__scroll"><table class="js-guide-table"></table></div>
        <div class="coach-size-guide__note js-guide-note"></div>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" class="js-coach-product-data">
    {
      "colorIndex": {{ color_index }},
      "sizeIndex": {{ size_index }},
      "productType": {{ product.type | json }},
      "tags": {{ product.tags | json }},
      "options": {{ product.options | json }},
      "sizeGuide": {% if product.metafields.custom.size_guide != blank %}{{ product.metafields.custom.size_guide.value | json }}{% elsif product.metafields.custom.size_chart != blank %}{{ product.metafields.custom.size_chart.value | json }}{% else %}null{% endif %},
      "media": [
        {%- assign media_first = true -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- unless media_first -%},{%- endunless -%}
            {%- assign media_first = false -%}
            {
              "src": {{ media | image_url: width: 1400 | json }},
              "thumb": {{ media | image_url: width: 200 | json }},
              "alt": {{ media.alt | default: product.title | json }}
            }
          {%- endif -%}
        {%- endfor -%}
      ],
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | money | json }},
            "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "sku": {{ variant.sku | json }},
            "inventory": {{ variant.inventory_quantity | default: 0 }},
            "tracked": {% if variant.inventory_management %}true{% else %}false{% endif %},
            "policy": {{ variant.inventory_policy | json }},
            "image": {% if variant.featured_media %}{{ variant.featured_media | image_url: width: 1400 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</coach-product-page>
</div>

{% schema %}
{
  "name": "Coach product",
  "settings": [
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_home", "label": "Home label", "default": "Coach" },
    { "type": "select", "id": "breadcrumb_font", "label": "Font", "default": "helvetica", "options": [{ "value": "helvetica", "label": "Helvetica" }, { "value": "garamond", "label": "Garamond" }] },
    { "type": "range", "id": "breadcrumb_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Font size", "default": 12 },
    { "type": "color", "id": "breadcrumb_color", "label": "Color", "default": "#8a8a8a" },
    { "type": "header", "content": "Best seller" },
    { "type": "product_list", "id": "bestseller_products", "label": "Best seller products", "limit": 50, "info": "Only these products show the Best Seller label. Leave this empty to hide it." },
    { "type": "header", "content": "Global design" },
    { "type": "range", "id": "title_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Title size", "default": 24 },
    { "type": "range", "id": "title_line", "min": 20, "max": 48, "step": 1, "unit": "px", "label": "Title line height", "default": 30 },
    { "type": "text", "id": "title_weight", "label": "Title weight", "default": "400" },
    { "type": "text", "id": "title_spacing", "label": "Title letter spacing", "default": "0.4px" },
    { "type": "range", "id": "price_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Price size", "default": 28 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "background", "label": "Section background color", "default": "#F0F0F0" },
    { "type": "header", "content": "Mobile product" },
    { "type": "range", "id": "mobile_arrow_size", "min": 28, "max": 52, "step": 2, "unit": "px", "label": "Image arrow size", "default": 36 },
    { "type": "color", "id": "mobile_arrow_bg", "label": "Image arrow background", "default": "#ffffff" },
    { "type": "color", "id": "mobile_arrow_color", "label": "Image arrow color", "default": "#222222" },
    { "type": "range", "id": "mobile_title_size", "min": 14, "max": 24, "step": 1, "unit": "px", "label": "Title size", "default": 16 },
    { "type": "range", "id": "mobile_price_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Price size", "default": 14 },
    { "type": "range", "id": "mobile_rating_size", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Rating size", "default": 12 },
    { "type": "range", "id": "mobile_swatch_w", "min": 40, "max": 80, "step": 2, "unit": "px", "label": "Swatch width", "default": 52 },
    { "type": "range", "id": "mobile_swatch_h", "min": 48, "max": 96, "step": 2, "unit": "px", "label": "Swatch height", "default": 60 },
    { "type": "color", "id": "mobile_swatch_border", "label": "Selected swatch border", "default": "#111111" },
    { "type": "range", "id": "mobile_btn_h", "min": 40, "max": 64, "step": 2, "unit": "px", "label": "Button height", "default": 46 },
    { "type": "range", "id": "mobile_btn_radius", "min": 0, "max": 16, "step": 1, "unit": "px", "label": "Button corner radius", "default": 2 },
    { "type": "range", "id": "mobile_qty_w", "min": 44, "max": 72, "step": 2, "unit": "px", "label": "Quantity width", "default": 52 },
    { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Page width", "default": 1320 },
    { "type": "range", "id": "info_gap", "min": 12, "max": 64, "step": 1, "unit": "px", "label": "Space between image and details", "default": 27 }
  ],
  "blocks": [
    {
      "type": "gallery",
      "name": "Product gallery",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show gallery", "default": true },
        { "type": "range", "id": "image_height", "min": 320, "max": 800, "step": 5, "unit": "px", "label": "Image height", "default": 495 },
        { "type": "range", "id": "mobile_image_height", "min": 240, "max": 640, "step": 10, "unit": "px", "label": "Mobile image height", "default": 360 },
        { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }] },
        { "type": "header", "content": "Thumbnails" },
        { "type": "select", "id": "thumb_position", "label": "Thumbnail position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }, { "value": "bottom", "label": "Bottom" }] },
        { "type": "range", "id": "thumb_count", "min": 2, "max": 6, "step": 1, "label": "Visible thumbnails", "default": 3 },
        { "type": "range", "id": "thumb_width", "min": 48, "max": 140, "step": 2, "unit": "px", "label": "Thumbnail width", "default": 86 },
        { "type": "range", "id": "thumb_height", "min": 48, "max": 160, "step": 2, "unit": "px", "label": "Thumbnail height", "default": 108 },
        { "type": "range", "id": "thumb_gap", "min": 4, "max": 24, "step": 1, "unit": "px", "label": "Thumbnail spacing", "default": 8 },
        { "type": "color", "id": "thumb_border", "label": "Active thumbnail border", "default": "#111111" },
        { "type": "range", "id": "arrow_size", "min": 8, "max": 28, "step": 1, "unit": "px", "label": "Arrow size", "default": 14 },
        { "type": "color", "id": "arrow_color", "label": "Arrow color", "default": "#222222" },
        { "type": "text", "id": "bag_size_label", "label": "Bag size button", "default": "See bag size" },
        { "type": "image_picker", "id": "bag_size_image", "label": "Bag size image" }
      ]
    },
    {
      "type": "title",
      "name": "Product title",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "font_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Font size", "default": 24 },
        { "type": "color", "id": "color", "label": "Color", "default": "#111111" },
        { "type": "range", "id": "spacing", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Space below", "default": 10 }
      ]
    },
    {
      "type": "badge",
      "name": "Badge and reviews stars",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "bestseller_label", "label": "Bestseller label", "default": "Bestseller" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_compare", "label": "Show compare-at price", "default": true },
