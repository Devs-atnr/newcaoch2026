{{ 'coach-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coach-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign color_index = -1
  assign bestseller_tag = section.settings.bestseller_tag | default: 'bestseller'
  assign is_bestseller = false
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == bestseller_tag or tag_down contains 'bestseller' or tag_down contains 'best seller'
      assign is_bestseller = true
    endif
  endfor
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur'
      assign color_index = forloop.index0
    endif
  endfor
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign style_number = product.metafields.custom.style_number | default: current.sku
  assign measurements = product.metafields.custom.measurements
  assign materials = product.metafields.custom.materials
  assign strap = product.metafields.custom.strap
  assign features = product.metafields.custom.features
  assign editors_note = product.metafields.custom.editors_note | default: product.description
  assign has_size = false
  assign size_index = -1
  for option in product.options_with_values
    assign size_name = option.name | downcase
    if size_name contains 'size'
      assign has_size = true
      assign size_index = forloop.index0
    endif
  endfor
-%}

<coach-product-page
  class="coach-product"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-qty-max="{{ section.settings.qty_max | default: 10 }}"
  style="--pdp-font: {{ section.settings.body_font | default: 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif' | escape }}; --pdp-title-font: {{ section.settings.title_font | default: 'GaramondMTProRegular, Times New Roman, Times, serif' | escape }}; --pdp-title-size: {{ section.settings.title_size | default: 24 }}px; --pdp-title-line: {{ section.settings.title_line | default: 30 }}px; --pdp-title-weight: {{ section.settings.title_weight | default: 400 }}; --pdp-title-spacing: {{ section.settings.title_spacing | default: '0.4px' | escape }}; --pdp-price-size: {{ section.settings.price_size | default: 28 }}px; --pdp-text: {{ section.settings.text_color | default: '#111111' }}; --pdp-bg: {{ section.settings.background | default: '#ffffff' }}; --pdp-border: {{ section.settings.border_width | default: 1 }}px; --pdp-border-color: {{ section.settings.border_color | default: '#d5d5d5' }}; --pdp-thumb-w: {{ section.settings.thumb_width | default: 86 }}px; --pdp-thumb-h: {{ section.settings.thumb_height | default: 108 }}px; --pdp-thumb-gap: {{ section.settings.thumb_gap | default: 8 }}px; --pdp-image-h: {{ section.settings.image_height | default: 495 }}px; --pdp-image-fit: {{ section.settings.image_fit | default: 'contain' }}; --pdp-swatch-w: {{ section.settings.swatch_width | default: 72 }}px; --pdp-swatch-h: {{ section.settings.swatch_height | default: 86 }}px; --pdp-size-h: {{ section.settings.size_height | default: 48 }}px; --pdp-size-gap: {{ section.settings.size_gap | default: 8 }}px; --pdp-guide-w: {{ section.settings.guide_width | default: 550 }}px; --pdp-guide-h: {{ section.settings.guide_height | default: 400 }}px; --pdp-gap: {{ section.settings.info_gap | default: 27 }}px;"
>
  {%- if section.settings.show_breadcrumb -%}
    <nav class="coach-product__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Coach' | escape }}</a>
      {%- if collection -%}
        <span aria-hidden="true">/</span>
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      {%- elsif product.collections.first -%}
        <span aria-hidden="true">/</span>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>
  {%- endif -%}

  <div class="coach-product__layout">
    <div class="coach-product__gallery">
      <div class="coach-product__thumbs">
        <button type="button" class="coach-product__thumb-nav js-thumb-prev" aria-label="Previous images">
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 7L7 1L13 7" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
        <div class="coach-product__thumb-list js-thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button
                type="button"
                class="coach-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ media | image_url: width: 1400 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="{{ product.title | escape }} image {{ forloop.index }}"
              >
                {{ media | image_url: width: 160 | image_tag: alt: media.alt, loading: 'lazy' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button type="button" class="coach-product__thumb-nav js-thumb-next" aria-label="Next images">
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
      </div>

      <div class="coach-product__stage">
        {%- if is_bestseller -%}
          <span class="coach-product__flag">{{ section.settings.bestseller_label | default: 'Bestseller' | escape }}</span>
        {%- endif -%}
        {%- if section.settings.bag_size_image != blank -%}
          <button type="button" class="coach-product__size-btn js-bag-size">{{ section.settings.bag_size_label | default: 'See bag size' | escape }}</button>
        {%- endif -%}
        <button type="button" class="coach-product__heart" aria-label="Wishlist" aria-pressed="false" data-wishlist>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20.4s-7.6-4.5-9.3-9.4C1.6 7.7 3.6 4.4 7 4.4c2.1 0 3.6 1.2 5 3.1 1.4-1.9 2.9-3.1 5-3.1 3.4 0 5.4 3.3 4.3 6.6-1.7 4.9-9.3 9.4-9.3 9.4z"/></svg>
        </button>
        {%- if color_index >= 0 -%}
          <span class="coach-product__color-label js-color-label">{{ current.options[color_index] }}</span>
        {%- endif -%}
        {%- assign main_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        {%- if main_media -%}
          <img
            class="coach-product__image js-main-image"
            src="{{ main_media | image_url: width: 1400 }}"
            alt="{{ main_media.alt | default: product.title | escape }}"
            width="1400"
            height="1400"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'coach-product__image' }}
        {%- endif -%}
      </div>
    </div>

    <div class="coach-product__info">
      <h1 class="coach-product__title">{{ product.title | escape }}</h1>

      <div class="coach-product__meta"{% unless is_bestseller or rating != blank or product.metafields.judgeme.badge != blank %} hidden{% endunless %}>
        {%- if is_bestseller -%}
          <span class="coach-product__pill">{{ section.settings.bestseller_label | default: 'Bestseller' | escape }}</span>
        {%- endif -%}
        {%- if product.metafields.judgeme.badge != blank -%}
          <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">{{ product.metafields.judgeme.badge }}</div>
        {%- elsif rating != blank -%}
          <span class="coach-product__stars" aria-label="{{ rating.rating }} out of 5">
            {%- assign filled = rating.rating | round -%}
            {%- for i in (1..5) -%}
              <span{% if i <= filled %} class="is-on"{% endif %}>★</span>
            {%- endfor -%}
          </span>
          {%- if rating_count != blank -%}
            <span class="coach-product__review-count">({{ rating_count }})</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      <p class="coach-product__price">
        <span class="js-price-now">{{ current.price | money }}</span>
        <s class="js-price-compare"{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money }}{% endif %}</s>
      </p>
      {%- if has_size and section.settings.size_note != blank -%}
        <p class="coach-product__size-note">{{ section.settings.size_note | escape }}</p>
      {%- endif -%}

      <form class="coach-product__form js-product-form" action="{{ routes.cart_add_url }}" method="post">
        <input type="hidden" name="id" class="js-variant-id" value="{% unless has_size %}{{ current.id }}{% endunless %}">

        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- if color_index == forloop.index0 -%}
            <p class="coach-product__option-label">{{ option.name | escape }}: <span class="js-option-label">{{ option.selected_value | escape }}</span></p>
            <div class="coach-product__swatches" role="list">
              {%- for value in option.values -%}
                {%- assign swatch_variant = nil -%}
                {%- assign color_available = false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[color_index] == value -%}
                    {%- if swatch_variant == nil -%}
                      {%- assign swatch_variant = variant -%}
                    {%- endif -%}
                    {%- if variant.available -%}
                      {%- assign color_available = true -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                <button
                  type="button"
                  class="coach-product__swatch{% if option.selected_value == value %} is-active{% endif %}{% unless color_available %} is-unavailable{% endunless %}"
                  data-option-index="{{ color_index }}"
                  data-value="{{ value | escape }}"
                  aria-label="{{ value | escape }}"
                  {% unless color_available %}disabled{% endunless %}
                >
                  {%- if swatch_variant.featured_media -%}
                    {{ swatch_variant.featured_media | image_url: width: 120 | image_tag: alt: value }}
                  {%- elsif swatch_variant.image -%}
                    {{ swatch_variant.image | image_url: width: 120 | image_tag: alt: value }}
                  {%- else -%}
                    <span>{{ value | escape }}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- else -%}
            {%- assign is_size = false -%}
            {%- if option_name contains 'size' -%}
              {%- assign is_size = true -%}
            {%- endif -%}
            <p class="coach-product__option-label">
              {{ option.name | escape }}{% if is_size %}: <span class="js-option-value" data-for-option="{{ forloop.index0 }}">Select a size</span>{% endif %}
            </p>
            <div class="coach-product__choices{% if is_size %} coach-product__choices--size{% endif %}">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="coach-product__choice"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-value="{{ value | escape }}"
                >{{ value | escape }}</button>
              {%- endfor -%}
            </div>
            {%- if is_size -%}
              <button type="button" class="coach-product__size-guide js-size-guide">{{ section.settings.size_guide_label | default: 'Size Guide' | escape }}</button>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <p class="coach-product__stock js-stock" hidden></p>
        <div class="coach-product__buy">
          <div class="coach-product__qty">
            <select class="js-qty-input" name="quantity" aria-label="Quantity">
              <option value="1">1</option>
            </select>
          </div>
          <button type="submit" class="coach-product__add js-add"{% if has_size or current.available == false %} disabled{% endif %}>
            {{ section.settings.add_label | default: 'Add to bag' | escape }}
          </button>
        </div>
        {%- if section.settings.show_buy_now -%}
          <button type="button" class="coach-product__now js-buy-now"{% if has_size or current.available == false %} disabled{% endif %}>
            {{ section.settings.buy_now_label | default: 'Buy now' | escape }}
          </button>
        {%- endif -%}
        <p class="coach-product__error js-error" role="alert"></p>
      </form>

      {%- if section.settings.shipping_text != blank -%}
        <details class="coach-product__acc">
          <summary>{{ section.settings.shipping_heading | default: 'Shipping And Returns' | escape }}</summary>
          <div class="coach-product__acc-body rte">{{ section.settings.shipping_text }}</div>
        </details>
      {%- endif -%}

      <details class="coach-product__acc" open>
        <summary>{{ section.settings.details_heading | default: 'Product Details' | escape }}</summary>
        <div class="coach-product__acc-body">
          <dl class="coach-product__specs">
            {%- if measurements != blank -%}
              <div><dt>Measurements</dt><dd>{{ measurements | newline_to_br }}</dd></div>
            {%- endif -%}
            {%- if materials != blank -%}
              <div><dt>Materials</dt><dd>{{ materials | newline_to_br }}</dd></div>
            {%- endif -%}
            {%- if strap != blank -%}
              <div><dt>Strap</dt><dd>{{ strap | escape }}</dd></div>
            {%- endif -%}
            {%- if features != blank -%}
              <div><dt>Features</dt><dd>{{ features | newline_to_br }}</dd></div>
            {%- endif -%}
          </dl>
        </div>
      </details>

      {%- if editors_note != blank -%}
        <details class="coach-product__acc">
          <summary>{{ section.settings.notes_heading | default: "Editor's Notes" | escape }}</summary>
          <div class="coach-product__acc-body rte">{{ editors_note }}</div>
        </details>
      {%- endif -%}

      <div class="coach-product__share">
        <span>{{ section.settings.share_label | default: 'Share This Product' | escape }}</span>
        <a href="https://www.facebook.com/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">f</a>
        <a href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: product.url | url_encode }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Pinterest">p</a>
        <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: product.url | url_encode }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="X">𝕏</a>
        <a href="mailto:?subject={{ product.title | url_encode }}&body={{ shop.url | append: product.url | url_encode }}" aria-label="Email">✉</a>
      </div>
    </div>
  </div>

  <div class="coach-product__rail" data-rail="also">
    <h2>{{ section.settings.also_heading | default: 'You May Also Like' | escape }}</h2>
    <div class="coach-product__rail-row">
      <div class="coach-product__rail-track js-also"></div>
      <button type="button" class="coach-product__rail-next js-also-next" aria-label="Next products">
        <svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M2 2L8 8L2 14" stroke="currentColor" stroke-width="1.3"/></svg>
      </button>
    </div>
  </div>

  <div class="coach-product__rail" data-rail="recent" hidden>
    <h2>{{ section.settings.recent_heading | default: 'Recently Viewed' | escape }}</h2>
    <div class="coach-product__rail-track js-recent"></div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="coach-product__faq">
      <h2>{{ section.settings.faq_heading | default: 'Frequently Asked Questions' | escape }}</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' and block.settings.question != blank -%}
          <details class="coach-product__faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="coach-product__reviews" id="judgeme_product_reviews">
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>

  {%- if section.settings.bag_size_image != blank -%}
    <div class="coach-product__modal" hidden>
      <button type="button" class="coach-product__modal-bg js-bag-size-close" aria-label="Close"></button>
      <div class="coach-product__modal-card">
        <button type="button" class="js-bag-size-close" aria-label="Close">×</button>
        {{ section.settings.bag_size_image | image_url: width: 900 | image_tag: alt: section.settings.bag_size_label }}
      </div>
    </div>
  {%- endif -%}

  {%- if has_size -%}
    <div class="coach-size-guide" hidden>
      <button type="button" class="coach-size-guide__bg js-guide-close" aria-label="Close size guide"></button>
      <div class="coach-size-guide__card" role="dialog" aria-modal="true" aria-labelledby="CoachSizeGuideTitle-{{ section.id }}">
        <button type="button" class="coach-size-guide__close js-guide-close" aria-label="Close">×</button>
        <h2 id="CoachSizeGuideTitle-{{ section.id }}" class="js-guide-title"></h2>
        <p class="coach-size-guide__hint">Scroll horizontally to see more sizes.</p>
        <div class="coach-size-guide__scroll">
          <table class="js-guide-table"></table>
        </div>
        <div class="coach-size-guide__note js-guide-note"></div>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" class="js-coach-product-data">
    {
      "colorIndex": {{ color_index }},
      "sizeIndex": {{ size_index }},
      "productType": {{ product.type | json }},
      "tags": {{ product.tags | json }},
      "options": {{ product.options | json }},
      "sizeGuide": {% if product.metafields.custom.size_guide != blank %}{{ product.metafields.custom.size_guide.value | json }}{% elsif product.metafields.custom.size_chart != blank %}{{ product.metafields.custom.size_chart.value | json }}{% else %}null{% endif %},
      "media": [
        {%- assign media_first = true -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- unless media_first -%},{%- endunless -%}
            {%- assign media_first = false -%}
            {
              "src": {{ media | image_url: width: 1400 | json }},
              "thumb": {{ media | image_url: width: 200 | json }},
              "alt": {{ media.alt | default: product.title | json }}
            }
          {%- endif -%}
        {%- endfor -%}
      ],
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | money | json }},
            "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
            "sku": {{ variant.sku | json }},
            "inventory": {{ variant.inventory_quantity | default: 0 }},
            "tracked": {% if variant.inventory_management %}true{% else %}false{% endif %},
            "policy": {{ variant.inventory_policy | json }},
            "image": {% if variant.featured_media %}{{ variant.featured_media | image_url: width: 1400 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</coach-product-page>

{% schema %}
{
  "name": "Coach product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_home", "label": "Home label", "default": "Coach" },
    { "type": "text", "id": "bestseller_tag", "label": "Bestseller tag", "default": "bestseller" },
    { "type": "text", "id": "bestseller_label", "label": "Bestseller label", "default": "Bestseller" },
    { "type": "text", "id": "add_label", "label": "Add to bag label", "default": "Add to bag" },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy now", "default": true },
    { "type": "text", "id": "buy_now_label", "label": "Buy now label", "default": "Buy now" },
    { "type": "text", "id": "size_note", "label": "Size note", "default": "Please check our size guide before ordering" },
    { "type": "text", "id": "size_guide_label", "label": "Size guide label", "default": "Size Guide" },
    { "type": "url", "id": "size_guide_url", "label": "Size guide link" },
    { "type": "text", "id": "bag_size_label", "label": "Bag size button", "default": "See bag size" },
    { "type": "image_picker", "id": "bag_size_image", "label": "Bag size image" },
    { "type": "text", "id": "shipping_heading", "label": "Shipping heading", "default": "Shipping And Returns" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping and returns", "default": "<p>Complimentary shipping and easy returns. See our shipping and returns pages for full details.</p>" },
    { "type": "text", "id": "details_heading", "label": "Details heading", "default": "Product Details" },
    { "type": "text", "id": "notes_heading", "label": "Notes heading", "default": "Editor's Notes" },
    { "type": "text", "id": "share_label", "label": "Share label", "default": "Share This Product" },
    { "type": "text", "id": "also_heading", "label": "Recommendations heading", "default": "You May Also Like" },
    { "type": "text", "id": "recent_heading", "label": "Recently viewed heading", "default": "Recently Viewed" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "reviews_heading", "label": "Reviews heading", "default": "Reviews" },
    { "type": "header", "content": "Typography" },
    { "type": "text", "id": "body_font", "label": "Body font family", "default": "HelveticaLTPro-Roman, Helvetica, Arial, sans-serif" },
    { "type": "text", "id": "title_font", "label": "Title and price font", "default": "GaramondMTProRegular, Times New Roman, Times, serif" },
    { "type": "range", "id": "title_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Title size", "default": 24 },
    { "type": "range", "id": "title_line", "min": 20, "max": 48, "step": 1, "unit": "px", "label": "Title line height", "default": 30 },
    { "type": "text", "id": "title_weight", "label": "Title weight", "default": "400" },
    { "type": "text", "id": "title_spacing", "label": "Title letter spacing", "default": "0.4px" },
    { "type": "range", "id": "price_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Price size", "default": 28 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Borders and gallery" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#d5d5d5" },
    { "type": "range", "id": "border_width", "min": 1, "max": 3, "step": 1, "unit": "px", "label": "Border thickness", "default": 1 },
    { "type": "range", "id": "thumb_width", "min": 60, "max": 120, "step": 2, "unit": "px", "label": "Thumbnail width", "default": 86 },
