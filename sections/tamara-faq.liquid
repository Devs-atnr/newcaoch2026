<div
  id="TamaraFaq-{{ section.id }}"
  class="tamara-faq tamara-faq--{{ section.settings.alignment }}"
  style="
    --fq-bg: {{ section.settings.background }};
    --fq-text: {{ section.settings.text_color }};
    --fq-heading: {{ section.settings.heading_color }};
    --fq-width: {{ section.settings.content_width }}px;
    --fq-pt: {{ section.settings.padding_top }}px;
    --fq-pb: {{ section.settings.padding_bottom }}px;
    --fq-size: {{ section.settings.heading_size }}px;
    --fq-q: {{ section.settings.question_size }}px;
  "
>
  <div class="tamara-faq__wrap">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="tamara-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.tamara-faq { background: var(--fq-bg, #fff); color: var(--fq-text, #111); font-family: Arial, Helvetica, sans-serif; }
.tamara-faq__wrap { width: min(100% - 32px, var(--fq-width, 1200px)); margin: 0 auto; padding: var(--fq-pt, 60px) 0 var(--fq-pb, 0); }
.tamara-faq h2 { margin: 0 0 25px; color: var(--fq-heading, #111); font-family: Arial, Helvetica, sans-serif !important; font-size: 24px !important; font-weight: 700 !important; line-height: 1.4 !important; }
.tamara-faq details { border-bottom: 1px solid #ddd; padding: 22px 0; }
.tamara-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 15px; cursor: pointer; list-style: none; color: var(--fq-heading, #111); font-size: 16px !important; font-weight: 600 !important; line-height: 1.6 !important; }
.tamara-faq summary::-webkit-details-marker { display: none; }
.tamara-faq summary::marker { content: ""; }
.tamara-faq summary::after { content: "+"; font-size: 27px; font-weight: 400; line-height: 1; }
.tamara-faq details[open] summary::after { content: "−"; }
.tamara-faq__answer { padding: 20px 0 5px; }
.tamara-faq__answer, .tamara-faq__answer p, .tamara-faq__answer li { color: var(--fq-text, #111); font-size: 15px !important; font-weight: 400 !important; line-height: 1.8 !important; }
.tamara-faq__answer p { margin: 0 0 15px; }
.tamara-faq__answer ol, .tamara-faq__answer ul { margin: 15px 0; padding-left: 28px; }
.tamara-faq__answer ol { list-style: decimal; }
.tamara-faq__answer a { color: #111; text-decoration: underline; text-underline-offset: 4px; }
.tamara-faq--center summary { text-align: center; }
@media screen and (min-width: 768px) {
  .tamara-faq h2 { font-size: var(--fq-size, 30px) !important; margin-bottom: 30px; }
  .tamara-faq summary { gap: 22px; font-size: var(--fq-q, 19px) !important; }
  .tamara-faq__answer, .tamara-faq__answer p { font-size: 17px !important; line-height: 1.75 !important; }
  .tamara-faq__answer li { font-size: 16px !important; line-height: 1.9 !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Tamara FAQ",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "range", "id": "heading_size", "min": 18, "max": 48, "step": 1, "unit": "px", "label": "Heading size", "default": 30 },
    { "type": "range", "id": "question_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Question size", "default": 19 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "range", "id": "content_width", "min": 720, "max": 1400, "step": 20, "unit": "px", "label": "Content width", "default": 1200 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top spacing", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 0 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Tamara FAQ" }]
}
{% endschema %}
