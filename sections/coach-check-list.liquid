{{ 'coach-check-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.heading_font == 'garamond'
    assign heading_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign label_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.label_font == 'garamond'
    assign label_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
-%}

<section
  class="coach-check-list"
  style="--cl-bg: {{ section.settings.background | default: '#ffffff' }}; --cl-img: {{ section.settings.image_background | default: '#e8d4be' }}; --cl-cols: {{ section.settings.columns_desktop | default: 4 }}; --cl-cols-m: {{ section.settings.columns_mobile | default: 2 }}; --cl-gap: {{ section.settings.gap | default: 4 }}px; --cl-gap-m: {{ section.settings.gap_mobile | default: 4 }}px; --cl-h: {{ section.settings.image_height | default: 140 }}; --cl-h-m: {{ section.settings.image_height_mobile | default: 140 }}; --cl-pt: {{ section.settings.padding_top | default: 28 }}px; --cl-pr: {{ section.settings.padding_right | default: 0 }}px; --cl-pb: {{ section.settings.padding_bottom | default: 36 }}px; --cl-pl: {{ section.settings.padding_left | default: 0 }}px; --cl-pt-m: {{ section.settings.padding_top_mobile | default: 24 }}px; --cl-pb-m: {{ section.settings.padding_bottom_mobile | default: 28 }}px; --cl-heading-font: {{ heading_font }}; --cl-heading-size: {{ section.settings.heading_size | default: 11 }}px; --cl-heading-size-m: {{ section.settings.heading_size_mobile | default: 11 }}px; --cl-heading-color: {{ section.settings.heading_color | default: '#111111' }}; --cl-heading-weight: {{ section.settings.heading_weight | default: '400' }}; --cl-heading-space: {{ section.settings.heading_space | default: 22 }}px; --cl-track: {{ section.settings.heading_spacing | default: 2 }}px; --cl-label-font: {{ label_font }}; --cl-label-size: {{ section.settings.label_size | default: 16 }}px; --cl-label-size-m: {{ section.settings.label_size_mobile | default: 14 }}px; --cl-text-size: {{ section.settings.text_size | default: 13 }}px; --cl-text-size-m: {{ section.settings.text_size_mobile | default: 12 }}px; --cl-label-color: {{ section.settings.label_color | default: '#111111' }}; --cl-label-weight: {{ section.settings.label_weight | default: '700' }}; --cl-label-space: {{ section.settings.label_space | default: 18 }}px; --cl-fit: {{ section.settings.image_fit | default: 'cover' }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="coach-check-list__heading{% if section.settings.show_heading_desktop == false %} is-desk-hide{% endif %}{% if section.settings.show_heading_mobile == false %} is-mob-hide{% endif %}">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="coach-check-list__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_link = block.settings.link
        if block.settings.collection != blank
          assign card_link = block.settings.collection.url
        endif
        if card_link == blank
          assign card_link = '#'
        endif
      -%}
      <a class="coach-check-list__card" href="{{ card_link }}" {{ block.shopify_attributes }}>
        <span class="coach-check-list__media">
          {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.title, loading: 'lazy' }}
              {%- else -%}
                {{ block.settings.image_mobile | image_url: width: 900 | image_tag: alt: block.settings.title, loading: 'lazy' }}
              {%- endif -%}
            </picture>
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <span class="coach-check-list__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <span class="coach-check-list__title">{{ block.settings.title | escape }}</span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Check list",
  "tag": "section",
  "class": "coach-check-list-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check off your list" },
    { "type": "checkbox", "id": "show_heading_desktop", "label": "Show heading on desktop", "default": true },
    { "type": "checkbox", "id": "show_heading_mobile", "label": "Show heading on mobile", "default": true },
    { "type": "select", "id": "heading_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "heading_size", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Desktop size", "default": 11 },
    { "type": "range", "id": "heading_size_mobile", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Mobile size", "default": 11 },
    { "type": "select", "id": "heading_weight", "label": "Weight", "default": "400", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_spacing", "min": 0, "max": 6, "step": 1, "unit": "px", "label": "Letter spacing", "default": 2 },
    { "type": "range", "id": "heading_space", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Space below heading", "default": 22 },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Mobile columns", "default": 2 },
    { "type": "range", "id": "gap", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Desktop gap", "default": 4 },
    { "type": "range", "id": "gap_mobile", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Mobile gap", "default": 4 },
    { "type": "range", "id": "image_height", "min": 100, "max": 180, "step": 5, "unit": "%", "label": "Card height", "info": "140 matches the reference on desktop and mobile. A higher number makes every card taller.", "default": 140 },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#e8d4be" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" }
    ] },
    { "type": "header", "content": "Label" },
    { "type": "select", "id": "label_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "label_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Size", "info": "Same size on desktop and mobile.", "default": 16 },
    { "type": "select", "id": "label_weight", "label": "Weight", "default": "700", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "label_space", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Space from image bottom", "default": 18 },
    { "type": "range", "id": "text_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Text desktop size", "default": 13 },
    { "type": "range", "id": "text_size_mobile", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Text mobile size", "default": 12 },
    { "type": "color", "id": "label_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Desktop padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom", "default": 36 },
    { "type": "range", "id": "padding_left", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Left", "default": 0 },
    { "type": "range", "id": "padding_right", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Right", "default": 0 },
    { "type": "header", "content": "Mobile padding" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 64, "step": 4, "unit": "px", "label": "Top", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 64, "step": 4, "unit": "px", "label": "Bottom", "default": 28 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
        { "type": "text", "id": "title", "label": "Title", "default": "New Arrivals" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Used when no collection is selected." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Check off your list",
      "blocks": [
        { "type": "card", "settings": { "title": "New Arrivals" } },
        { "type": "card", "settings": { "title": "Shoulder Bags" } },
        { "type": "card", "settings": { "title": "Wallets & Wristlets" } },
        { "type": "card", "settings": { "title": "Men's" } }
      ]
    }
  ]
}
{% endschema %}
