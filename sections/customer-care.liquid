{%- liquid
  assign menu = section.settings.menu
  assign cat_transform = 'uppercase'
  if section.settings.category_uppercase == false
    assign cat_transform = 'none'
  endif
-%}

<div
  id="CoachCare-{{ section.id }}"
  class="coach-care{% if section.settings.sticky_sidebar %} is-sticky{% endif %}{% if section.settings.mobile_collapse %} is-collapse{% endif %}{% if section.settings.underline_active %} is-underline{% endif %}{% if section.settings.mobile_left == 'hide' %} is-hide-left{% endif %}{% if section.settings.mobile_right == 'hide' %} is-hide-right{% endif %}"
  style="
    --care-side: {{ section.settings.sidebar_width | default: 33 }}%;
    --care-side-bg: {{ section.settings.sidebar_background | default: '#f5f5f5' }};
    --care-main-bg: {{ section.settings.content_background | default: '#ffffff' }};
    --care-l1-size: {{ section.settings.heading_size | default: 20 }}px;
    --care-l1-color: {{ section.settings.heading_color | default: '#111111' }};
    --care-l1-weight: {{ section.settings.heading_weight | default: '700' }};
    --care-l2-size: {{ section.settings.category_size | default: 16 }}px;
    --care-l2-color: {{ section.settings.category_color | default: '#111111' }};
    --care-l2-weight: {{ section.settings.category_weight | default: '700' }};
    --care-l2-case: {{ cat_transform }};
    --care-l3-size: {{ section.settings.link_size | default: 14 }}px;
    --care-l3-color: {{ section.settings.link_color | default: '#111111' }};
    --care-active: {{ section.settings.active_color | default: '#111111' }};
    --care-hover: {{ section.settings.hover_color | default: '#111111' }};
    --care-cat-space: {{ section.settings.category_space | default: 28 }}px;
    --care-link-space: {{ section.settings.link_space | default: 12 }}px;
    --care-s-py: {{ section.settings.sidebar_padding_y | default: 48 }}px;
    --care-s-px: {{ section.settings.sidebar_padding_x | default: 32 }}px;
    --care-c-py: {{ section.settings.content_padding_y | default: 48 }}px;
    --care-c-px: {{ section.settings.content_padding_x | default: 48 }}px;
    --care-content: {{ section.settings.content_max | default: 760 }}px;
    --care-min: {{ section.settings.min_height | default: 0 }}px;
    --care-sticky: {{ section.settings.sticky_top | default: 24 }}px;
    --care-m-pad: {{ section.settings.mobile_padding | default: 16 }}px;
    --care-m-gap: {{ section.settings.mobile_spacing | default: 0 }}px;
  "
>
  <div class="coach-care__frame">
    <coach-care-nav class="coach-care__side">
      {%- if section.settings.mobile_collapse -%}
        <button
          type="button"
          class="coach-care__toggle"
          data-care-toggle
          aria-expanded="false"
          aria-controls="CoachCarePanel-{{ section.id }}"
        >
          <span>Menu</span>
          <svg class="coach-care__chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      {%- endif -%}
      <div class="coach-care__panel" id="CoachCarePanel-{{ section.id }}" data-care-panel{% if section.settings.mobile_collapse %} hidden{% endif %}>
        {%- if menu != blank and menu.links.size > 0 -%}
          <nav class="coach-care__nav" aria-label="{{ menu.title | escape }}">
            {%- for link in menu.links -%}
              <div class="coach-care__level">
                {%- if link.url != blank -%}
                  <a class="coach-care__l1{% if link.current %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- else -%}
                  <p class="coach-care__l1">{{ link.title | escape }}</p>
                {%- endif -%}
                {%- if link.links.size > 0 -%}
                  {%- for child in link.links -%}
                    <div class="coach-care__group">
                      {%- if child.links.size > 0 -%}
                        <p class="coach-care__l2">{{ child.title | escape }}</p>
                        <ul class="coach-care__links">
                          {%- for grand in child.links -%}
                            <li>
                              <a class="coach-care__l3{% if grand.current %} is-active{% endif %}" href="{{ grand.url }}"{% if grand.current %} aria-current="page"{% endif %}>{{ grand.title | escape }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <a class="coach-care__l2{% if child.current %} is-active{% endif %}" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </coach-care-nav>

    <div class="coach-care__main">
      <div class="coach-care__inner">
        {%- assign care_contact_used = false -%}
        {%- assign care_signup_used = false -%}
        {%- assign care_login_used = false -%}
        {%- assign faq_group_open = false -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign show_block = true
            if block.settings.page_handles != blank
              assign show_block = false
              assign handle_list = block.settings.page_handles | split: ','
              for handle_item in handle_list
                assign handle_clean = handle_item | strip | downcase
                if handle_clean == page.handle
                  assign show_block = true
                endif
              endfor
            endif
          -%}
          {%- if show_block -%}
            {%- if faq_group_open and block.type != 'faq' and block.type != 'faq_group' -%}
              </div></details>
              {%- assign faq_group_open = false -%}
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'track_signin' -%}
                {%- liquid
                  assign track_url = block.settings.track_link
                  if track_url == blank
                    assign track_url = '/pages/track-your-order'
                  endif
                  assign forgot_url = block.settings.forgot_link
                  if forgot_url == blank
                    assign forgot_url = routes.account_login_url | append: '#recover'
                  endif
                  assign register_url = block.settings.register_link
                  if register_url == blank
                    assign register_url = routes.account_register_url
                  endif
                -%}
                <coach-care-login
                  class="coach-care__account"
                  {{ block.shopify_attributes }}
                  style="
                    --acc-title: {{ block.settings.heading_color }};
                    --acc-title-size: {{ block.settings.heading_size }}px;
                    --acc-text: {{ block.settings.text_color }};
                    --acc-text-size: {{ block.settings.text_size }}px;
                    --acc-link: {{ block.settings.link_color }};
                    --acc-gap: {{ block.settings.column_gap }}px;
                    --acc-border: {{ block.settings.input_border }};
                    --acc-error: {{ block.settings.error_color }};
                    --acc-btn: {{ block.settings.button_background }};
                    --acc-btn-text: {{ block.settings.button_text }};
                  "
                >
                  <div class="coach-care__account-col">
                    {%- if block.settings.track_heading != blank -%}
                      <h2 class="coach-care__account-title">{{ block.settings.track_heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.track_text != blank -%}
                      <div class="coach-care__rte coach-care__track-copy">{{ block.settings.track_text }}</div>
                    {%- endif -%}
                    {%- liquid
                      assign privacy_url = block.settings.privacy_link
                      if privacy_url == blank
                        assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
                      endif
                    -%}
                    <form class="coach-care__track" action="{{ track_url }}" method="get">
                      <div class="coach-care__fields coach-care__track-fields">
                        <div class="coach-care__outline coach-care__outline--raise">
                          <input type="text" name="order_number" autocomplete="off" placeholder=" " data-care-input data-care-required>
                          <span class="coach-care__float">{{ block.settings.order_label | escape }}</span>
                          <p class="coach-care__error">{{ block.settings.order_error | escape }}</p>
                        </div>
                        {%- if block.settings.details_text != blank -%}
                          <p class="coach-care__track-note">{{ block.settings.details_text | escape }}</p>
                        {%- endif -%}
                        <div class="coach-care__outline">
                          <input type="text" name="email" inputmode="text" autocomplete="on" placeholder=" " data-care-input data-care-contact>
                          <span class="coach-care__float">{{ block.settings.track_email_label | escape }}</span>
                        </div>
                        <div class="coach-care__outline">
                          <input type="text" name="postal_code" autocomplete="postal-code" placeholder=" " data-care-input>
                          <span class="coach-care__float">{{ block.settings.postal_label | escape }}</span>
                        </div>
                        <button class="coach-care__button coach-care__signin" type="submit">{{ block.settings.track_button | escape }}</button>
                      </div>
                      {%- if block.settings.privacy_text != blank -%}
                        <p class="coach-care__privacy">{{ block.settings.privacy_text | escape }} <a href="{{ privacy_url }}">{{ block.settings.privacy_label | escape }}</a> {{ block.settings.privacy_after | escape }}</p>
                      {%- endif -%}
                    </form>
                  </div>
                  <div class="coach-care__account-col">
                    {%- if block.settings.account_heading != blank -%}
                      <h2 class="coach-care__account-title">{{ block.settings.account_heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.account_text != blank -%}
                      <div class="coach-care__rte">{{ block.settings.account_text }}</div>
                    {%- endif -%}
                    {%- if customer -%}
                      <p class="coach-care__signed">{{ block.settings.signed_in_text | escape }} {{ customer.email | escape }}</p>
                      <a class="coach-care__button coach-care__signin" href="{{ routes.account_url }}">{{ block.settings.account_button | escape }}</a>
                    {%- elsif care_login_used -%}
                      <p class="coach-care__signed">{{ block.settings.signed_in_text | escape }}</p>
                    {%- else -%}
                      {%- assign care_login_used = true -%}
                      {%- assign care_login_id = 'CareLogin-' | append: block.id -%}
                      {%- form 'customer_login', id: care_login_id, novalidate: 'novalidate' -%}
                        {%- if form.errors -%}
                          <div class="coach-care__status" role="alert">{{ form.errors | default_errors }}</div>
                        {%- endif -%}
                        <div class="coach-care__fields coach-care__fields--login">
                          <div class="coach-care__outline{% if form.email %} has-value{% endif %}">
                            <input type="email" name="customer[email]" autocomplete="email" placeholder=" " value="{% if form.email %}{{ form.email }}{% endif %}" data-care-input data-care-required data-care-email>
                            <span class="coach-care__float">{{ block.settings.email_label | escape }}</span>
                            <p class="coach-care__error">{{ block.settings.email_error | escape }}</p>
                          </div>
                          <div class="coach-care__outline coach-care__pass">
                            <input type="password" name="customer[password]" autocomplete="current-password" placeholder=" " data-care-password data-care-input data-care-required>
                            <span class="coach-care__float">{{ block.settings.password_label | escape }}</span>
                            <button class="coach-care__show" type="button" data-care-show data-show="{{ block.settings.show_label | escape }}" data-hide="{{ block.settings.hide_label | escape }}">{{ block.settings.show_label | escape }}</button>
                            <p class="coach-care__error">{{ block.settings.password_error | escape }}</p>
                          </div>
                          <div class="coach-care__login-row">
                            {%- if block.settings.show_remember -%}
                              <label class="coach-care__remember">
                                <input type="checkbox" name="customer[remember_me]" value="true">
                                <span class="coach-care__box" aria-hidden="true">
                                  <svg viewBox="0 0 16 16" focusable="false">
                                    <path d="M3.2 8.3 6.4 11.4 12.8 4.7"></path>
                                  </svg>
                                </span>
                                <span>{{ block.settings.remember_label | escape }}</span>
                              </label>
                            {%- else -%}
                              <span></span>
                            {%- endif -%}
                            <a class="coach-care__account-link" href="{{ forgot_url }}">{{ block.settings.forgot_label | escape }}</a>
                          </div>
                          <button class="coach-care__button coach-care__signin" type="submit">{{ block.settings.button_label | escape }}</button>
                        </div>
                      {%- endform -%}
                    {%- endif -%}
                    {%- if block.settings.create_label != blank -%}
                      <p class="coach-care__create"><a class="coach-care__account-link" href="{{ register_url }}">{{ block.settings.create_label | escape }}</a>{% if block.settings.create_text != blank %} {{ block.settings.create_text | escape }}{% endif %}</p>
                    {%- endif -%}
                  </div>
                </coach-care-login>
              {%- when 'page_content' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_title and page.title != blank -%}
                    <h1 class="coach-care__page-title">{{ page.title | escape }}</h1>
                  {%- endif -%}
                  {%- if page.content != blank -%}
                    <div class="coach-care__rte">{{ page.content }}</div>
                  {%- endif -%}
                  {%- if page.metafields.custom.care_content != blank -%}
                    <div class="coach-care__rte">{{ page.metafields.custom.care_content | metafield_tag }}</div>
                  {%- endif -%}
                  {%- if block.settings.extra != blank -%}
                    <div class="coach-care__rte">{{ block.settings.extra }}</div>
                  {%- endif -%}
                </div>
              {%- when 'heading' -%}
                <h2 class="coach-care__block-heading" {{ block.shopify_attributes }} style="font-size: {{ block.settings.size }}px;">{{ block.settings.heading | escape }}</h2>
              {%- when 'richtext' -%}
                <div class="coach-care__rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- when 'image' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.alt, loading: 'lazy', class: 'coach-care__image' }}
                  {%- endif -%}
                </div>
              {%- when 'image_text' -%}
                <div class="coach-care__split{% if block.settings.image_position == 'right' %} is-reverse{% endif %}" {{ block.shopify_attributes }}>
                  <div class="coach-care__split-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.alt, loading: 'lazy' }}
                    {%- endif -%}
                  </div>
                  <div class="coach-care__rte">{{ block.settings.text }}</div>
                </div>
              {%- when 'icon_text' -%}
                <div class="coach-care__icon-row" {{ block.shopify_attributes }}>
                  <span class="coach-care__icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'email' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg>
                      {%- when 'box' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3.5 8 12 4l8.5 4L12 12 3.5 8Z"></path><path d="M3.5 8v8L12 20l8.5-4V8"></path><path d="M12 12v8"></path></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 16.5c-1.8-1.2-3-2.9-3-5A6.5 6.5 0 0 1 14.2 6"></path><path d="M8 19.5 7 16.5l3 .2"></path><path d="M17 7.5c1.8 1.2 3 2.9 3 5A6.5 6.5 0 0 1 9.8 18"></path><path d="M16 4.5 17 7.5l-3-.2"></path></svg>
                    {%- endcase -%}
                  </span>
                  <div>
                    {%- if block.settings.heading != blank -%}
                      <h3 class="coach-care__block-heading">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="coach-care__rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'button' -%}
                {%- if block.settings.label != blank -%}
                  <p class="coach-care__block" {{ block.shopify_attributes }}>
                    <a class="coach-care__button" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
                  </p>
                {%- endif -%}
              {%- when 'faq_group' -%}
                {%- if faq_group_open -%}
                  </div></details>
                  {%- assign faq_group_open = false -%}
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <details class="coach-care__faq" {{ block.shopify_attributes }}{% if request.design_mode %} open{% endif %}>
                    <summary>
                      <span class="coach-care__faq-question">{{ block.settings.heading | escape }}</span>
                      <span class="coach-care__faq-chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="coach-care__faq-body">
                  {%- assign faq_group_open = true -%}
                {%- endif -%}
              {%- when 'faq' -%}
                {%- if faq_group_open -%}
                  <div class="coach-care__faq-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.question != blank -%}
                      <h3>{{ block.settings.question | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.answer != blank -%}
                      <div class="coach-care__rte">{{ block.settings.answer }}</div>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <details class="coach-care__faq" {{ block.shopify_attributes }}>
                    <summary>
                      <span class="coach-care__faq-question">{{ block.settings.question | escape }}</span>
                      <span class="coach-care__faq-chevron" aria-hidden="true"></span>
                    </summary>
                    {%- if block.settings.answer != blank -%}
                      <div class="coach-care__rte">{{ block.settings.answer }}</div>
                    {%- endif -%}
                  </details>
                {%- endif -%}
              {%- when 'email_prefs' -%}
                {%- liquid
                  assign unsub_id = 'CareUnsub-' | append: block.id
                  assign signup_id = 'CareSignup-' | append: block.id
                -%}
                <coach-care-email class="coach-email" {{ block.shopify_attributes }} style="--email-width: {{ block.settings.form_width }}px;">
                  {%- if block.settings.heading != blank -%}
                    <h2>{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <label class="coach-email__field">
                    <span class="visually-hidden">{{ block.settings.email_label | escape }}</span>
                    <input class="coach-email__input" type="email" autocomplete="email" placeholder="{{ block.settings.email_label | escape }}" data-email-source>
                    <p class="coach-email__error" data-email-error hidden>{{ block.settings.email_error | escape }}</p>
                  </label>
                  {%- unless care_contact_used -%}
                    {%- assign care_contact_used = true -%}
                    {%- form 'contact', id: unsub_id, class: 'coach-email__form' -%}
                      {%- if form.posted_successfully? -%}
                        <p class="coach-email__status" tabindex="-1">{{ block.settings.unsub_success | escape }}</p>
                      {%- endif -%}
                      <input type="hidden" name="contact[email]" data-email-target>
                      <input type="hidden" name="contact[body]" value="Please unsubscribe this email address from marketing emails.">
                      <button class="coach-email__button" type="submit">{{ block.settings.unsub_label | escape }}</button>
                    {%- endform -%}
                  {%- endunless -%}
                  <p class="coach-email__or">{{ block.settings.or_label | escape }}</p>
                  {%- unless care_signup_used -%}
                    {%- assign care_signup_used = true -%}
                    {%- form 'customer', id: signup_id, class: 'coach-email__form' -%}
                      {%- if form.posted_successfully? -%}
                        <p class="coach-email__status" tabindex="-1">{{ block.settings.signup_success | escape }}</p>
                      {%- endif -%}
                      <input type="hidden" name="contact[tags]" value="newsletter">
                      <input type="hidden" name="contact[accepts_marketing]" value="true">
                      <input type="hidden" name="contact[email]" data-email-target>
                      <button class="coach-email__button" type="submit">{{ block.settings.signup_label | escape }}</button>
                    {%- endform -%}
                  {%- endunless -%}
                  {%- if block.settings.consent != blank -%}
                    <div class="coach-email__note">{{ block.settings.consent }}</div>
                  {%- endif -%}
                </coach-care-email>
              {%- when 'contact_desk' -%}
                {%- liquid
                  assign desk_whatsapp = block.settings.whatsapp_link
                  if desk_whatsapp == blank
                    assign desk_whatsapp = 'https://wa.me/966501995607'
                  endif
                  assign desk_phone_url = block.settings.phone_link
                  if desk_phone_url == blank
                    assign desk_phone_url = 'tel:+966501995607'
                  endif
                  assign desk_topics = block.settings.topics | newline_to_br | replace: '<br />', '|' | replace: '<br>', '|' | split: '|'
                -%}
                <coach-care-desk class="coach-desk" {{ block.shopify_attributes }}>
                  <div class="coach-desk__info">
                    {%- if block.settings.heading != blank -%}
                      <h2>{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.notice != blank -%}
                      <div class="coach-desk__notice coach-desk__rte">{{ block.settings.notice }}</div>
                    {%- endif -%}
                    {%- if block.settings.hours != blank -%}
                      <div class="coach-desk__hours coach-desk__rte">{{ block.settings.hours }}</div>
                    {%- endif -%}
                    <div class="coach-desk__channel">
                      <div class="coach-desk__channel-head">
                        {%- if block.settings.whatsapp_icon != blank -%}
                          <img src="{{ block.settings.whatsapp_icon | escape }}" alt="" width="28" height="28">
                        {%- endif -%}
                        <h3>{{ block.settings.whatsapp_heading | escape }}</h3>
                      </div>
                      {%- if block.settings.whatsapp_text != blank -%}
                        <div class="coach-desk__rte">{{ block.settings.whatsapp_text }}</div>
                      {%- endif -%}
                      {%- if block.settings.show_qr != 'hide' -%}
                        {%- if block.settings.qr != blank -%}
                          {{ block.settings.qr | image_url: width: 320 | image_tag: class: 'coach-desk__qr', alt: 'WhatsApp code' }}
                        {%- else -%}
                          <img class="coach-desk__qr" alt="WhatsApp code" width="150" height="150" src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={{ desk_whatsapp | url_encode }}">
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                    <div class="coach-desk__channel">
                      <div class="coach-desk__channel-head">
                        {%- if block.settings.call_icon != blank -%}
                          <img src="{{ block.settings.call_icon | escape }}" alt="" width="28" height="28">
                        {%- endif -%}
                        <h3>{{ block.settings.call_heading | escape }}</h3>
                      </div>
                      {%- if block.settings.call_text != blank -%}
                        <div class="coach-desk__rte">{{ block.settings.call_text }}</div>
                      {%- endif -%}
                      {%- if block.settings.phone_label != blank -%}
                        <p><a class="coach-desk__phone" href="{{ desk_phone_url }}">{{ block.settings.phone_label | escape }}</a></p>
                      {%- endif -%}
                    </div>
                    <div class="coach-desk__channel">
                      <div class="coach-desk__channel-head">
                        {%- if block.settings.chat_icon != blank -%}
                          <img src="{{ block.settings.chat_icon | escape }}" alt="" width="28" height="28">
                        {%- endif -%}
                        <h3>{{ block.settings.chat_heading | escape }}</h3>
                      </div>
                      {%- if block.settings.chat_text != blank -%}
                        <div class="coach-desk__rte">{{ block.settings.chat_text }}</div>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.extra != blank -%}
                      <div class="coach-desk__extra coach-desk__rte">{{ block.settings.extra }}</div>
                    {%- endif -%}
                  </div>
                  <div class="coach-desk__mail">
                    {%- if block.settings.form_heading != blank -%}
                      <h2>{{ block.settings.form_heading | escape }}</h2>
                    {%- endif -%}
                    {%- unless care_contact_used -%}
                      {%- assign care_contact_used = true -%}
                      {%- assign care_form_id = 'CareDesk-' | append: block.id -%}
                      {%- form 'contact', id: care_form_id, class: 'coach-desk__form' -%}
                        {%- if form.posted_successfully? -%}
                          <p class="coach-desk__status" tabindex="-1">{{ block.settings.success | escape }}</p>
                        {%- elsif form.errors -%}
                          <p class="coach-desk__status" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                        {%- endif -%}
                        <p class="coach-desk__label">{{ block.settings.topic_label | escape }}</p>
                        <label class="coach-desk__field">
                          <span class="visually-hidden">{{ block.settings.topic_label | escape }}</span>
                          <select class="coach-desk__select" name="contact[topic]" required>
                            <option value="" selected disabled>{{ block.settings.topic_placeholder | escape }}</option>
                            {%- for topic in desk_topics -%}
                              {%- assign topic_clean = topic | strip -%}
                              {%- if topic_clean != blank -%}
                                <option value="{{ topic_clean | escape }}">{{ topic_clean | escape }}</option>
                              {%- endif -%}
                            {%- endfor -%}
                          </select>
                        </label>
                        <label class="coach-desk__field">
                          <span class="visually-hidden">{{ block.settings.comments_label | escape }}</span>
                          <textarea class="coach-desk__area" name="contact[body]" rows="4" required placeholder="{{ block.settings.comments_label | escape }}"></textarea>
                        </label>
                        <label class="coach-desk__field">
                          <span class="visually-hidden">{{ block.settings.order_label | escape }}</span>
                          <input class="coach-desk__input" type="text" name="contact[order_number]" autocomplete="off" placeholder="{{ block.settings.order_label | escape }}">
                        </label>
                        <p class="coach-desk__label">{{ block.settings.contact_label | escape }}</p>
                        <label class="coach-desk__field">
                          <span class="visually-hidden">{{ block.settings.name_label | escape }}</span>
                          <input class="coach-desk__input" type="text" name="contact[name]" autocomplete="name" required placeholder="{{ block.settings.name_label | escape }}" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
                        </label>
                        <label class="coach-desk__field">
                          <span class="visually-hidden">{{ block.settings.email_label | escape }}</span>
                          <input class="coach-desk__input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ block.settings.email_label | escape }}" data-desk-email value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
                        </label>
                        <label class="coach-desk__field">
                          <span class="visually-hidden">{{ block.settings.confirm_label | escape }}</span>
                          <input class="coach-desk__input" type="email" name="confirm_email" autocomplete="email" required placeholder="{{ block.settings.confirm_label | escape }}" data-desk-confirm>
                          <p class="coach-desk__error" data-desk-match hidden>{{ block.settings.confirm_error | escape }}</p>
                        </label>
                        <label class="coach-desk__field coach-desk__phone-field">
                          <span class="visually-hidden">{{ block.settings.phone_field | escape }}</span>
                          <input class="coach-desk__input" type="tel" name="contact[phone]" autocomplete="tel" required placeholder="{{ block.settings.phone_field | escape }}">
                          <button class="coach-desk__tip-btn" type="button" aria-label="{{ block.settings.phone_help | escape }}">i</button>
                          <span class="coach-desk__tip">{{ block.settings.phone_help | escape }}</span>
                        </label>
                        <button class="coach-desk__submit" type="submit">{{ block.settings.button_label | escape }}</button>
                        {%- if block.settings.privacy != blank -%}
                          <div class="coach-desk__privacy coach-desk__rte">{{ block.settings.privacy }}</div>
                        {%- endif -%}
                      {%- endform -%}
                    {%- endunless -%}
                  </div>
                </coach-care-desk>
              {%- when 'contact_form' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>
                  {%- unless care_contact_used -%}
                    {%- assign care_contact_used = true -%}
                    {%- assign care_form_id = 'CareContact-' | append: section.id -%}
                    {%- form 'contact', id: care_form_id -%}
                      {%- if form.posted_successfully? -%}
                        <p class="coach-care__status" tabindex="-1">Thanks. Your message has been sent.</p>
                      {%- elsif form.errors -%}
                        <p class="coach-care__status" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                      {%- endif -%}
                      <div class="coach-care__fields">
                        <label class="coach-care__field">
                          <span>Name</span>
                          <input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
                        </label>
                        <label class="coach-care__field">
                          <span>Email</span>
                          <input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
                        </label>
                        <label class="coach-care__field">
                          <span>Message</span>
                          <textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea>
                        </label>
                        <button class="coach-care__button" type="submit">{{ block.settings.label | default: 'Send' | escape }}</button>
                      </div>
                    {%- endform -%}
                  {%- endunless -%}
                </div>
              {%- when 'custom_liquid' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>{{ block.settings.code }}</div>
              {%- when 'video' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: controls: true, image_size: '1200x' }}
                  {%- elsif block.settings.video_url != blank -%}
                    {{ block.settings.video_url | external_video_tag }}
                  {%- endif -%}
                </div>
              {%- when 'divider' -%}
                <hr class="coach-care__divider" {{ block.shopify_attributes }}>
              {%- when 'size_table' -%}
              {%- when 'size_guide' -%}
                <coach-care-size class="coach-care__size" {{ block.shopify_attributes }} style="--sg-box: {{ block.settings.max_width }}px; --sg-title: {{ block.settings.heading_size }}px;">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="coach-care__size-title">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="coach-care__size-box">
                    <label class="coach-care__select">
                      <span class="visually-hidden">{{ block.settings.group_label | escape }}</span>
                      <select data-size-group></select>
                    </label>
                    <label class="coach-care__select">
                      <span class="visually-hidden">{{ block.settings.category_label | escape }}</span>
                      <select data-size-category></select>
                    </label>
                    <button class="coach-care__button coach-care__size-btn" type="button" data-size-view>{{ block.settings.button_label | escape }}</button>
                  </div>
                  <div data-size-result></div>
                  {%- if block.settings.extra != blank or block.settings.image != blank -%}
                    <div class="coach-care__size-extra{% if block.settings.image_height > 0 %} is-fixed{% endif %}" style="--sg-img-w: {{ block.settings.image_width }}px; --sg-img-h: {{ block.settings.image_height }}px;">
                      {%- if block.settings.extra != blank -%}
                        <div class="coach-care__rte">{{ block.settings.extra }}</div>
                      {%- endif -%}
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'coach-care__size-extra-image', alt: block.settings.image_alt }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <script type="application/json" data-size-charts>
                    [
                      {%- assign chart_index = 0 -%}
                      {%- for chart in section.blocks -%}
                        {%- if chart.type == 'size_table' -%}
                          {%- liquid
                            assign chart_ok = true
                            if chart.settings.page_handles != blank
                              assign chart_ok = false
                              assign chart_handles = chart.settings.page_handles | split: ','
                              for chart_handle in chart_handles
                                assign chart_clean = chart_handle | strip | downcase
                                if chart_clean == page.handle
                                  assign chart_ok = true
                                endif
                              endfor
                            endif
                          -%}
                          {%- if chart_ok -%}
                            {%- if chart_index > 0 -%},{%- endif -%}
                            {%- assign chart_index = chart_index | plus: 1 -%}
                            {
                              "group": {{ chart.settings.group | json }},
                              "category": {{ chart.settings.category | json }},
                              "title": {{ chart.settings.title | default: chart.settings.category | json }},
                              "noteHeading": {{ chart.settings.note_heading | json }},
                              "note": {{ chart.settings.note | json }},
                              "region": {{ chart.settings.region_column | default: 0 | json }},
                              "image": {% if chart.settings.image != blank %}{{ chart.settings.image | image_url: width: 1200 | json }}{% else %}""{% endif %},
                              "imageWidth": {{ chart.settings.image_width | default: 120 | json }},
                              "imageHeight": {{ chart.settings.image_height | default: 0 | json }},
                              "icon": {{ chart.settings.measure_icon | json }},
                              "html": {{ chart.settings.custom_html | json }},
                              "headers": [{%- assign header_cells = chart.settings.headers | split: '|' -%}{%- for cell in header_cells -%}{{ cell | strip | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
                              "rows": [{%- assign row_lines = chart.settings.rows | newline_to_br | split: '<br />' -%}{%- assign row_index = 0 -%}{%- for line in row_lines -%}{%- assign clean_line = line | strip | replace: '<br>', '' -%}{%- if clean_line != blank -%}{%- if row_index > 0 -%},{%- endif -%}{%- assign row_index = row_index | plus: 1 -%}[{%- assign row_cells = clean_line | split: '|' -%}{%- for cell in row_cells -%}{{ cell | strip | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endif -%}{%- endfor -%}]
                            }
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    ]
                  </script>
                </coach-care-size>
              {%- when 'spacer' -%}
                <div class="coach-care__spacer" style="--care-spacer: {{ block.settings.height }}px; --care-spacer-m: {{ block.settings.height_mobile }}px;" {{ block.shopify_attributes }}></div>
            {%- endcase -%}
          {%- endif -%}
          {%- if forloop.last and faq_group_open -%}
            </div></details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.coach-care {
  box-sizing: border-box;
  max-width: 100%;
  background: #ffffff;
  color: #111111;
  font-family: HelveticaLTPro-Roman, Helvetica, Arial, sans-serif;
}
.coach-care *,
.coach-care *::before,
.coach-care *::after { box-sizing: border-box; }
.coach-care__frame {
  display: grid;
  grid-template-columns: minmax(0, var(--care-side, 33%)) minmax(0, 1fr);
  align-items: stretch;
  width: 100%;
  min-height: var(--care-min, 0px);
}
.coach-care__side,
.coach-care__main { min-width: 0; }
.coach-care__side {
  background: var(--care-side-bg, #f5f5f5);
  padding: var(--care-s-py, 48px) var(--care-s-px, 32px);
}
.coach-care.is-sticky .coach-care__panel {
  position: sticky;
  top: var(--care-sticky, 24px);
}
.coach-care__toggle {
  display: none;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0 0 12px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--care-l1-color, #111);
  font: inherit;
  font-size: var(--care-l1-size, 20px);
  font-weight: var(--care-l1-weight, 700);
  text-align: left;
  cursor: pointer;
}
.coach-care__chevron { width: 18px; height: 18px; flex: none; transition: transform 0.2s ease; }
.coach-care__toggle[aria-expanded="true"] .coach-care__chevron { transform: rotate(180deg); }
.coach-care__level + .coach-care__level { margin-top: var(--care-cat-space, 28px); }
.coach-care__l1 {
  display: block;
  margin: 0 0 var(--care-cat-space, 28px);
  color: var(--care-l1-color, #111);
  font-size: var(--care-l1-size, 20px);
  font-weight: var(--care-l1-weight, 700);
  line-height: 1.3;
  text-decoration: none;
}
.coach-care__group { margin-top: var(--care-cat-space, 28px); }
.coach-care__group:first-of-type { margin-top: 0; }
.coach-care__l2 {
  display: block;
  margin: 0 0 var(--care-link-space, 12px);
  color: var(--care-l2-color, #111);
  font-size: var(--care-l2-size, 16px);
  font-weight: var(--care-l2-weight, 700);
  letter-spacing: 0.04em;
  line-height: 1.3;
  text-decoration: none;
  text-transform: var(--care-l2-case, uppercase);
}
.coach-care__links {
  margin: 0;
  padding: 0;
  list-style: none;
}
.coach-care__links > li + li { margin-top: var(--care-link-space, 12px); }
.coach-care__l3 {
  color: var(--care-l3-color, #111);
  font-size: var(--care-l3-size, 14px);
  font-weight: 400;
  line-height: 1.45;
  text-decoration: none;
}
.coach-care__l1:hover,
.coach-care__l2:hover,
.coach-care__l3:hover,
.coach-care__l1:focus-visible,
.coach-care__l2:focus-visible,
.coach-care__l3:focus-visible { color: var(--care-hover, #111); }
.coach-care__l3:hover,
.coach-care__l3:focus-visible {
  text-decoration: underline;
  text-underline-offset: 3px;
}
.coach-care.is-underline .coach-care__l1.is-active,
.coach-care.is-underline .coach-care__l2.is-active,
.coach-care.is-underline .coach-care__l3.is-active {
  color: var(--care-active, #111);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.coach-care__main {
  background: var(--care-main-bg, #ffffff);
  padding: var(--care-c-py, 48px) var(--care-c-px, 48px);
}
.coach-care__inner {
  width: 100%;
  max-width: var(--care-content, 760px);
}
.coach-care__page-title {
  margin: 0 0 20px;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.2;
}
.coach-care__rte { font-size: 14px; line-height: 1.6; }
.coach-care__rte > *:first-child { margin-top: 0; }
.coach-care__rte > *:last-child { margin-bottom: 0; }
.coach-care__rte p,
.coach-care__rte ul,
.coach-care__rte ol { margin: 0 0 14px; }
.coach-care__rte a { color: inherit; }
.coach-care__rte img,
.coach-care__rte video,
.coach-care__rte iframe,
.coach-care__image,
.coach-care__split img,
.coach-care__block video {
  display: block;
  max-width: 100%;
  height: auto;
}
.coach-care__rte iframe,
.coach-care__block iframe { width: 100%; max-width: 100%; aspect-ratio: 16 / 9; }
.coach-care__rte table { width: 100%; border-collapse: collapse; }
.coach-care__rte th,
.coach-care__rte td { padding: 8px 10px; border-bottom: 1px solid #e6e6e6; text-align: left; }
.coach-care__block,
.coach-care__rte,
.coach-care__split,
.coach-care__icon-row,
.coach-care__faq,
.coach-care__account { margin-top: 22px; }
.coach-care__main:has(.coach-care__account) .coach-care__inner,
.coach-care__main:has(.coach-care__size) .coach-care__inner { max-width: none; }
.coach-care__account,
.coach-care__account input,
.coach-care__account button,
.coach-care__account a {
  font-family: HelveticaLTPro-Roman, "Helvetica Neue", Helvetica, Arial, sans-serif;
}
.coach-care__account {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 0;
  align-items: start;
  width: 100%;
  color: var(--acc-text, #111);
  font-size: var(--acc-text-size, 13px);
  line-height: 1.45;
}
.coach-care__account-col:first-child { padding-right: 36px; }
.coach-care__account-col + .coach-care__account-col {
  position: relative;
  border-left: 0;
  margin-left: 0;
  padding-left: 36px;
}
.coach-care__account-col + .coach-care__account-col::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 1px;
  height: 50%;
  background: #d5d5d5;
}
.coach-care__account-title {
  margin: 0 0 14px;
  color: var(--acc-title, #111);
  font-family: HelveticaLTPro-Roman, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: var(--acc-title-size, 20px);
  font-weight: 700;
  line-height: 1.25;
}
.coach-care__account .coach-care__rte { font-size: inherit; color: inherit; }
.coach-care__track-copy { max-width: 320px; }
.coach-care__track-copy p { margin: 0; }
.coach-care__account-action { margin: 0; max-width: 320px; }
.coach-care__account-link {
  color: var(--acc-link, #111);
  text-decoration: underline;
  text-underline-offset: 2px;
}
.coach-care__fields--login { gap: 12px; margin-top: 16px; }
.coach-care__outline { position: relative; display: block; }
.coach-care__outline input {
  width: 100%;
  height: 40px;
  margin: 0;
  padding: 0 12px;
  border: 1px solid var(--acc-border, #c8c8c8);
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
  color: #111111;
  font-family: inherit;
  font-size: 14px;
  font-weight: 400;
  line-height: 40px;
  outline: none;
  appearance: none;
}
.coach-care__outline input::placeholder {
  color: transparent;
  opacity: 1;
}
.coach-care__outline input:focus,
.coach-care__outline input:focus-visible {
  border-color: #111111;
  outline: none !important;
  outline-offset: 0;
  box-shadow: none !important;
}
.coach-care__float {
  position: absolute;
  left: 12px;
  top: 20px;
  padding: 0 4px;
  margin-left: -4px;
  background: transparent;
  color: #8d8d8d;
  font-size: 14px;
  line-height: 1;
  pointer-events: none;
  transform: translateY(-50%);
  transition: top 0.16s ease, font-size 0.16s ease, color 0.16s ease;
}
.coach-care__outline.is-focus .coach-care__float,
.coach-care__outline.has-value .coach-care__float {
  top: 0;
  background: #ffffff;
  color: #4a4a4a;
  font-size: 12px;
}
.coach-care__pass input { padding-right: 64px; }
.coach-care__outline.is-invalid input,
.coach-care__outline.is-invalid input:focus,
.coach-care__outline.is-invalid input:focus-visible { border-color: var(--acc-error, #e10600); }
.coach-care__outline.is-invalid .coach-care__float { color: var(--acc-error, #e10600); }
.coach-care__outline--raise.is-invalid .coach-care__float {
  top: 0;
  background: #ffffff;
  font-size: 12px;
}
.coach-care__track-fields { gap: 12px; margin-top: 14px; }
.coach-care__track-note { margin: 2px 0 0; }
.coach-care__privacy {
  max-width: 280px;
  margin: 12px 0 0;
  color: #111111;
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.03em;
  line-height: 1.45;
  text-transform: uppercase;
}
.coach-care__privacy a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.coach-care__error {
  display: none;
  margin: 6px 0 0;
  color: var(--acc-error, #e10600);
  font-size: 14px;
  line-height: 1.3;
}
.coach-care__outline.is-invalid .coach-care__error { display: block; }
.coach-care__show {
  position: absolute;
  top: 20px;
  right: 12px;
  transform: translateY(-50%);
  border: 0;
  background: transparent;
  padding: 0;
  color: #8d8d8d;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  line-height: 1;
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
  box-shadow: none;
}
.coach-care__show:focus,
.coach-care__show:focus-visible {
  outline: none;
  box-shadow: none;
}
.coach-care__login-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 2px;
  font-size: 13px;
  line-height: 1;
}
.coach-care__remember {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 400;
  line-height: 1;
  cursor: pointer;
}
.coach-care__remember input {
  position: absolute;
  width: 16px;
  height: 16px;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}
.coach-care__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  flex: none;
  border: 1px solid #111111;
  background: #ffffff;
  box-shadow: none;
}
.coach-care__box svg {
  width: 12px;
  height: 12px;
  overflow: visible;
}
.coach-care__box path {
  fill: none;
  stroke: #111111;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 16;
  stroke-dashoffset: 16;
}
.coach-care__remember input:checked + .coach-care__box {
  animation: coach-care-tick 0.28s ease;
}
.coach-care__remember input:checked + .coach-care__box path {
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 0.22s ease 0.04s;
}
.coach-care__remember input:focus-visible + .coach-care__box {
  outline: 1px solid #111111;
