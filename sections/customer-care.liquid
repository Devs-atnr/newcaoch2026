{% javascript %}
if (!customElements.get('coach-care-login')) {
  customElements.define('coach-care-login', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      const button = this.querySelector('[data-care-show]');
      const input = this.querySelector('[data-care-password]');
      if (button && input) {
        button.addEventListener('click', () => {
          const shown = input.type === 'text';
          input.type = shown ? 'password' : 'text';
          button.textContent = shown ? button.dataset.show : button.dataset.hide;
        });
      }
      this.querySelectorAll('[data-care-input]').forEach((field) => {
        const box = field.closest('.coach-care__outline');
        const sync = () => box.classList.toggle('has-value', field.value.trim() !== '');
        field.addEventListener('input', () => {
          sync();
          if (field.value.trim() !== '' && (field.type !== 'email' || field.checkValidity())) box.classList.remove('is-invalid');
        });
        field.addEventListener('focus', () => box.classList.add('is-focus'));
        field.addEventListener('blur', () => box.classList.remove('is-focus'));
        sync();
      });
      this.querySelectorAll('form').forEach((form) => {
        form.addEventListener('submit', (event) => {
          let first = null;
          form.querySelectorAll('[data-care-input]').forEach((field) => {
            const box = field.closest('.coach-care__outline');
            const value = field.value.trim();
            const missing = field.hasAttribute('data-care-required') && value === '';
            const badEmail = field.hasAttribute('data-care-email') && value !== '' && !field.checkValidity();
            const digits = value.replace(/\D/g, '');
            const badContact = field.hasAttribute('data-care-contact') && value !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) && !/^0?5\d{8}$/.test(digits) && !/^9665\d{8}$/.test(digits);
            const invalid = missing || badEmail || badContact;
            box.classList.toggle('is-invalid', invalid);
            if (invalid && !first) first = field;
          });
          if (!first) return;
          event.preventDefault();
        });
      });
    }
  });
}
if (!customElements.get('coach-care-email')) {
  customElements.define('coach-care-email', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      const source = this.querySelector('[data-email-source]');
      const error = this.querySelector('[data-email-error]');
      this.querySelectorAll('form').forEach((form) => {
        form.addEventListener('submit', (event) => {
          const value = source ? source.value.trim() : '';
          const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
          if (source) source.classList.toggle('is-invalid', !valid);
          if (error) error.hidden = valid;
          if (!valid) {
            event.preventDefault();
            if (source) source.focus();
            return;
          }
          const target = form.querySelector('[data-email-target]');
          if (target) target.value = value;
        });
      });
    }
  });
}
if (!customElements.get('coach-care-desk')) {
  customElements.define('coach-care-desk', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      const form = this.querySelector('form');
      if (!form) return;
      const select = form.querySelector('select');
      if (select) select.addEventListener('change', () => select.classList.toggle('has-value', select.value !== ''));
      form.addEventListener('submit', (event) => {
        let invalid = false;
        form.querySelectorAll('[required]').forEach((field) => {
          const bad = !field.checkValidity();
          field.classList.toggle('is-invalid', bad);
          if (bad) invalid = true;
        });
        const email = form.querySelector('[data-desk-email]');
        const confirm = form.querySelector('[data-desk-confirm]');
        const mismatch = email && confirm && email.value.trim().toLowerCase() !== confirm.value.trim().toLowerCase();
        if (confirm) confirm.classList.toggle('is-invalid', mismatch || !confirm.checkValidity());
        const message = form.querySelector('[data-desk-match]');
        if (message) message.hidden = !mismatch;
        if (invalid || mismatch) event.preventDefault();
      });
    }
  });
}
if (!customElements.get('coach-care-size')) {
  customElements.define('coach-care-size', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      const source = this.querySelector('[data-size-charts]');
      let charts = [];
      try { charts = JSON.parse(source ? source.textContent : '[]'); } catch (error) { charts = []; }
      this.charts = charts.filter((chart) => chart && chart.group && chart.category);
      this.groupSelect = this.querySelector('[data-size-group]');
      this.categorySelect = this.querySelector('[data-size-category]');
      this.result = this.querySelector('[data-size-result]');
      this.regions = {};
      const groups = [...new Set(this.charts.map((chart) => chart.group))];
      groups.forEach((group) => {
        const option = document.createElement('option');
        option.value = group;
        option.textContent = group;
        this.groupSelect.appendChild(option);
      });
      this.groupSelect.addEventListener('change', () => {
        this.fillCategories();
        this.render();
      });
      this.categorySelect.addEventListener('change', () => this.render());
      const button = this.querySelector('[data-size-view]');
      if (button) button.addEventListener('click', () => this.render());
      this.fillCategories();
      this.render();
    }
    fillCategories() {
      const categories = [...new Set(this.charts.filter((chart) => chart.group === this.groupSelect.value).map((chart) => chart.category))];
      const current = this.categorySelect.value;
      this.categorySelect.innerHTML = '';
      categories.forEach((category) => {
        const option = document.createElement('option');
        option.value = category;
        option.textContent = category;
        this.categorySelect.appendChild(option);
      });
      if (categories.includes(current)) this.categorySelect.value = current;
    }
    render() {
      const charts = this.charts.filter((item) => item.group === this.groupSelect.value && item.category === this.categorySelect.value);
      if (!charts.length) {
        this.result.innerHTML = '';
        return;
      }
      const esc = (value) => String(value == null ? '' : value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
      const icon = '<svg class="coach-care__size-icon" viewBox="0 0 80 110" aria-hidden="true"><path d="M28 48 V18 M34 44 V10 M40 44 V8 M46 46 V14 M52 50 V24" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round"/><path d="M24 52c0 18 2 34 8 46h22c6-10 8-24 8-40 0-8-4-14-8-16-2 6-4 8-6 8s-4-2-6-8c-2 6-4 8-6 8s-4-4-6-10c-4 4-6 8-6 12z" fill="none" stroke="#111" stroke-width="1.4"/></svg>';
      this.result.innerHTML = charts.map((chart, chartIndex) => {
        const headers = chart.headers || [];
        const rows = chart.rows || [];
        const regionAt = Number(chart.region) || 0;
        const splitAt = regionAt > 0 ? Math.max(Math.min(regionAt - 1, headers.length), 0) : headers.length;
        const fixed = headers.slice(0, splitAt);
        const regions = regionAt > 0 ? headers.slice(splitAt) : [];
        const key = `${chart.group}|${chart.category}|${chartIndex}`;
        let regionIndex = this.regions[key] || 0;
        if (regionIndex >= regions.length) regionIndex = 0;
        const head = fixed.map((cell) => `<th>${esc(cell)}</th>`).join('');
        const regionHead = regions.length
          ? `<th><select class="coach-care__region" data-size-region>${regions.map((cell, index) => `<option value="${index}"${index === regionIndex ? ' selected' : ''}>${esc(cell)}</option>`).join('')}</select></th>`
          : '';
        const body = rows.map((row) => {
          const base = fixed.map((_, index) => `<td>${esc(row[index] || '')}</td>`).join('');
          const region = regions.length ? `<td>${esc(row[splitAt + regionIndex] || '')}</td>` : '';
          return `<tr>${base}${region}</tr>`;
        }).join('');
        const title = chart.title || chart.category;
        const noteHeading = chart.noteHeading ? `<p class="coach-care__size-note-title">${esc(chart.noteHeading)}</p>` : '';
        const note = chart.note ? `<p class="coach-care__size-note">${esc(chart.note)}</p>` : '';
        const imageStyle = `width:${Number(chart.imageWidth) || 120}px;${Number(chart.imageHeight) > 0 ? `height:${Number(chart.imageHeight)}px;object-fit:contain;` : ''}`;
        const image = chart.image ? `<img class="coach-care__size-image" style="${imageStyle}" src="${esc(chart.image)}" alt="">` : (chart.icon ? icon : '');
        const table = chart.html
          ? `<div class="coach-care__size-html">${chart.html}</div>`
          : `<table class="coach-care__size-table"><thead><tr>${head}${regionHead}</tr></thead><tbody>${body}</tbody></table>`;
        return `<div class="coach-care__size-chart" data-chart-key="${esc(key)}"><h3 class="coach-care__size-name">${esc(title)}</h3>${table}${noteHeading}${note}${image}</div>`;
      }).join('');
      this.result.querySelectorAll('[data-size-region]').forEach((select) => {
        select.addEventListener('change', () => {
          const key = select.closest('[data-chart-key]').getAttribute('data-chart-key');
          this.regions[key] = Number(select.value) || 0;
          this.render();
        });
      });
    }
  });
}
if (!customElements.get('coach-care-nav')) {
  customElements.define('coach-care-nav', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      const toggle = this.querySelector('[data-care-toggle]');
      const panel = this.querySelector('[data-care-panel]');
      if (!toggle || !panel) return;
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        panel.hidden = open;
      });
    }
  });
}
