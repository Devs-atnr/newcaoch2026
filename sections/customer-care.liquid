{%- liquid
  assign side_heading = section.settings.heading | default: 'Customer Care'
  assign menu = section.settings.menu
-%}

<div
  id="CoachCare-{{ section.id }}"
  class="coach-care{% if section.settings.full_width %} is-full{% endif %}{% if section.settings.sticky_sidebar %} is-sticky{% endif %}"
  style="
    --care-side: {{ section.settings.sidebar_width | default: 33 }}%;
    --care-side-bg: {{ section.settings.sidebar_background | default: '#f5f5f5' }};
    --care-main-bg: {{ section.settings.content_background | default: '#ffffff' }};
    --care-heading-size: {{ section.settings.heading_size | default: 16 }}px;
    --care-title-size: {{ section.settings.title_size | default: 28 }}px;
    --care-title-color: {{ section.settings.heading_color | default: '#111111' }};
    --care-cat-size: {{ section.settings.category_size | default: 13 }}px;
    --care-cat-weight: {{ section.settings.category_weight | default: '700' }};
    --care-link-size: {{ section.settings.link_size | default: 14 }}px;
    --care-link: {{ section.settings.link_color | default: '#111111' }};
    --care-active: {{ section.settings.active_color | default: '#111111' }};
    --care-hover: {{ section.settings.hover_color | default: '#111111' }};
    --care-text: {{ section.settings.content_color | default: '#111111' }};
    --care-content: {{ section.settings.content_max | default: 760 }}px;
    --care-page: {{ section.settings.page_width | default: 1440 }}px;
    --care-s-pt: {{ section.settings.sidebar_padding_top | default: 48 }}px;
    --care-s-pr: {{ section.settings.sidebar_padding_right | default: 32 }}px;
    --care-s-pb: {{ section.settings.sidebar_padding_bottom | default: 48 }}px;
    --care-s-pl: {{ section.settings.sidebar_padding_left | default: 36 }}px;
    --care-c-pt: {{ section.settings.content_padding_top | default: 48 }}px;
    --care-c-pr: {{ section.settings.content_padding_right | default: 48 }}px;
    --care-c-pb: {{ section.settings.content_padding_bottom | default: 64 }}px;
    --care-c-pl: {{ section.settings.content_padding_left | default: 56 }}px;
    --care-cat-space: {{ section.settings.category_space | default: 28 }}px;
    --care-link-space: {{ section.settings.link_space | default: 12 }}px;
    --care-gap: {{ section.settings.column_gap | default: 0 }}px;
    --care-sec-pt: {{ section.settings.padding_top | default: 0 }}px;
    --care-sec-pb: {{ section.settings.padding_bottom | default: 0 }}px;
    --care-sticky: {{ section.settings.sticky_top | default: 24 }}px;
    --care-title-space: {{ section.settings.title_space | default: 24 }}px;
    --care-body-size: {{ section.settings.content_size | default: 14 }}px;
    --care-m-pad: {{ section.settings.mobile_padding | default: 16 }}px;
    --care-m-space: {{ section.settings.mobile_spacing | default: 16 }}px;
  "
>
  <div class="coach-care__frame">
    <coach-care-nav class="coach-care__side">
      <button
        type="button"
        class="coach-care__toggle"
        data-care-toggle
        aria-expanded="false"
        aria-controls="CoachCarePanel-{{ section.id }}"
      >
        <span>{{ side_heading | escape }}</span>
        <svg class="coach-care__chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="coach-care__panel" id="CoachCarePanel-{{ section.id }}" data-care-panel hidden>
        {%- if side_heading != blank -%}
          <p class="coach-care__heading">{{ side_heading | escape }}</p>
        {%- endif -%}
        {%- if menu != blank and menu.links.size > 0 -%}
          <nav class="coach-care__nav" aria-label="{{ side_heading | escape }}">
            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                <div class="coach-care__group">
                  <p class="coach-care__category">{{ link.title | escape }}</p>
                  <ul class="coach-care__links">
                    {%- for child in link.links -%}
                      <li>
                        <a
                          class="coach-care__link{% if child.current or child.active %} is-active{% endif %}"
                          href="{{ child.url }}"
                          {% if child.current or child.active %}aria-current="page"{% endif %}
                        >{{ child.title | escape }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="coach-care__sublinks">
                            {%- for grand in child.links -%}
                              <li>
                                <a
                                  class="coach-care__link{% if grand.current or grand.active %} is-active{% endif %}"
                                  href="{{ grand.url }}"
                                  {% if grand.current or grand.active %}aria-current="page"{% endif %}
                                >{{ grand.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- else -%}
                <div class="coach-care__group">
                  <a
                    class="coach-care__link coach-care__link--top{% if link.current or link.active %} is-active{% endif %}"
                    href="{{ link.url }}"
                    {% if link.current or link.active %}aria-current="page"{% endif %}
                  >{{ link.title | escape }}</a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- elsif request.design_mode -%}
          <p class="coach-care__empty">Select a navigation menu in this section’s settings. Parent items become headings. Child items become links.</p>
        {%- endif -%}
      </div>
    </coach-care-nav>

    <div class="coach-care__main">
      <div class="coach-care__inner">
        {%- if section.settings.show_title and page.title != blank -%}
          <h1 class="coach-care__title">{{ page.title | escape }}</h1>
        {%- endif -%}

        {%- if page.content != blank -%}
          <div class="coach-care__rte rte">{{ page.content }}</div>
        {%- endif -%}

        {%- if page.metafields.custom.care_content != blank -%}
          <div class="coach-care__rte rte">{{ page.metafields.custom.care_content | metafield_tag }}</div>
        {%- endif -%}

        {%- assign care_contact_used = false -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign show_block = true
            if block.settings.page_handles != blank
              assign show_block = false
              assign handle_list = block.settings.page_handles | split: ','
              for handle_item in handle_list
                assign handle_clean = handle_item | strip | downcase
                if handle_clean == page.handle
                  assign show_block = true
                endif
              endfor
            endif
          -%}
          {%- if show_block -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="coach-care__block-heading" {{ block.shopify_attributes }} style="font-size: {{ block.settings.size }}px;">{{ block.settings.heading | escape }}</h2>
              {%- when 'richtext' -%}
                <div class="coach-care__rte rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- when 'image' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.alt, loading: 'lazy', class: 'coach-care__image' }}
                  {%- endif -%}
                </div>
              {%- when 'image_text' -%}
                <div class="coach-care__split{% if block.settings.image_position == 'right' %} is-reverse{% endif %}" {{ block.shopify_attributes }}>
                  <div class="coach-care__split-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.alt, loading: 'lazy' }}
                    {%- endif -%}
                  </div>
                  <div class="coach-care__rte rte">{{ block.settings.text }}</div>
                </div>
              {%- when 'icon_text' -%}
                <div class="coach-care__icon-row" {{ block.shopify_attributes }}>
                  <span class="coach-care__icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'email' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg>
                      {%- when 'box' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3.5 8 12 4l8.5 4L12 12 3.5 8Z"></path><path d="M3.5 8v8L12 20l8.5-4V8"></path><path d="M12 12v8"></path></svg>
                      {%- when 'return' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 8H5.5A3.5 3.5 0 0 0 5.5 15H19"></path><path d="M8 5.5 5.5 8 8 10.5"></path></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 16.5c-1.8-1.2-3-2.9-3-5A6.5 6.5 0 0 1 14.2 6"></path><path d="M8 19.5 7 16.5l3 .2"></path><path d="M17 7.5c1.8 1.2 3 2.9 3 5A6.5 6.5 0 0 1 9.8 18"></path><path d="M16 4.5 17 7.5l-3-.2"></path></svg>
                    {%- endcase -%}
                  </span>
                  <div>
                    {%- if block.settings.heading != blank -%}
                      <h3 class="coach-care__block-heading">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="coach-care__rte rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'button' -%}
                {%- if block.settings.label != blank -%}
                  <p class="coach-care__block" {{ block.shopify_attributes }}>
                    <a class="coach-care__button" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
                  </p>
                {%- endif -%}
              {%- when 'faq' -%}
                <details class="coach-care__faq" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.question | escape }}</summary>
                  <div class="coach-care__rte rte">{{ block.settings.answer }}</div>
                </details>
              {%- when 'contact_form' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>
                  {%- if care_contact_used -%}
                    {%- if request.design_mode -%}
                      <p class="coach-care__empty">Only one contact form can be used on a page.</p>
                    {%- endif -%}
                  {%- else -%}
                    {%- assign care_contact_used = true -%}
                    {%- assign care_form_id = 'CareContact-' | append: section.id -%}
                    {%- form 'contact', id: care_form_id -%}
                      {%- if form.posted_successfully? -%}
                        <p class="coach-care__status" tabindex="-1" autofocus>Thanks. Your message has been sent.</p>
                      {%- elsif form.errors -%}
                        <p class="coach-care__status" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                      {%- endif -%}
                      <div class="coach-care__fields">
                        <label class="coach-care__field">
                          <span>Name</span>
                          <input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
                        </label>
                        <label class="coach-care__field">
                          <span>Email</span>
                          <input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
                        </label>
                        <label class="coach-care__field">
                          <span>Message</span>
                          <textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea>
                        </label>
                        <button class="coach-care__button" type="submit">{{ block.settings.label | default: 'Send' | escape }}</button>
                      </div>
                    {%- endform -%}
                  {%- endif -%}
                </div>
              {%- when 'email_info' -%}
                <div class="coach-care__icon-row" {{ block.shopify_attributes }}>
                  <span class="coach-care__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg>
                  </span>
                  <div>
                    {%- if block.settings.heading != blank -%}
                      <h3 class="coach-care__block-heading">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="coach-care__rte rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.email != blank -%}
                      <a class="coach-care__link is-active" href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'live_chat' -%}
                <div class="coach-care__icon-row" {{ block.shopify_attributes }}>
                  <span class="coach-care__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 16.5c-1.8-1.2-3-2.9-3-5A6.5 6.5 0 0 1 14.2 6"></path><path d="M8 19.5 7 16.5l3 .2"></path><path d="M17 7.5c1.8 1.2 3 2.9 3 5A6.5 6.5 0 0 1 9.8 18"></path><path d="M16 4.5 17 7.5l-3-.2"></path></svg>
                  </span>
                  <div>
                    {%- if block.settings.heading != blank -%}
                      <h3 class="coach-care__block-heading">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="coach-care__rte rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.label != blank -%}
                      <a class="coach-care__chat" href="{{ block.settings.link | default: '#' }}" {% if block.settings.button_id != blank %}id="{{ block.settings.button_id | escape }}"{% endif %}>{{ block.settings.label | escape }}</a>
                    {%- endif -%}
                  </div>
                </div>
              {%- when 'custom_liquid' -%}
                <div class="coach-care__block" {{ block.shopify_attributes }}>{{ block.settings.code }}</div>
              {%- when 'divider' -%}
                <hr class="coach-care__divider" {{ block.shopify_attributes }}>
              {%- when 'spacer' -%}
                <div class="coach-care__spacer" style="--care-spacer: {{ block.settings.height }}px; --care-spacer-m: {{ block.settings.height_mobile }}px;" {{ block.shopify_attributes }}></div>
            {%- endcase -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.coach-care {
  box-sizing: border-box;
  padding: var(--care-sec-pt, 0px) 0 var(--care-sec-pb, 0px);
  background: #ffffff;
  color: var(--care-text, #111111);
  font-family: HelveticaLTPro-Roman, Helvetica, Arial, sans-serif;
}
.coach-care *,
.coach-care *::before,
.coach-care *::after { box-sizing: border-box; }
.coach-care__frame {
  display: grid;
  grid-template-columns: minmax(220px, var(--care-side, 33%)) minmax(0, 1fr);
  gap: var(--care-gap, 0px);
  align-items: stretch;
  width: 100%;
}
.coach-care:not(.is-full) .coach-care__frame {
  max-width: var(--care-page, 1440px);
  margin: 0 auto;
}
.coach-care__side {
  min-width: 0;
  background: var(--care-side-bg, #f5f5f5);
  padding: var(--care-s-pt, 48px) var(--care-s-pr, 32px) var(--care-s-pb, 48px) var(--care-s-pl, 36px);
}
.coach-care.is-sticky .coach-care__panel {
  position: sticky;
  top: var(--care-sticky, 24px);
}
.coach-care__toggle {
  display: none;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--care-title-color, #111);
  font: inherit;
  font-size: var(--care-heading-size, 16px);
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}
.coach-care__chevron {
  width: 18px;
  height: 18px;
  flex: none;
  transition: transform 0.2s ease;
}
.coach-care__toggle[aria-expanded="true"] .coach-care__chevron { transform: rotate(180deg); }
.coach-care__heading {
  margin: 0 0 28px;
  font-size: var(--care-heading-size, 16px);
  font-weight: 700;
  line-height: 1.3;
  color: var(--care-title-color, #111);
}
.coach-care__group + .coach-care__group { margin-top: var(--care-cat-space, 28px); }
.coach-care__category {
  margin: 0 0 12px;
  font-size: var(--care-cat-size, 13px);
  font-weight: var(--care-cat-weight, 700);
  letter-spacing: 0.04em;
  line-height: 1.3;
  text-transform: uppercase;
  color: var(--care-title-color, #111);
}
.coach-care__links,
.coach-care__sublinks {
  margin: 0;
  padding: 0;
  list-style: none;
}
.coach-care__links > li + li { margin-top: var(--care-link-space, 12px); }
.coach-care__sublinks { margin-top: 8px; padding-left: 12px; }
.coach-care__link {
  color: var(--care-link, #111);
  font-size: var(--care-link-size, 14px);
  font-weight: 400;
  line-height: 1.45;
  text-decoration: none;
}
.coach-care__link:hover,
.coach-care__link:focus-visible { color: var(--care-hover, #111); }
.coach-care__link.is-active {
  color: var(--care-active, #111);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.coach-care__link--top {
  font-size: var(--care-cat-size, 13px);
  font-weight: var(--care-cat-weight, 700);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.coach-care__empty { margin: 0; font-size: 14px; line-height: 1.5; }
.coach-care__main {
  min-width: 0;
  background: var(--care-main-bg, #ffffff);
  padding: var(--care-c-pt, 48px) var(--care-c-pr, 48px) var(--care-c-pb, 64px) var(--care-c-pl, 56px);
}
.coach-care__inner {
  width: 100%;
  max-width: var(--care-content, 760px);
}
.coach-care__title {
  margin: 0 0 var(--care-title-space, 24px);
  font-size: var(--care-title-size, 28px);
  font-weight: 700;
  line-height: 1.2;
  color: var(--care-title-color, #111);
}
.coach-care__rte {
  color: var(--care-text, #111);
  font-size: var(--care-body-size, 14px);
  line-height: 1.6;
}
.coach-care__rte > *:first-child { margin-top: 0; }
.coach-care__rte > *:last-child { margin-bottom: 0; }
.coach-care__rte p,
.coach-care__rte ul,
.coach-care__rte ol { margin: 0 0 14px; }
.coach-care__rte a { color: inherit; }
.coach-care__rte img,
.coach-care__rte video,
.coach-care__rte iframe,
.coach-care__image,
.coach-care__split img {
  display: block;
  max-width: 100%;
  height: auto;
}
.coach-care__rte iframe { width: 100%; aspect-ratio: 16 / 9; }
.coach-care__rte table { width: 100%; border-collapse: collapse; }
.coach-care__rte th,
.coach-care__rte td { padding: 8px 10px; border-bottom: 1px solid #e6e6e6; text-align: left; }
.coach-care__block { margin-top: 22px; }
.coach-care__block-heading {
  margin: 22px 0 8px;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--care-title-color, #111);
}
.coach-care__split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 24px;
  align-items: center;
  margin-top: 22px;
}
.coach-care__split.is-reverse .coach-care__split-media { order: 2; }
.coach-care__icon-row {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  gap: 14px;
  margin-top: 22px;
}
.coach-care__icon svg { display: block; width: 24px; height: 24px; }
.coach-care__button,
.coach-care__chat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 8px;
  padding: 10px 22px;
  border: 1px solid #111111;
  background: #111111;
  color: #ffffff;
  font: inherit;
  font-size: 14px;
  line-height: 1;
  text-decoration: none;
  cursor: pointer;
}
.coach-care__chat { background: transparent; color: #111111; }
.coach-care__fields { display: grid; gap: 14px; margin-top: 8px; }
.coach-care__field { display: grid; gap: 6px; font-size: 13px; }
.coach-care__field input,
.coach-care__field textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #d9d9d9;
  background: #ffffff;
  color: #111111;
  font: inherit;
  font-size: 14px;
}
.coach-care__status { margin: 0 0 12px; font-size: 14px; }
.coach-care__faq {
  margin-top: 12px;
  border-bottom: 1px solid #e6e6e6;
}
.coach-care__faq summary {
  padding: 14px 0;
  font-weight: 700;
  cursor: pointer;
}
.coach-care__faq .coach-care__rte { padding-bottom: 14px; }
.coach-care__divider {
  margin: 24px 0;
  border: 0;
  border-top: 1px solid #e6e6e6;
}
.coach-care__spacer { height: var(--care-spacer, 24px); }
@media screen and (max-width: 989px) {
  .coach-care__frame { grid-template-columns: minmax(0, 1fr); }
  .coach-care__side { padding: var(--care-m-pad, 16px); }
  .coach-care__main { padding: var(--care-m-space, 16px); }
  .coach-care__toggle { display: flex; }
  .coach-care__heading { display: none; }
  .coach-care__panel { padding-top: 18px; }
  .coach-care.is-sticky .coach-care__panel { position: static; }
  .coach-care__split { grid-template-columns: minmax(0, 1fr); }
  .coach-care__split.is-reverse .coach-care__split-media { order: 0; }
  .coach-care__spacer { height: var(--care-spacer-m, 16px); }
}
@media screen and (min-width: 990px) {
  .coach-care__panel[hidden] { display: block !important; }
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('coach-care-nav')) {
  customElements.define('coach-care-nav', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      const toggle = this.querySelector('[data-care-toggle]');
      const panel = this.querySelector('[data-care-panel]');
      if (!toggle || !panel) return;
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        panel.hidden = open;
      });
    }
  });
}
{% endjavascript %}

