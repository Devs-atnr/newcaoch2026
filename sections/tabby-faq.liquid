<div
  id="TabbyFaq-{{ section.id }}"
  class="tabby-faq tabby-faq--{{ section.settings.alignment }}"
  style="
    --tf-bg: {{ section.settings.background }};
    --tf-text: {{ section.settings.text_color }};
    --tf-heading: {{ section.settings.heading_color }};
    --tf-width: {{ section.settings.content_width }}px;
    --tf-pt: {{ section.settings.padding_top }}px;
    --tf-pb: {{ section.settings.padding_bottom }}px;
    --tf-heading-size: {{ section.settings.heading_size }}px;
    --tf-q: {{ section.settings.question_size }}px;
    --tf-a: {{ section.settings.answer_size }}px;
  "
>
  <div class="tabby-faq__wrap">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <details class="tabby-faq__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="tabby-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
    {%- if section.settings.help_label != blank -%}
      <p class="tabby-faq__help">
        {{ section.settings.help_before | escape }}
        <a href="{{ section.settings.help_link }}" target="_blank" rel="noopener">{{ section.settings.help_label | escape }}</a>
        {{ section.settings.help_after | escape }}
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap");
.tabby-faq { background: var(--tf-bg, #fff); color: var(--tf-text, #292929); font-family: Inter, Helvetica, Arial, sans-serif; }
.tabby-faq__wrap { width: min(100% - 32px, var(--tf-width, 1100px)); margin: 0 auto; padding: var(--tf-pt, 24px) 0 var(--tf-pb, 32px); }
.tabby-faq h2 { margin: 0 0 16px; color: var(--tf-heading, #292929); font-family: Inter, Helvetica, Arial, sans-serif !important; font-size: var(--tf-heading-size, 32px) !important; font-weight: 400 !important; line-height: 46px !important; }
.tabby-faq__item { border-bottom: 1px solid #e6e5e9; padding: 18px 0; }
.tabby-faq__item summary { position: relative; display: flex; align-items: center; padding: 4px 32px 4px 0; cursor: pointer; list-style: none; font-family: Inter, Helvetica, Arial, sans-serif !important; font-size: var(--tf-q, 18px) !important; font-weight: 600 !important; line-height: 1.6 !important; color: var(--tf-heading, #292929); }
.tabby-faq__item summary::-webkit-details-marker { display: none; }
.tabby-faq__item summary::marker { content: ""; }
.tabby-faq__item summary::after { content: "+"; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 28px; font-weight: 400; }
.tabby-faq__item[open] summary::after { content: "−"; }
.tabby-faq__answer { padding: 14px 32px 4px 0; }
.tabby-faq__answer, .tabby-faq__answer p, .tabby-faq__answer li { color: var(--tf-text, #292929); font-size: var(--tf-a, 16px) !important; font-weight: 400 !important; line-height: 1.75 !important; }
.tabby-faq__answer p { margin: 0 0 12px; }
.tabby-faq__answer ul { margin: 0 0 12px; padding-left: 22px; list-style: disc; }
.tabby-faq__help { margin: 20px 0 0; font-size: 24px !important; line-height: 32px !important; }
.tabby-faq__help a { color: inherit; text-decoration: underline; }
.tabby-faq--center { text-align: center; }
.tabby-faq--center .tabby-faq__item summary { justify-content: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ accordion",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 56, "step": 2, "unit": "px", "label": "Heading size", "default": 32 },
    { "type": "range", "id": "question_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Question size", "default": 18 },
    { "type": "range", "id": "answer_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Answer size", "default": 16 },
    { "type": "text", "id": "help_before", "label": "Help text before link", "default": "Visit" },
    { "type": "text", "id": "help_label", "label": "Help link label", "default": "tabby's help center" },
    { "type": "text", "id": "help_after", "label": "Help text after link", "default": "to find out more." },
    { "type": "url", "id": "help_link", "label": "Help link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#292929" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#292929" },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "range", "id": "content_width", "min": 720, "max": 1400, "step": 20, "unit": "px", "label": "Content width", "default": 1100 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top spacing", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 32 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ accordion" }
  ]
}
{% endschema %}
