<div
  class="coach-faqs"
  style="
    --faq-width: {{ section.settings.content_width }}px;
    --faq-pad-x: {{ section.settings.side_padding }}px;
    --faq-pad-top: {{ section.settings.padding_top }}px;
    --faq-pad-bottom: {{ section.settings.padding_bottom }}px;
    --faq-title: {{ section.settings.heading_size }}px;
    --faq-group: {{ section.settings.group_size }}px;
    --faq-question: {{ section.settings.question_size }}px;
    --faq-plus: {{ section.settings.plus_color }};
    --faq-line: {{ section.settings.line_color }};
  "
>
  <div class="coach-faqs__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="coach-faqs__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'group' -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="coach-faqs__group" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
        {%- when 'question' -%}
          {%- if block.settings.question != blank -%}
            <details class="coach-faqs__item" {{ block.shopify_attributes }}>
              <summary>
                <span class="coach-faqs__question">{{ block.settings.question | escape }}</span>
                <span class="coach-faqs__chevron" aria-hidden="true"></span>
              </summary>
              {%- if block.settings.answer != blank -%}
                <div class="coach-faqs__answer rte">{{ block.settings.answer }}</div>
              {%- endif -%}
            </details>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.coach-faqs {
  box-sizing: border-box;
  padding: var(--faq-pad-top, 36px) var(--faq-pad-x, 20px) var(--faq-pad-bottom, 48px);
  background: #ffffff;
  color: #111111;
  font-family: HelveticaLTPro-Roman, Helvetica, Arial, sans-serif;
}
.coach-faqs *,
.coach-faqs *::before,
.coach-faqs *::after { box-sizing: border-box; }
.coach-faqs__inner {
  width: min(100%, var(--faq-width, 820px));
  margin: 0 auto;
}
.coach-faqs__title {
  margin: 0 0 46px;
  font-size: var(--faq-title, 22px);
  font-weight: 700;
  line-height: 1.2;
  color: #111111;
}
.coach-faqs__group {
  margin: 36px 0 8px;
  font-size: var(--faq-group, 16px);
  font-weight: 700;
  line-height: 1.3;
  color: #111111;
}
.coach-faqs__title + .coach-faqs__group { margin-top: 0; }
.coach-faqs__item {
  border-bottom: 1px solid var(--faq-line, #e6e6e6);
}
.coach-faqs__item summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 2px;
  cursor: pointer;
  list-style: none;
}
.coach-faqs__item summary::-webkit-details-marker { display: none; }
.coach-faqs__item summary::marker { content: ""; }
.coach-faqs__question {
  font-size: var(--faq-question, 13px);
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #111111;
}
.coach-faqs__chevron {
  flex: none;
  width: 8px;
  height: 8px;
  margin-right: 6px;
  border-right: 1.5px solid var(--faq-plus, #111111);
  border-bottom: 1.5px solid var(--faq-plus, #111111);
  transform: rotate(45deg) translateY(-2px);
}
.coach-faqs__item[open] .coach-faqs__chevron {
  transform: rotate(225deg) translateY(-2px);
}
.coach-faqs__answer {
  padding: 0 28px 18px 0;
  font-size: 14px;
  line-height: 1.55;
  color: #333333;
}
.coach-faqs__answer > *:first-child { margin-top: 0; }
.coach-faqs__answer > *:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "coach-faqs-section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "range", "id": "heading_size", "min": 18, "max": 40, "step": 1, "unit": "px", "label": "Heading size", "default": 22 },
    { "type": "range", "id": "group_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Group size", "default": 16 },
    { "type": "range", "id": "question_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Question size", "default": 13 },
    { "type": "color", "id": "plus_color", "label": "Chevron color", "default": "#111111" },
    { "type": "color", "id": "line_color", "label": "Line color", "default": "#E6E6E6" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_width", "min": 480, "max": 1200, "step": 20, "unit": "px", "label": "Content width", "default": 1000 },
    { "type": "range", "id": "side_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Side padding", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Space above", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Space below", "default": 48 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "General / My Account:" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How can I contact Coach.sa?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        { "type": "question", "settings": { "question": "Payment" } },
        { "type": "question", "settings": { "question": "Clearpay" } },
        { "type": "question", "settings": { "question": "Shop Pay" } },
        { "type": "question", "settings": { "question": "My Account" } },
        { "type": "question", "settings": { "question": "Returns" } },
        { "type": "question", "settings": { "question": "Exchanges" } },
        { "type": "question", "settings": { "question": "Delivery" } },
        { "type": "question", "settings": { "question": "Placing an order" } },
        { "type": "question", "settings": { "question": "Warranties" } },
        { "type": "question", "settings": { "question": "Products & availability" } },
        { "type": "question", "settings": { "question": "Others" } },
        { "type": "question", "settings": { "question": "About us" } }
      ]
    }
  ]
}
{% endschema %}
