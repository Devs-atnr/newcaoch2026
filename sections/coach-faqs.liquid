<div
  class="coach-faqs"
  style="
    --faq-width: {{ section.settings.content_width }}px;
    --faq-pad-x: {{ section.settings.side_padding }}px;
    --faq-pad-top: {{ section.settings.padding_top }}px;
    --faq-pad-bottom: {{ section.settings.padding_bottom }}px;
    --faq-title: {{ section.settings.heading_size }}px;
    --faq-group: {{ section.settings.group_size }}px;
    --faq-question: {{ section.settings.question_size }}px;
    --faq-plus: {{ section.settings.plus_color }};
    --faq-line: {{ section.settings.line_color }};
  "
>
  <div class="coach-faqs__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="coach-faqs__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'group' -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="coach-faqs__group" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
        {%- when 'question' -%}
          {%- if block.settings.question != blank -%}
            <details class="coach-faqs__item" {{ block.shopify_attributes }}>
              <summary>
                <span class="coach-faqs__question">{{ block.settings.question | escape }}</span>
                <span class="coach-faqs__plus" aria-hidden="true"></span>
              </summary>
              {%- if block.settings.answer != blank -%}
                <div class="coach-faqs__answer rte">{{ block.settings.answer }}</div>
              {%- endif -%}
            </details>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.coach-faqs {
  box-sizing: border-box;
  padding: var(--faq-pad-top, 36px) var(--faq-pad-x, 20px) var(--faq-pad-bottom, 48px);
  background: #ffffff;
  color: #111111;
  font-family: HelveticaLTPro-Roman, Helvetica, Arial, sans-serif;
}
.coach-faqs *,
.coach-faqs *::before,
.coach-faqs *::after { box-sizing: border-box; }
.coach-faqs__inner {
  width: min(100%, var(--faq-width, 820px));
  margin: 0 auto;
}
.coach-faqs__title {
  margin: 0 0 34px;
  font-size: var(--faq-title, 24px);
  font-weight: 700;
  line-height: 1.2;
  color: #111111;
}
.coach-faqs__group {
  margin: 34px 0 6px;
  font-size: var(--faq-group, 16px);
  font-weight: 700;
  line-height: 1.3;
  color: #111111;
}
.coach-faqs__title + .coach-faqs__group { margin-top: 0; }
.coach-faqs__item {
  border-bottom: 1px solid var(--faq-line, #e4e4e4);
}
.coach-faqs__item summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 16px 0;
  cursor: pointer;
  list-style: none;
}
.coach-faqs__item summary::-webkit-details-marker { display: none; }
.coach-faqs__item summary::marker { content: ""; }
.coach-faqs__question {
  font-size: var(--faq-question, 14px);
  font-weight: 400;
  line-height: 1.45;
  color: #333333;
}
.coach-faqs__plus {
  position: relative;
  flex: none;
  width: 14px;
  height: 14px;
  color: var(--faq-plus, #65559d);
}
.coach-faqs__plus::before,
.coach-faqs__plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}
.coach-faqs__plus::before { width: 12px; height: 1.5px; }
.coach-faqs__plus::after { width: 1.5px; height: 12px; }
.coach-faqs__item[open] .coach-faqs__plus::after { display: none; }
.coach-faqs__answer {
  padding: 0 32px 16px 0;
  font-size: 14px;
  line-height: 1.55;
  color: #333333;
}
.coach-faqs__answer > *:first-child { margin-top: 0; }
.coach-faqs__answer > *:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "coach-faqs-section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "range", "id": "heading_size", "min": 18, "max": 40, "step": 1, "unit": "px", "label": "Heading size", "default": 24 },
    { "type": "range", "id": "group_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Group size", "default": 16 },
    { "type": "range", "id": "question_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Question size", "default": 14 },
    { "type": "color", "id": "plus_color", "label": "Plus color", "default": "#65559D" },
    { "type": "color", "id": "line_color", "label": "Line color", "default": "#E4E4E4" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_width", "min": 480, "max": 1200, "step": 20, "unit": "px", "label": "Content width", "default": 820 },
    { "type": "range", "id": "side_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Side padding", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Space above", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Space below", "default": 48 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "General / My Account:" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How can I contact Coach.sa?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        { "type": "group", "settings": { "heading": "General / My Account:" } },
        { "type": "question", "settings": { "question": "How can I contact Coach.sa?" } },
        { "type": "question", "settings": { "question": "Who can buy from Coach.sa?" } },
        { "type": "question", "settings": { "question": "Do I need to have a Coach account to make an order?" } },
        { "type": "question", "settings": { "question": "I can't log into my account. What's next?" } },
        { "type": "question", "settings": { "question": "I want to unsubscribe from your website. How do I do that?" } },
        { "type": "group", "settings": { "heading": "Online Shopping / Orders:" } },
        { "type": "question", "settings": { "question": "How can I buy online?" } },
        { "type": "question", "settings": { "question": "How do I track my orders?" } },
        { "type": "question", "settings": { "question": "What if I want to pick up my order/package myself?" } },
        { "type": "question", "settings": { "question": "Where can I buy Coach products besides the Online Store?" } },
        { "type": "question", "settings": { "question": "The item I'm looking for is not available, is it still possible to get it?" } },
        { "type": "question", "settings": { "question": "Can I cancel an order or a merchandise?" } },
        { "type": "question", "settings": { "question": "Can I change shipping address of the order?" } }
      ]
    }
  ]
}
{% endschema %}
