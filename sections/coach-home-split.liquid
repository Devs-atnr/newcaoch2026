{{ 'coach-home-split.css' | asset_url | stylesheet_tag }}
{% render 'coach-home-fonts' %}

{%- liquid
  assign desk_src = ''
  assign mob_src = ''
  if section.settings.image != blank
    assign desk_src = section.settings.image | image_url: width: 1600
  elsif section.settings.image_url != blank
    assign desk_src = section.settings.image_url
  endif
  if section.settings.mobile_image != blank
    assign mob_src = section.settings.mobile_image | image_url: width: 1200
  elsif section.settings.mobile_url != blank
    assign mob_src = section.settings.mobile_url
  endif
  if mob_src == blank
    assign mob_src = desk_src
  endif
  if desk_src == blank
    assign desk_src = mob_src
  endif
  assign heading_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  if section.settings.heading_font == 'helvetica'
    assign heading_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  endif
  assign text_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.text_font == 'garamond'
    assign text_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
  assign button_font = 'HelveticaLTPro-Roman, Helvetica, Arial, sans-serif'
  if section.settings.button_font == 'garamond'
    assign button_font = 'GaramondMTProRegular, Times New Roman, Times, serif'
  endif
-%}

<section
  class="coach-home-split is-image-{{ section.settings.image_side }}"
  style="--hs-bg: {{ section.settings.background }}; --hs-heading: {{ heading_font }}; --hs-h: {{ section.settings.heading_size }}px; --hs-h-m: {{ section.settings.heading_size_mobile }}px; --hs-hw: {{ section.settings.heading_weight }}; --hs-hc: {{ section.settings.heading_color }}; --hs-hsp: {{ section.settings.heading_spacing }}px; --hs-text: {{ text_font }}; --hs-b: {{ section.settings.text_size }}px; --hs-b-m: {{ section.settings.text_size_mobile }}px; --hs-tw: {{ section.settings.text_weight }}; --hs-tc: {{ section.settings.text_color }}; --hs-tsp: {{ section.settings.text_spacing }}px; --hs-btn-font: {{ button_font }}; --hs-btn: {{ section.settings.button_size }}px; --hs-btn-m: {{ section.settings.button_size_mobile }}px; --hs-bw: {{ section.settings.button_weight }}; --hs-bc: {{ section.settings.button_color }}; --hs-bsp: {{ section.settings.button_spacing }}px; --hs-fit: {{ section.settings.image_fit }}; --hs-pos: {{ section.settings.image_position }};"
>
  <div class="coach-home-split__media">
    {%- if desk_src != blank -%}
      <picture>
        {%- if mob_src != blank and mob_src != desk_src -%}
          <source media="(max-width: 749px)" srcset="{{ mob_src | escape }}">
        {%- endif -%}
        <img src="{{ desk_src | escape }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="800" height="656">
      </picture>
    {%- endif -%}
  </div>
  <div class="coach-home-split__copy">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home split story",
  "tag": "section",
  "class": "coach-home-split-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_url", "label": "Desktop image URL", "info": "Used when no desktop image is uploaded." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "mobile_url", "label": "Mobile image URL", "info": "Used when no mobile image is uploaded." },
    { "type": "select", "id": "image_side", "label": "Desktop image side", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make the moment even more beautiful." },
    { "type": "select", "id": "heading_font", "label": "Font", "default": "garamond", "options": [
      { "value": "garamond", "label": "Garamond" },
      { "value": "helvetica", "label": "Helvetica" }
    ] },
    { "type": "range", "id": "heading_size", "min": 20, "max": 56, "step": 1, "unit": "px", "label": "Desktop size", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "min": 18, "max": 36, "step": 1, "unit": "px", "label": "Mobile size", "default": 28 },
    { "type": "select", "id": "heading_weight", "label": "Weight", "default": "400", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_spacing", "min": 0, "max": 12, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Description" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Add a complimentary gift note to your order and purchase a bow-topped gift box." },
    { "type": "select", "id": "text_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "text_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Desktop size", "default": 16 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Mobile size", "default": 14 },
    { "type": "select", "id": "text_weight", "label": "Weight", "default": "400", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "text_spacing", "min": 0, "max": 8, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "color", "id": "text_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Explore Our Gift Guide" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_font", "label": "Font", "default": "helvetica", "options": [
      { "value": "helvetica", "label": "Helvetica" },
      { "value": "garamond", "label": "Garamond" }
    ] },
    { "type": "range", "id": "button_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Desktop size", "default": 14 },
    { "type": "range", "id": "button_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Mobile size", "default": 14 },
    { "type": "select", "id": "button_weight", "label": "Weight", "default": "400", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "button_spacing", "min": 0, "max": 8, "step": 1, "unit": "px", "label": "Letter spacing", "default": 0 },
    { "type": "color", "id": "button_color", "label": "Color", "default": "#111111" },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Home split story" }]
}
{% endschema %}
