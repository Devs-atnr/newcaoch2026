{{ 'uk-home.css' | asset_url | stylesheet_tag }}

<section
  class="uk-promo"
  style="--uk-bg: {{ section.settings.background }}; --uk-color: {{ section.settings.text_color }}; --uk-heading: {{ section.settings.heading_size }}px; --uk-heading-m: {{ section.settings.heading_size_mobile }}px; --uk-b: {{ section.settings.text_size }}px; --uk-b-m: {{ section.settings.text_size_mobile }}px; --uk-btn: {{ section.settings.button_size }}px; --uk-pt: {{ section.settings.padding_top }}px; --uk-pb: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="uk-promo__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <p class="uk-promo__text">{{ section.settings.text | escape }}</p>
  {%- endif -%}
  {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
    <div class="uk-links">
      {%- if section.settings.button_1_text != blank -%}
        <a href="{{ section.settings.button_1_link | default: '#' }}">{{ section.settings.button_1_text | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_text != blank -%}
        <a href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_text | escape }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if section.settings.note != blank -%}
    <p class="uk-promo__note">
      {{ section.settings.note | escape }}
      {%- if section.settings.note_label != blank -%}
        <a href="{{ section.settings.note_link | default: '#' }}">{{ section.settings.note_label | escape }}</a>
      {%- endif -%}
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "UK promo bar",
  "tag": "section",
  "class": "uk-promo-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday Sale" },
    { "type": "range", "id": "heading_size", "min": 18, "max": 56, "step": 1, "unit": "px", "label": "Desktop heading size", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Mobile heading size", "default": 26 },
    { "type": "text", "id": "text", "label": "Description", "default": "20% off select styles. Code: BLACKFRIDAY" },
    { "type": "range", "id": "text_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Desktop text size", "default": 16 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Mobile text size", "default": 14 },
    { "type": "text", "id": "button_1_text", "label": "Button text", "default": "Shop All" },
    { "type": "url", "id": "button_1_link", "label": "Button link" },
    { "type": "text", "id": "button_2_text", "label": "Second button text", "default": "Shop Favourites" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "range", "id": "button_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button size", "default": 14 },
    { "type": "text", "id": "note", "label": "Disclaimer", "default": "EXCLUSIONS APPLY. VALID UNTIL 30/11/26, 23:59 GMT. FULL T&CS" },
    { "type": "text", "id": "note_label", "label": "Disclaimer link text", "default": "HERE" },
    { "type": "url", "id": "note_link", "label": "Disclaimer link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top spacing", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 16 }
  ],
  "presets": [{ "name": "UK promo bar" }]
}
{% endschema %}
