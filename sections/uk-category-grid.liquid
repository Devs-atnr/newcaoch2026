{{ 'uk-home.css' | asset_url | stylesheet_tag }}

<section
  class="uk-cats"
  style="--uk-bg: {{ section.settings.background }}; --uk-color: {{ section.settings.text_color }}; --uk-cols: {{ section.settings.columns_desktop }}; --uk-cols-m: {{ section.settings.columns_mobile }}; --uk-gap: {{ section.settings.gap }}px; --uk-pt: {{ section.settings.padding_top }}px; --uk-pb: {{ section.settings.padding_bottom }}px; --uk-px: {{ section.settings.padding_x }}px; --uk-heading: {{ section.settings.heading_size }}px; --uk-heading-m: {{ section.settings.heading_size_mobile }}px; --uk-b: {{ section.settings.label_size }}px; --uk-b-m: {{ section.settings.label_size_mobile }}px; --uk-fit: {{ section.settings.image_fit }}; --uk-pos: {{ section.settings.image_position }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="uk-cats__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="uk-cats__grid">
    {%- for block in section.blocks -%}
      <a class="uk-cats__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- render 'uk-media',
          image: block.settings.image,
          image_url: block.settings.image_url,
          mobile_image: block.settings.mobile_image,
          mobile_url: block.settings.mobile_url,
          alt: block.settings.title
        -%}
        {%- if block.settings.title != blank -%}
          <span>{{ block.settings.title | escape }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "UK category grid",
  "tag": "section",
  "class": "uk-cats-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "heading_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Desktop heading size", "default": 13 },
    { "type": "range", "id": "heading_size_mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Mobile heading size", "default": 12 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Mobile columns", "default": 2 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "range", "id": "label_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Desktop label size", "default": 16 },
    { "type": "range", "id": "label_size_mobile", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Mobile label size", "default": 14 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Label color", "default": "#ffffff" },
    { "type": "range", "id": "gap", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Gap", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top spacing", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 0 },
    { "type": "range", "id": "padding_x", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Side spacing", "default": 0 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "text", "id": "image_url", "label": "Desktop image URL", "info": "Used when no desktop image is uploaded." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "text", "id": "mobile_url", "label": "Mobile image URL" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "UK category grid" }]
}
{% endschema %}
