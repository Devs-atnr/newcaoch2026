{{ 'coach-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coach-collection.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="coach-collection-section section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.body_bg_color | default: '#f4f4f4' }};"
>
  <div
    class="coach-collection-wrapper"
    data-section-id="{{ section.id }}"
    style="
      --coach-cols-desktop: {{ section.settings.columns_desktop }};
      --coach-cols-mobile: {{ section.settings.columns_mobile }};
      --coach-content-width: {{ section.settings.content_width }}px;
      --coach-side-padding: {{ section.settings.side_padding }}px;
      --coach-grid-row-gap: {{ section.settings.grid_row_gap }}px;
      --coach-grid-column-gap: {{ section.settings.grid_column_gap }}px;
      --coach-title-size: {{ section.settings.title_size }}px;
      --coach-count-size: {{ section.settings.count_size }}px;
      --coach-card-title-size: {{ section.settings.card_title_size }}px;
      --coach-card-price-size: {{ section.settings.card_price_size }}px;
      --coach-header-gap: {{ section.settings.header_bottom_gap }}px;
      --coach-filter-pill-bg: {{ section.settings.filter_pill_bg }};
      --coach-filter-pill-text: {{ section.settings.filter_pill_text }};
      --coach-filter-pill-border: {{ section.settings.filter_pill_border }};
      --coach-popover-bg: {{ section.settings.popover_bg }};
      --coach-popover-radius: {{ section.settings.popover_radius }}px;
      --coach-page-bg: {{ section.settings.body_bg_color | default: '#f6f6f6' }};
      --coach-title-color: {{ section.settings.title_color | default: '#000000' }};
      --coach-count-color: {{ section.settings.count_color | default: '#575757' }};
      --coach-filter-font-size: {{ section.settings.filter_font_size | default: 14 }}px;
      --coach-sort-font-size: {{ section.settings.sort_font_size | default: 16 }}px;
      --coach-badge-size: {{ section.settings.badge_font_size | default: 12 }}px;
      --coach-badge-bg: {{ section.settings.badge_bg | default: '#ffffff' }};
      --coach-badge-text: {{ section.settings.badge_text | default: '#111111' }};
      --coach-card-title-color: {{ section.settings.card_title_color | default: '#000000' }};
      --coach-price-color: {{ section.settings.price_color | default: '#1a202c' }};
      --coach-font: {{ section.settings.font_family | default: "HelveticaLTPro-Roman, 'Helvetica Neue', Helvetica, Arial, sans-serif" }};
      --coach-bag-font-size: {{ section.settings.bag_font_size | default: 14 }}px;
      --coach-bag-bg: {{ section.settings.bag_bg | default: '#ffffff' }};
      --coach-bag-text: {{ section.settings.bag_text | default: '#111111' }};
      --coach-bag-hover-bg: {{ section.settings.bag_hover_bg | default: '#000000' }};
      --coach-bag-hover-text: {{ section.settings.bag_hover_text | default: '#ffffff' }};
      --coach-swatch-size: {{ section.settings.swatch_size | default: 28 }}px;
      --coach-breadcrumb-size: {{ section.settings.breadcrumb_size | default: 12 }}px;
      --coach-breadcrumb-color: {{ section.settings.breadcrumb_color | default: '#8a8a8a' }};
    "
  >
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- comment -%} Collection Header {%- endcomment -%}
    {%- if section.settings.show_collection_title -%}
      <div class="coach-collection-header">
        <div class="coach-collection-title-wrap">
          <h1 class="coach-collection-title">
            {{ collection.title | escape }}
          </h1>
          {%- if section.settings.show_product_count -%}
            <span class="coach-collection-count" id="CoachCollectionCount">
              {{ collection.products_count }}
              {%- if collection.products_count == 1 -%}
                Product
              {%- else -%}
                Products
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>
        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="coach-collection-description rte">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Filter and Sort Bar {%- endcomment -%}
    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      {% render 'coach-facets',
        results: collection,
        enable_filtering: section.settings.enable_filtering,
        enable_sorting: section.settings.enable_sorting,
        show_filter_counts: section.settings.show_filter_counts
      %}
    {%- endif -%}

    {%- comment -%} Product Grid Container {%- endcomment -%}
    <div id="CoachProductGridContainer">
      {%- if collection.products.size == 0 -%}
        <div class="coach-collection--empty">
          <h2 class="coach-collection--empty-title">
            {{ 'sections.collection_template.empty' | t | default: 'No products found' }}
          </h2>
          <a href="{{ collection.url }}" class="coach-collection--empty-clear">
            {{ 'products.facets.clear_all' | t | default: 'Clear all filters' }}
          </a>
        </div>
      {%- else -%}
        <ul class="coach-product-grid" id="CoachProductGrid" role="list">
          {%- for product in collection.products -%}
            <li class="coach-product-grid__item">
              {% render 'coach-product-card',
                card_product: product,
                image_ratio: section.settings.image_ratio,
                enable_slider: section.settings.enable_slider,
                show_quick_add: section.settings.show_quick_add,
                show_swatches: section.settings.show_swatches,
                show_view_similar: section.settings.show_view_similar,
                new_badge_tag: section.settings.new_badge_tag,
                coming_soon_badge_tag: section.settings.coming_soon_badge_tag,
                almost_gone_badge_tag: section.settings.almost_gone_badge_tag
              %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.enable_infinite_scroll -%}
          <div
            class="coach-infinite"
            data-infinite-sentinel
            {% if paginate.next %}
              data-next-url="{{ paginate.next.url }}"
            {% else %}
              hidden
            {% endif %}
          ></div>
        {%- elsif paginate.pages > 1 and section.settings.hide_page_numbers == false -%}
          <div class="coach-pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="coach-pagination__item coach-pagination__item--prev" aria-label="Previous page">
                <svg width="8" height="12" viewBox="0 0 8 12" fill="none">
                  <path d="M7 1L2 6L7 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="coach-pagination__item">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="coach-pagination__item coach-pagination__item--current" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="coach-pagination__item coach-pagination__item--dots">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="coach-pagination__item coach-pagination__item--next" aria-label="Next page">
                <svg width="8" height="12" viewBox="0 0 8 12" fill="none">
                  <path d="M1 1L6 6L1 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_breadcrumb -%}
      <nav class="coach-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Coach' | escape }}</a>
        {%- if section.settings.breadcrumb_menu != blank -%}
          {%- for link in section.settings.breadcrumb_menu.links -%}
            {%- if link.active or link.child_active -%}
              <span class="coach-breadcrumb__sep" aria-hidden="true">/</span>
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- for child in link.links -%}
                {%- if child.active or child.child_active -%}
                  <span class="coach-breadcrumb__sep" aria-hidden="true">/</span>
                  {%- if child.url == collection.url -%}
                    <span aria-current="page">{{ child.title | escape }}</span>
                  {%- else -%}
                    <a href="{{ child.url }}">{{ child.title | escape }}</a>
                  {%- endif -%}
                  {%- for grandchild in child.links -%}
                    {%- if grandchild.active or grandchild.child_active -%}
                      <span class="coach-breadcrumb__sep" aria-hidden="true">/</span>
                      {%- if grandchild.url == collection.url -%}
                        <span aria-current="page">{{ grandchild.title | escape }}</span>
                      {%- else -%}
                        <a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign breadcrumb_has_current = false -%}
        {%- if section.settings.breadcrumb_menu != blank -%}
          {%- for link in section.settings.breadcrumb_menu.links -%}
            {%- if link.url == collection.url or link.child_active -%}
              {%- for child in link.links -%}
                {%- if child.url == collection.url -%}
                  {%- assign breadcrumb_has_current = true -%}
                {%- endif -%}
                {%- for grandchild in child.links -%}
                  {%- if grandchild.url == collection.url -%}
                    {%- assign breadcrumb_has_current = true -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- if link.url == collection.url -%}
                {%- assign breadcrumb_has_current = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- unless breadcrumb_has_current -%}
          <span class="coach-breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">{{ collection.title | escape }}</span>
        {%- endunless -%}
      </nav>
    {%- endif -%}

    {%- if collection.description != blank -%}
      <div class="coach-collection-more">
        <div class="coach-collection-more__copy">{{ collection.description }}</div>
        <button type="button" class="coach-collection-more__toggle js-collection-more" aria-expanded="false">
          <span>Show more</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Coach Collection",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Collection Header"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "default": true,
      "label": "Show collection title"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "default": true,
      "label": "Show product count next to title"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": false,
      "label": "Show collection description"
    },
    {
      "type": "header",
      "content": "Grid & Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1440,
      "label": "Maximum content width"
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Desktop side padding"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "grid_row_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 12,
      "label": "Product row spacing"
    },
    {
      "type": "range",
      "id": "grid_column_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 18,
      "label": "Product column spacing"
    },
    {
      "type": "header",
      "content": "Filtering & Sorting (Coach Style)"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable horizontal filter pills & popovers"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable 'Sort by Best Matches' dropdown"
    },
    {
      "type": "checkbox",
      "id": "show_filter_counts",
      "default": false,
      "label": "Show item count next to filter options"
    },
    {
      "type": "header",
      "content": "Product Cards"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Product title size"
    },
    {
      "type": "range",
      "id": "card_price_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Product price size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        }
      ],
      "default": "portrait",
      "label": "Product image ratio"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "default": true,
      "label": "Enable image carousel (< and > arrows on card)"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "default": true,
      "label": "Show 'Add To Bag' hover button"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "default": true,
      "label": "Show variant color circles under title"
    },
    {
      "type": "checkbox",
      "id": "show_view_similar",
      "default": true,
      "label": "Show 'View Similar' overlay button"
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "text",
      "id": "new_badge_tag",
      "default": "new, New Arrival, New, new-arrival",
      "label": "Tags for 'New Arrival' badge (comma-separated)"
    },
    {
      "type": "text",
      "id": "almost_gone_badge_tag",
      "default": "almost gone, Almost Gone, almost-gone, low stock, Low Stock",
      "label": "Tags for 'Almost Gone' badge (comma-separated)"
    },
    {
      "type": "text",
      "id": "coming_soon_badge_tag",
      "default": "coming soon, Coming Soon, coming-soon",
      "label": "Tags for 'COMING SOON' badge (comma-separated)"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 26,
      "label": "Collection title size"
    },
    {
      "type": "range",
      "id": "count_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Product count size"
    },
    {
      "type": "range",
      "id": "header_bottom_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Space below collection header"
    },
    {
      "type": "color",
      "id": "filter_pill_bg",
      "default": "#ffffff",
      "label": "Filter button background"
    },
    {
      "type": "color",
      "id": "filter_pill_text",
      "default": "#111111",
      "label": "Filter button text"
    },
    {
      "type": "color",
      "id": "filter_pill_border",
      "default": "#dfdfdf",
      "label": "Filter button border"
    },
    {
      "type": "color",
      "id": "popover_bg",
      "default": "#ffffff",
      "label": "Filter menu background"
    },
    {
      "type": "range",
      "id": "popover_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Filter menu corner radius"
    },
    {
      "type": "color",
      "id": "body_bg_color",
      "default": "#f0f0f0",
      "label": "Collection body background color"
    },
    {
      "type": "color",
      "id": "title_color",
      "default": "#000000",
      "label": "Collection title color"
    },
    {
      "type": "color",
      "id": "count_color",
      "default": "#575757",
      "label": "Product count color"
    },
    {
      "type": "range",
      "id": "filter_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Filter button font size"
    },
    {
      "type": "range",
      "id": "sort_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Sort font size"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Badge font size"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "default": "#ffffff",
      "label": "Badge background"
    },
    {
      "type": "color",
      "id": "badge_text",
      "default": "#111111",
      "label": "Badge text"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "default": "#000000",
      "label": "Product title color"
    },
    {
      "type": "color",
      "id": "price_color",
      "default": "#1a202c",
      "label": "Price color"
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Font family",
      "default": "HelveticaLTPro-Roman, 'Helvetica Neue', Helvetica, Arial, sans-serif"
    },
    {
      "type": "range",
      "id": "bag_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Add To Bag font size"
    },
    {
      "type": "color",
      "id": "bag_bg",
      "default": "#ffffff",
      "label": "Add To Bag background"
    },
    {
      "type": "color",
      "id": "bag_text",
      "default": "#111111",
      "label": "Add To Bag text"
    },
    {
      "type": "color",
      "id": "bag_hover_bg",
      "default": "#000000",
      "label": "Add To Bag hover background"
    },
    {
      "type": "color",
      "id": "bag_hover_text",
      "default": "#ffffff",
      "label": "Add To Bag hover text"
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "default": true,
      "label": "Show breadcrumb"
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Home label",
      "default": "Coach"
    },
    {
      "type": "link_list",
      "id": "breadcrumb_menu",
      "label": "Breadcrumb menu",
      "info": "Uses the active menu path, such as Men / Wallets / View All."
    },
    {
      "type": "range",
      "id": "breadcrumb_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Breadcrumb font size"
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "default": "#8a8a8a",
      "label": "Breadcrumb color"
    },
    {
      "type": "header",
      "content": "Product loading"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "default": true,
      "label": "Load more products on scroll"
    },
    {
      "type": "checkbox",
      "id": "hide_page_numbers",
      "default": true,
      "label": "Hide page numbers"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28,
      "label": "Color swatch size"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Coach Collection"
    }
  ]
}
{% endschema %}
