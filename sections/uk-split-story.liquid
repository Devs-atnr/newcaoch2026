{{ 'uk-home.css' | asset_url | stylesheet_tag }}

<section
  class="uk-split is-image-{{ section.settings.image_side }}{% if section.settings.fixed_height %} is-fixed{% endif %}"
  style="--uk-bg: {{ section.settings.background }}; --uk-color: {{ section.settings.text_color }}; --uk-frame: {{ section.settings.desktop_height }}px; --uk-frame-m: {{ section.settings.mobile_height }}px; --uk-fit: {{ section.settings.image_fit }}; --uk-pos: {{ section.settings.image_position }}; --uk-heading: {{ section.settings.heading_size }}px; --uk-heading-m: {{ section.settings.heading_size_mobile }}px; --uk-b: {{ section.settings.text_size }}px; --uk-b-m: {{ section.settings.text_size_mobile }}px; --uk-btn: {{ section.settings.button_size }}px;"
>
  <div class="uk-split__media">
    {%- render 'uk-media',
      image: section.settings.image,
      image_url: section.settings.image_url,
      mobile_image: section.settings.mobile_image,
      mobile_url: section.settings.mobile_url,
      alt: section.settings.heading
    -%}
  </div>
  <div class="uk-split__copy">
    {%- if section.settings.heading != blank -%}
      <h2 class="uk-split__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="uk-split__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <div class="uk-links">
        <a href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "UK split story",
  "tag": "section",
  "class": "uk-split-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_url", "label": "Desktop image URL", "info": "Used when no desktop image is uploaded." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "mobile_url", "label": "Mobile image URL", "info": "Used when no mobile image is uploaded." },
    { "type": "select", "id": "image_side", "label": "Desktop image side", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "checkbox", "id": "fixed_height", "label": "Use a fixed image height", "default": false },
    { "type": "range", "id": "desktop_height", "min": 320, "max": 800, "step": 20, "unit": "px", "label": "Desktop height", "default": 520 },
    { "type": "range", "id": "mobile_height", "min": 220, "max": 640, "step": 20, "unit": "px", "label": "Mobile height", "default": 320 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make the moment even more beautiful." },
    { "type": "range", "id": "heading_size", "min": 20, "max": 56, "step": 1, "unit": "px", "label": "Desktop heading size", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "min": 18, "max": 36, "step": 1, "unit": "px", "label": "Mobile heading size", "default": 28 },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Add a complimentary gift note to your order and purchase a bow-topped gift box." },
    { "type": "range", "id": "text_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Desktop text size", "default": 16 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Mobile text size", "default": 14 },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Explore Our Gift Guide" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "button_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button size", "default": 14 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ],
  "presets": [{ "name": "UK split story" }]
}
{% endschema %}
