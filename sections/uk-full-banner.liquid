{{ 'uk-home.css' | asset_url | stylesheet_tag }}

<section
  class="uk-banner"
  style="--uk-frame: {{ section.settings.desktop_height }}px; --uk-frame-m: {{ section.settings.mobile_height }}px; --uk-fit: {{ section.settings.image_fit }}; --uk-pos: {{ section.settings.image_position }}; --uk-color: {{ section.settings.text_color }}; --uk-heading: {{ section.settings.heading_size }}px; --uk-heading-m: {{ section.settings.heading_size_mobile }}px; --uk-b: {{ section.settings.text_size }}px; --uk-b-m: {{ section.settings.text_size_mobile }}px; --uk-btn: {{ section.settings.button_size }}px;"
>
  {%- render 'uk-media',
    image: section.settings.image,
    image_url: section.settings.image_url,
    mobile_image: section.settings.mobile_image,
    mobile_url: section.settings.mobile_url,
    alt: section.settings.heading,
    class: 'uk-media'
  -%}
  <div class="uk-banner__copy is-{{ section.settings.text_position }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="uk-banner__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="uk-banner__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <div class="uk-links">
        <a href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "UK full banner",
  "tag": "section",
  "class": "uk-banner-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_url", "label": "Desktop image URL", "info": "Used when no desktop image is uploaded." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "mobile_url", "label": "Mobile image URL", "info": "Used when no mobile image is uploaded." },
    { "type": "range", "id": "desktop_height", "min": 320, "max": 800, "step": 20, "unit": "px", "label": "Desktop height", "default": 560 },
    { "type": "range", "id": "mobile_height", "min": 280, "max": 700, "step": 20, "unit": "px", "label": "Mobile height", "default": 420 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [
      { "value": "cover", "label": "Cover" },
      { "value": "contain", "label": "Contain" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" },
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brighten their season." },
    { "type": "range", "id": "heading_size", "min": 20, "max": 64, "step": 1, "unit": "px", "label": "Desktop heading size", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "min": 18, "max": 40, "step": 1, "unit": "px", "label": "Mobile heading size", "default": 28 },
    { "type": "textarea", "id": "text", "label": "Description", "default": "The perfect presents for everyone on your list." },
    { "type": "range", "id": "text_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Desktop text size", "default": 16 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Mobile text size", "default": 14 },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop All Gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "button_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button size", "default": 14 },
    { "type": "select", "id": "text_position", "label": "Text position", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "bottom-center", "label": "Bottom center" },
      { "value": "bottom-left", "label": "Bottom left" }
    ] },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "UK full banner" }]
}
{% endschema %}
