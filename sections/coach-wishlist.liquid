{{ 'coach-wishlist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coach-wishlist.js' | asset_url }}" defer="defer"></script>

<div class="coach-wishlist" data-wishlist-page data-money-format="{{ shop.money_format | escape }}">
  <h1>{{ section.settings.heading | default: 'Wishlist' | escape }}</h1>
  <p class="coach-wishlist__empty js-wish-empty" hidden>
    {{ section.settings.empty_text | default: 'Your wishlist is empty.' | escape }}
    <a href="{{ routes.all_products_collection_url }}">{{ section.settings.continue_label | default: 'Continue shopping' | escape }}</a>
  </p>
  <div class="coach-wishlist__grid js-wish-grid"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-wishlist-page]');
    if (!root || !window.CoachWishlist) return;
    const grid = root.querySelector('.js-wish-grid');
    const empty = root.querySelector('.js-wish-empty');
    const format = root.dataset.moneyFormat || '{{amount}}';

    const money = (cents) => {
      const amount = (Number(cents) / 100).toFixed(2);
      return format
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','))
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, String(Math.round(Number(cents) / 100)))
        .replace(/\{\{\s*amount\s*\}\}/g, amount);
    };

    const heart = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20.4s-7.6-4.5-9.3-9.4C1.6 7.7 3.6 4.4 7 4.4c2.1 0 3.6 1.2 5 3.1 1.4-1.9 2.9-3.1 5-3.1 3.4 0 5.4 3.3 4.3 6.6-1.7 4.9-9.3 9.4-9.3 9.4z"/></svg>';
    const esc = (value) => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    const render = async () => {
      const saved = window.CoachWishlist.read();
      if (!saved.length) {
        grid.innerHTML = '';
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      const products = await Promise.all(saved.map(async (item) => {
        try {
          const response = await fetch(`/products/${encodeURIComponent(item.handle)}.js`);
          if (!response.ok) return item;
          const product = await response.json();
          const variant = (product.variants || []).find((entry) => String(entry.id) === String(item.variantId)) || product.variants?.[0];
          return {
            ...item,
            title: product.title,
            url: product.url,
            image: product.featured_image || item.image,
            price: variant ? money(variant.price) : item.price,
            variantId: variant ? variant.id : item.variantId,
            available: variant ? variant.available : true,
          };
        } catch (error) {
          return item;
        }
      }));
      grid.innerHTML = products.map((item) => `
        <article class="coach-wish-card">
          <a class="coach-wish-card__media" href="${esc(item.url || '#')}">
            ${item.image ? `<img src="${esc(item.image)}" alt="">` : ''}
          </a>
          <button type="button" class="coach-wish-card__heart" data-remove="${esc(item.handle)}" aria-label="Remove from wishlist">${heart}</button>
          <a class="coach-wish-card__title" href="${esc(item.url || '#')}">${esc(item.title || '')}</a>
          <p class="coach-wish-card__price">${esc(item.price || '')}</p>
          <button type="button" class="coach-wish-card__add" data-add="${esc(item.variantId || '')}" ${item.available === false ? 'disabled' : ''}>{{ section.settings.add_label | default: 'Add to bag' | escape }}</button>
        </article>
      `).join('');
    };

    grid.addEventListener('click', async (event) => {
      const remove = event.target.closest('[data-remove]');
      if (remove) {
        window.CoachWishlist.remove(remove.dataset.remove);
        render();
        return;
      }
      const add = event.target.closest('[data-add]');
      if (!add || !add.dataset.add || add.disabled) return;
      add.disabled = true;
      try {
        const response = await fetch((window.routes && window.routes.cart_add_url) || '/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(add.dataset.add, 10), quantity: 1 }] }),
        });
        if (!response.ok) throw new Error('bag');
        const cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then((res) => res.json());
        document.querySelectorAll('.coach-bag__count').forEach((node) => {
          node.textContent = String(cart.item_count);
          node.hidden = false;
          node.classList.toggle('is-empty', cart.item_count === 0);
        });
        if (window.CoachMiniBag?.open) await window.CoachMiniBag.open();
      } catch (error) {
        add.disabled = false;
      }
    });

    document.addEventListener('coach:wishlist', render);
    render();
  });
</script>

{% schema %}
{
  "name": "Coach wishlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wishlist" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Your wishlist is empty." },
    { "type": "text", "id": "continue_label", "label": "Continue label", "default": "Continue shopping" },
    { "type": "text", "id": "add_label", "label": "Add to bag label", "default": "Add to bag" }
  ],
  "presets": [{ "name": "Coach wishlist" }]
}
{% endschema %}
