            "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Exchange & Return Policy</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n      color: #111111;\n      background-color: #ffffff;\n      line-height: 1.5;\n      font-size: 14px;\n      padding: 40px 24px;\n    }\n\n    .policy-container {\n      max-width: 780px;\n      margin: 0 auto;\n    }\n\n    h1 {\n      font-size: 22px;\n      font-weight: 700;\n      margin-bottom: 24px;\n      letter-spacing: -0.01em;\n    }\n\n    h2 {\n      font-size: 20px;\n      font-weight: 700;\n      margin-top: 28px;\n      margin-bottom: 14px;\n      letter-spacing: -0.01em;\n    }\n\n    p {\n      margin-bottom: 14px;\n    }\n\n    a {\n      color: #333333;\n      text-decoration: none;\n    }\n\n    a:hover {\n      text-decoration: underline;\n    }\n\n    .intro-text {\n      font-size: 15px;\n      margin-bottom: 18px;\n    }\n\n    /* Table Styling */\n    .table-wrapper {\n      width: 100%;\n      overflow-x: auto;\n      margin-bottom: 28px;\n    }\n\n    .policy-table {\n      width: 100%;\n      border-collapse: collapse;\n      text-align: left;\n      border: 1px solid #d9d9d9;\n    }\n\n    .policy-table th,\n    .policy-table td {\n      border: 1px solid #d9d9d9;\n      padding: 14px 16px;\n      vertical-align: middle;\n    }\n\n    .policy-table thead th {\n      background-color: #f3f3f3;\n      font-size: 15px;\n      font-weight: 700;\n      color: #222222;\n      width: 33.33%;\n    }\n\n    .policy-table tbody th {\n      font-weight: 700;\n      color: #111111;\n    }\n\n    /* Custom Dash List inside Table */\n    .dash-list {\n      list-style: none;\n      padding-left: 0;\n    }\n\n    .dash-list li {\n      position: relative;\n      padding-left: 12px;\n      margin-bottom: 2px;\n    }\n\n    .dash-list li::before {\n      content: \"-\";\n      position: absolute;\n      left: 0;\n    }\n\n    /* Bullet List */\n    .bold-label {\n      font-weight: 700;\n      margin-bottom: 10px;\n    }\n\n    .bullet-list {\n      margin-left: 24px;\n      margin-bottom: 16px;\n    }\n\n    .bullet-list li {\n      margin-bottom: 4px;\n    }\n\n    /* Notes & Disclaimers */\n    .italic-note {\n      font-style: italic;\n    }\n\n    .disclaimer {\n      margin-top: 16px;\n    }\n\n    @media (max-width: 600px) {\n      body {\n        padding: 24px 16px;\n      }\n\n      .policy-table th,\n      .policy-table td {\n        padding: 10px 12px;\n        font-size: 13px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"policy-container\">\n    <h1>Exchange &amp; Return Policy</h1>\n    <p class=\"intro-text\">We want our customers to be fully satisfied. Please review the policies below:</p>\n\n    <div class=\"table-wrapper\">\n      <table class=\"policy-table\">\n        <thead>\n          <tr>\n            <th>T&amp;C</th>\n            <th>Legit Returns</th>\n            <th>Non-Legit Returns</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th>Product Condition</th>\n            <td>\n              <ul class=\"dash-list\">\n                <li>Wrong deliveries</li>\n                <li>Manufacturing defects</li>\n                <li>Incorrect orders</li>\n                <li>Damaged on delivery</li>\n              </ul>\n            </td>\n            <td>\n              <ul class=\"dash-list\">\n                <li>Unwanted items</li>\n                <li>Unpleasant items</li>\n                <li>Late damage reports</li>\n                <li>Discounted with minor imperfections</li>\n              </ul>\n            </td>\n          </tr>\n          <tr>\n            <th>Return Shipping (SAR)</th>\n            <td>Free</td>\n            <td>55 SAR</td>\n          </tr>\n          <tr>\n            <th>Request Time Limit</th>\n            <td>Within 2 days</td>\n            <td>Up to 14 days</td>\n          </tr>\n          <tr>\n            <th>Refunds</th>\n            <td>Full refund incl. shipping &amp; handling</td>\n            <td>Product value only (excl. shipping/handling)</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <section class=\"exceptions-section\">\n      <p class=\"bold-label\">Return exceptions apply:</p>\n      <ul class=\"bullet-list\">\n        <li>No returns on items discounted at 70% or more.</li>\n        <li>Returns on 30–70% discounted items: 100 SAR fee.</li>\n        <li>Returns on &lt;30% discounted items: 55 SAR fee.</li>\n        <li>Gift wraps: 75 SAR on all discounted items.</li>\n        <li>Discounted items may have minor imperfections.</li>\n      </ul>\n\n      <p><strong>Non-returnable items:</strong> Jewelry, fragrances, watches, sunglasses, and accessories.</p>\n      <p><strong>Important:</strong> Damaged item reports made after 2 days will be treated as non-legit returns.</p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Privacy Clause</h2>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Return Procedure</h2>\n      <p>\n        Email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> to initiate a return. Our team will respond within 24–48 hours. If approved, we will issue a return label and coordinate pick-up via our logistics partner.\n      </p>\n      <p class=\"italic-note\">Note: Customer responsiveness is critical for a smooth return process.</p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Refunds</h2>\n      <p>\n        Approved refunds will be processed via the original payment method. Refund times depend on your bank. This policy applies only to purchases made at Coach.sa.\n      </p>\n      <p>Products bought in-store must be addressed to the respective physical locations.</p>\n      <p><strong>Gift Cards are non-returnable and non-refundable.</strong></p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Exchanges</h2>\n      <p>\n        Exchanges are allowed only for footwear and must be requested within 2 days of receipt. Exchange is only eligible for equal or higher value items.\n      </p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Order Cancellation</h2>\n      <p>To cancel an order, email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> before the order is shipped.</p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Order Pickup &amp; Cancellation Policy</h2>\n      <p>\n        If a customer does not collect his/her order within <strong>3 days</strong> of receiving the pickup notification, the order will be <strong>automatically cancelled and refunded</strong>.<br />\n        A <strong>service fee of 55 SAR</strong> will be deducted from the refund amount to cover processing and handling charges.<br />\n        If a customer requests to cancel the order after receiving the pickup notification, a service fee of 30 SAR will be applied.\n      </p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Promotions / Sales</h2>\n      <p>Account holders will be notified of ongoing promotions.</p>\n    </section>\n\n    <section class=\"policy-section\">\n      <h2>Contact Us</h2>\n      <p>\n        For any queries, email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a>. Our team will reply within 2 business days (Sunday–Thursday, 10 AM to 3 PM). Response times may be longer during high-volume periods.\n      </p>\n      <p class=\"disclaimer\">\n        <strong>Please note:</strong> <em>with this option, you acknowledge and agree that Coach has no liability for any loss or damage to your order upon its delivery. For more information, visit Terms &amp; Conditions.</em>\n      </p>\n    </section>\n  </main>\n</body>\n</html>",
