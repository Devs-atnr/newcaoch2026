        "faq_group_DKhMza": {
          "type": "faq_group",
          "settings": {
            "heading": "Online Shopping / Orders:",
            "page_handles": ""
          },
          "blocks": {
            "faq_KzC4QG": {
              "type": "faq",
              "settings": {
                "question": "How can I buy online?",
                "answer": "<p>Buying is simple! Just browse products, add them to cart, and proceed to checkout using your preferred payment method.</p>"
              }
            },
            "faq_hP4yAz": {
              "type": "faq",
              "settings": {
                "question": "How do I track my orders?",
                "answer": "<p>Use the “Order Status” link in the Customer Care section on our website. For more help, contact <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a>.</p>"
              }
            },
            "faq_MraTtE": {
              "type": "faq",
              "settings": {
                "question": "What if I want to pick up my order/package myself?",
                "answer": "<p>Email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> with your Order Ref. No. and we’ll guide you on pickup options.</p>"
              }
            },
            "faq_KKTqrP": {
              "type": "faq",
              "settings": {
                "question": "Where can I buy Coach products besides the Online Store?",
                "answer": "<p>You can find our products in Coach stores across KSA. Visit “Store Locator” on our website for details</p>"
              }
            },
            "faq_3qgQJH": {
              "type": "faq",
              "settings": {
                "question": "The item I’m looking for is not available, is it still possible to get it?",
                "answer": "<p>Yes, contact <a href=\"mailto:info@coach.sa\">info@coach.sa</a> or <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> or visit a store for availability.</p>"
              }
            },
            "faq_j7fihK": {
              "type": "faq",
              "settings": {
                "question": "Can I cancel an order or a merchandise?",
                "answer": "<p>Yes, within 24 hours of placing your order. Email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> with your order details.</p>"
              }
            },
            "faq_nRLGnm": {
              "type": "faq",
              "settings": {
                "question": "Can I change shipping address of the order?",
                "answer": "<p>You can change the shipping address within 24 hours of placing the order by emailing <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a>.</p>"
              }
            },
            "faq_jAa89K": {
              "type": "faq",
              "settings": {
                "question": "What happens if merchandise ordered is out of stock?",
                "answer": "<p>We’ll notify you at checkout or via email if an item is out of stock. We’ll try to source it, or cancel and refund if unavailable.</p>"
              }
            }
          },
