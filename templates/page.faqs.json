          "blocks": {
            "faq_tia99T": {
              "type": "faq",
              "settings": {
                "question": "How do I make a payment?",
                "answer": "<p>You can pay using any Credit/Debit Card or opt for Cash on Delivery (COD), which incurs a 25 SR fee.</p>"
              }
            },
            "faq_ykQmgH": {
              "type": "faq",
              "settings": {
                "question": "What if my credit card was compromised?",
                "answer": "<p>Since all transactions occur through bank gateways, please report any fraud to your bank immediately.</p>"
              }
            },
            "faq_yfgrix": {
              "type": "faq",
              "settings": {
                "question": "Can I pay in-store for a product bought online?",
                "answer": "<p>No, this service is currently not available.</p>"
              }
            }
          },
