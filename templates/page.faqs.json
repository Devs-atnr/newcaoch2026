          "type": "faq",
          "settings": {
            "question": "How can I contact Coach.sa?",
            "answer": "<p>You can write to us at <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> for any query you have about Coach.sa or your order. Our customer care team will respond within 2 business days (Sunday to Thursday, 10am–3pm). Response time may vary due to high volume<br/><br/></p>",
            "page_handles": ""
          }
        },
        "faq_9zWczb": {
          "type": "faq",
          "settings": {
            "question": "Who can buy from Coach.sa?",
            "answer": "<p>Any individual aged 18+ legally allowed to shop in Saudi Arabia and in possession of a valid debit or credit card (Visa/MasterCard) can shop at Coach.sa.<br/></p>",
            "page_handles": ""
          }
        },
        "faq_Qtg3yp": {
          "type": "faq",
          "settings": {
            "question": "Do I need to have a Coach account to make an order?",
            "answer": "<p>No, you don’t need to have a Coach account to make a purchase. However, having an account gives you:</p><ul><li>Order and payment tracking</li><li>Purchase and wishlist history</li><li>Updates on new arrivals, promotions, and discounts</li><li>Saved shipping and payment info for faster checkout</li></ul>",
            "page_handles": ""
          }
        },
        "faq_4rNaAw": {
          "type": "faq",
          "settings": {
            "question": "I can’t log into my account. What’s next?",
            "answer": "<p>Please ensure your credentials are correct. If the issue persists, email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> and our team will assist you</p>",
            "page_handles": ""
          }
        },
        "faq_GpgYzL": {
          "type": "faq",
          "settings": {
            "question": "I want to unsubscribe from your website. How do I do that?",
            "answer": "<p>Just send us an email at <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> and we will unsubscribe you.</p>",
            "page_handles": ""
