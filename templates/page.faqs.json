          "type": "faq_group",
          "settings": {
            "heading": "Delivery & Shipping:",
            "page_handles": ""
          },
          "blocks": {
            "faq_UmGiEh": {
              "type": "faq",
              "settings": {
                "question": "Where do you deliver?",
                "answer": "<p>We deliver to all cities across KSA.</p>"
              }
            },
            "faq_9PhBzP": {
              "type": "faq",
              "settings": {
                "question": "Are there any delivery delays?",
                "answer": "<p>Some rural areas or towns may experience delays due to limited logistics access.</p>"
              }
            },
            "faq_HrRPdx": {
              "type": "faq",
              "settings": {
                "question": "Can I change my delivery address after confirmation?",
                "answer": "<p>No, address changes are only possible within 24 hours of order placement.</p>"
              }
            },
            "faq_dcbJek": {
              "type": "faq",
              "settings": {
                "question": "What happens if I’m unavailable at the time of delivery?",
                "answer": "<p>The courier will attempt re-delivery. Ensure someone is available to receive the package.</p>"
              }
            },
            "faq_CThhdw": {
              "type": "faq",
              "settings": {
                "question": "Can you hold my order if I’m not available?",
                "answer": "<p>We can hold orders for up to 9 days. Email us at <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> to notify us in advance</p>"
              }
            },
            "faq_RYtL8n": {
              "type": "faq",
              "settings": {
                "question": "What if only part of my order has arrived?",
                "answer": "<p>Email us within 24 hours of delivery with order details.</p>"
              }
            },
            "faq_CbUxLC": {
              "type": "faq",
              "settings": {
                "question": "What should I do if my order arrives damaged?",
                "answer": "<p>Refuse delivery if packaging is damaged. If discovered later, email us within 2 days of receipt.</p>"
              }
            },
            "faq_4Verwb": {
              "type": "faq",
              "settings": {
                "question": "What if the merchandise is defective?",
                "answer": "<p>Notify us within 2 days. Refunds are available within 14 days upon return of items in original condition.</p>"
              }
            },
            "faq_PyPTQQ": {
              "type": "faq",
              "settings": {
                "question": "Are there delivery charges?",
                "answer": "<p>Orders above 500 SR are free. Orders below that incur a 50 SR fee.</p>"
              }
            },
            "faq_74ByjC": {
              "type": "faq",
              "settings": {
                "question": "Are shipping charges included in the product price?",
                "answer": "<p>No. Shipping and service taxes are added on the billing page.</p>"
              }
            },
            "faq_VFkB9C": {
              "type": "faq",
              "settings": {
                "question": "Who pays for return shipping?",
                "answer": "<p>You pay 50 SR for returns unless due to damage or defect. See our Returns Policy.</p>"
              }
            }
