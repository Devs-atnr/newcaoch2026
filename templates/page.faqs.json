              }
            },
            "faq_bdwFMb": {
              "type": "faq",
              "settings": {
                "question": "I want to return a product, how can I do that?",
                "answer": "<p>Email <a href=\"mailto:customercare@coach.sa\">customercare@coach.sa</a> and request a pickup. Item must be in original condition with invoice</p>"
              }
            },
            "faq_Dq8R94": {
              "type": "faq",
              "settings": {
                "question": "How can I receive my money for returned/cancelled merchandise?",
                "answer": "<p>Refunds are processed in the original payment method. COD refunds require bank account details.</p>"
              }
            }
          },
