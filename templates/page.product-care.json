care-responsive .product-care details > div,\n  #coach-product-care-responsive .product-care details p,\n  #coach-product-care-responsive .Fabric_seCtion details p {\n    margin-bottom: 0.75rem;\n  }\n}\n\n/* Coach Product Care – uniformly positioned accordion icons (desktop + mobile)\n   Paste this at the END of the existing <style> block so it takes precedence. */\n\n/* Reset theme/browser disclosure markers and keep every row within its parent. */\n#coach-product-care-responsive details > summary {\n  position: relative !important;\n  display: block !important;\n  box-sizing: border-box !important;\n  width: 100% !important;\n  max-width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  list-style: none !important;\n  cursor: pointer;\n}\n\n#coach-product-care-responsive details > summary::-webkit-details-marker {\n  display: none !important;\n}\n\n#coach-product-care-responsive details > summary::marker {\n  content: \"\" !important;\n}\n\n#coach-product-care-responsive details > summary::before,\n#coach-product-care-responsive details > summary > .tabcare-heading::before,\n#coach-product-care-responsive details > summary > .tabcare-heading::after {\n  content: none !important;\n  display: none !important;\n}\n\n/* Make the texture/image bar fill the row, reserving space for the icon. */\n#coach-product-care-responsive details > summary > .tabcare-heading {\n  width: 100% !important;\n  max-width: 100% !important;\n  margin: 0 !important;\n  padding-right: 60px !important;\n}\n\n/* Text-only accordions (More Product TLC) receive the same icon spacing. */\n#coach-product-care-responsive .inner-accodian-sec details > summary {\n  padding: 16px 60px 16px 16px !important;\n}\n\n/* Suppress the old span icon so it cannot appear alongside the new one. */\n#coach-product-care-responsive details > summary .toggle-icon {\n  display: none !important;\n}\n\n/* One identical, centered plus icon for EVERY accordion header. */\n#coach-product-care-responsive details > summary::after {\n  content: \"\" !important;\n  box-sizing: border-box !important;\n  display: block !important;\n  position: absolute !important;\n  top: 50% !important;\n  right: 16px !important;\n  bottom: auto !important;\n  left: auto !important;\n  width: 28px !important;\n  height: 28px !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  transform: translateY(-50%) !important;\n  border: 1px solid rgba(0, 0, 0, 0.15) !important;\n  border-radius: 50% !important;\n  box-shadow: none !important;\n  opacity: 1 !important;\n  z-index: 1;\n  pointer-events: none;\n  background:\n    linear-gradient(#171717, #171717) center / 12px 2px no-repeat,\n    linear-gradient(#171717, #171717) center / 2px 12px no-repeat,\n    #fff !important;\n}\n\n/* An expanded accordion shows a minus in exactly the same position. */\n#coach-product-care-responsive details[open] > summary::after {\n  background:\n    linear-gradient(#171717, #171717) center / 12px 2px no-repeat,\n    #fff !important;\n}\nhtml[lang=\"ar\"] #coach-product-care-responsive details > summary::after,\nhtml[dir=\"rtl\"] #coach-product-care-responsive details > summary::after {\n  right: auto !important;\n  left: 16px !important;\n}\nhtml[lang=\"ar\"] #coach-product-care-responsive details > summary > .tabcare-heading,\nhtml[dir=\"rtl\"] #coach-product-care-responsive details > summary > .tabcare-heading {\n  padding-right: 1rem !important;\n  padding-left: 60px !important;\n}\nhtml[lang=\"ar\"] #coach-product-care-responsive .inner-accodian-sec details > summary,\nhtml[dir=\"rtl\"] #coach-product-care-responsive .inner-accodian-sec details > summary {\n  padding: 16px 16px 16px 60px !important;\n}\n</style>",
